<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core"><IconTabFilter text="Zusammenarbeit &amp; Wissen" key="collaboration" visible="{state&gt;/access/ticketIntake}"><VBox class="sapUiContentPadding"><Panel headerText="Interne Beobachter" expandable="true" expanded="true"><Table id="ticketWatchers" items="{view&gt;/serviceDesk/watchers}"><headerToolbar><OverflowToolbar><Title text="Beobachtung und Übergabe"/><ToolbarSpacer/><Button text="Selbst beobachten" press=".onWatchSelf" visible="{view&gt;/serviceDesk/canEdit}"/><Button text="Beobachter aufnehmen" press=".onAddWatcher" visible="{= ${view&gt;/serviceDesk/canManage} &amp;&amp; ${view&gt;/serviceDesk/canEdit} }"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Person"/></Column><Column><Text text="Aufgenommen am"/></Column><Column><Text text="Status"/></Column><Column><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;email}"/><Text text="{path:'view&gt;added_at',formatter:'.formatter.date'}" wrapping="false"/><ObjectStatus text="{= ${view&gt;removed_at} ? 'Beendet' : 'Aktiv' }"/><Button text="Beobachtung beenden" press=".onRemoveWatcher" visible="{= !${view&gt;removed_at} &amp;&amp; ${view&gt;/serviceDesk/canEdit} &amp;&amp; (${view&gt;/serviceDesk/canManage} || ${view&gt;user_id} === ${state&gt;/user/id}) }"/></cells></ColumnListItem></items></Table></Panel><Panel headerText="Zugehörige Tickets und Problembezug" expandable="true" expanded="true"><Table id="ticketRelations" items="{view&gt;/serviceDesk/related}"><headerToolbar><OverflowToolbar><Title text="Operative Ticketbeziehungen"/><ToolbarSpacer/><Button text="Ticketbeziehung anlegen" press=".onTicketRelation" visible="{= ${view&gt;/serviceDesk/canManage} &amp;&amp; ${view&gt;/serviceDesk/canEdit} }"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Ticket"/></Column><Column><Text text="Zusammenhang"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onRelatedTicket"/><Text text="{view&gt;title}"/></VBox><VBox><Text text="{path:'view&gt;kind',formatter:'.formatter.ticketRelation'}"/><Text text="{= ${view&gt;direction} === 'OUTGOING' ? 'Von diesem Ticket ausgehend' : 'Bezug auf dieses Ticket' }"/></VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></cells></ColumnListItem></items></Table></Panel><Panel headerText="Angewendetes Servicewissen" expandable="true" expanded="true"><Table id="ticketKnowledge" items="{view&gt;/serviceDesk/knowledge}"><headerToolbar><OverflowToolbar><Title text="Wissen und bekannte Fehler"/><ToolbarSpacer/><Button text="Wissensstand verwenden" press=".onLinkKnowledge" visible="{view&gt;/serviceDesk/canEdit}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Wissensstand"/></Column><Column><Text text="Lösung / Workaround"/></Column><Column><Text text="Verwendung / Nachweis"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;snapshot/title}" text="{= 'Revision ' + ${view&gt;snapshot/revision} }"/><VBox><Text text="{view&gt;snapshot/solution}" renderWhitespace="true"/><Text text="{view&gt;snapshot/workaround}" renderWhitespace="true"/></VBox><VBox><ObjectStatus text="{= ${view&gt;adopted} ? 'Workaround ins Ticket übernommen' : 'Als Referenz verknüpft' }"/><Text text="{view&gt;note}"/><Text text="{view&gt;createdByName}"/><Text text="{path:'view&gt;created_at',formatter:'.formatter.date'}" wrapping="false"/></VBox></cells></ColumnListItem></items></Table></Panel></VBox></IconTabFilter></core:FragmentDefinition>
