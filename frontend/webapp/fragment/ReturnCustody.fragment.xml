<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
 <VBox width="100%"><MessageStrip text="Kundeneigentum wird ohne Bewertung und getrennt vom verfügbaren Eigenbestand geführt. Prüfung, Gutschrift und tatsächliche Bestandsübernahme bleiben eigenständige Schritte." showIcon="true"/>
 <Table items="{view&gt;/custody/lots}" noDataText="Noch kein Kunden-Prüfbestand erfasst" growing="true"><headerToolbar><OverflowToolbar><Title text="Prüflose und Folgeaktivitäten"/><ToolbarSpacer/><Button text="Prüfeingang erfassen" press=".onArrival" type="Emphasized" visible="{view&gt;/custody/canArrive}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Prüflos / Artikel"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Prüffach / Eingang"/></Column><Column hAlign="End"><Text text="Prüfbestand / Losmenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Angenommen / Abgelehnt"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Befund / Bearbeitung"/></Column><Column width="13rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Folgeaktivitäten"/></Column></columns><items><ColumnListItem><cells>
 <VBox><Link text="{view&gt;number}" press=".onCustodyRecord"/><ObjectIdentifier title="{view&gt;sku}" text="{view&gt;description}"/><Text text="{= [${view&gt;batch},${view&gt;serial}].filter(Boolean).join(' / ') }"/></VBox>
 <VBox><Text text="{view&gt;binCode}" wrapping="false"/><Text text="{path:'view&gt;movementDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{view&gt;receivedBy}"/></VBox>
 <VBox><ObjectNumber number="{path:'view&gt;heldQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" state="Warning"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="Los" emphasized="false"/><ObjectStatus text="{= ${view&gt;arrivedQuantity} === '0.000000' ? 'Eingang storniert' : ${view&gt;inspectionId} ? 'Geprüft' : 'Prüfung offen' }"/></VBox>
 <VBox><ObjectNumber number="{path:'view&gt;acceptedQuantity',formatter:'.formatter.decimal'}" unit="Angenommen" state="Success"/><ObjectNumber number="{path:'view&gt;rejectedQuantity',formatter:'.formatter.decimal'}" unit="Abgelehnt" state="Error"/><Text text="{= 'Übernommen: ' + ${view&gt;releasedQuantity}.replace('.',',') + ' · zurück: ' + ${view&gt;dispatchedQuantity}.replace('.',',') }"/></VBox>
 <VBox><Text text="{path:'view&gt;conditionCode',formatter:'.formatter.inspectionCondition'}"/><Text text="{view&gt;findings}" maxLines="3"/><Text text="{view&gt;inspectedBy}"/></VBox>
 <VBox><Button text="Prüfen" press=".onInspect" visible="{= ${view&gt;/custody/canInspect} &amp;&amp; ${view&gt;canInspect} }"/><Button text="In Eigenbestand" press=".onCustodyRelease" visible="{= ${view&gt;/custody/canReceive} &amp;&amp; ${view&gt;canRelease} }"/><Button text="Zurücksenden" press=".onDispatch" visible="{= ${view&gt;/custody/canReceive} &amp;&amp; ${view&gt;canDispatch} }"/><Button text="Prüfung zurücknehmen" press=".onReverseInspection" visible="{= ${view&gt;/custody/canInspect} &amp;&amp; ${view&gt;canReverseInspection} }"/><Button text="Eingang stornieren" press=".onReverseCustody" visible="{= ${view&gt;/custody/canReceive} &amp;&amp; ${view&gt;canReverseArrival} }"/></VBox>
 </cells></ColumnListItem></items></Table>
 <Table items="{view&gt;/custody/events}" noDataText="Keine Prüfbestandsbewegungen" class="sapUiMediumMarginTop" growing="true"><headerToolbar><OverflowToolbar><Title text="Unveränderliche Prüfbestandsbewegungen"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Beleg / Datum"/></Column><Column><Text text="Aktivität / Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Begründung / Bearbeiter"/></Column><Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Gegenbewegung"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onCustodyRecord"/><Text text="{path:'view&gt;movementDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox><ObjectStatus text="{path:'view&gt;movementType',formatter:'.formatter.custodyMovement'}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}"/></VBox><VBox><Text text="{view&gt;reason}"/><Text text="{view&gt;createdByName}"/></VBox><Button text="Stornieren" press=".onReverseCustody" visible="{= ${view&gt;/custody/canReceive} &amp;&amp; ${view&gt;movementType} === 'DISPATCH' &amp;&amp; !${view&gt;reversalId} }"/></cells></ColumnListItem></items></Table>
 </VBox>
</core:FragmentDefinition>
