<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
<VBox width="100%"><form:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" labelSpanXL="4" labelSpanL="4" labelSpanM="4" adjustLabelSpan="false"><form:content>
<core:Title text="Kontakt und Eingang"/><Label text="Ansprechpartner"/><ComboBox width="100%" selectedKey="{intake&gt;/contactId}" items="{intake&gt;/contacts}"><core:Item key="{intake&gt;id}" text="{= ${intake&gt;firstName} + ' ' + ${intake&gt;lastName} + (${intake&gt;department} ? ' · ' + ${intake&gt;department} : '') }"/></ComboBox><Label text="Standortanschrift"/><ComboBox width="100%" selectedKey="{intake&gt;/addressId}" items="{intake&gt;/addresses}"><core:Item key="{intake&gt;id}" text="{= ${intake&gt;street} + ' · ' + ${intake&gt;postalCode} + ' ' + ${intake&gt;city} }"/></ComboBox><Label text="Eingangskanal"/><Select width="100%" selectedKey="{intake&gt;/channel}"><core:Item key="INTERNAL" text="Intern erfasst"/><core:Item key="PHONE" text="Telefon"/><core:Item key="EMAIL" text="E-Mail"/><core:Item key="MONITORING" text="Monitoring"/><core:Item key="ON_SITE" text="Vor Ort"/></Select><Label text="Erstmals aufgetreten"/><DateTimePicker width="100%" dateValue="{intake&gt;/startedAt}" displayFormat="dd.MM.yyyy HH:mm"/><Label text="Wiedervorlage"/><DatePicker width="100%" value="{intake&gt;/followUpOn}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
<core:Title text="Klassifikation und Auswirkung"/><Label text="Kategorie"/><Select width="100%" selectedKey="{intake&gt;/category}"><core:Item key="HARDWARE" text="Hardware"/><core:Item key="SOFTWARE" text="Software"/><core:Item key="NETWORK" text="Netzwerk"/><core:Item key="IDENTITY" text="Identität und Berechtigungen"/><core:Item key="SECURITY" text="Informationssicherheit"/><core:Item key="CLOUD" text="Cloud und Hosting"/><core:Item key="BACKUP" text="Datensicherung"/><core:Item key="WORKPLACE" text="Arbeitsplatz"/><core:Item key="OTHER" text="Sonstiges"/></Select><Label text="Unterkategorie"/><Input width="100%" value="{intake&gt;/subcategory}" maxLength="120"/><Label text="Auswirkung"/><Select width="100%" selectedKey="{intake&gt;/impact}" change=".onIntakeChange"><core:Item key="PERSON" text="Einzelne Person"/><core:Item key="TEAM" text="Team / Abteilung"/><core:Item key="SITE" text="Standort"/><core:Item key="COMPANY" text="Gesamtes Unternehmen"/></Select><Label text="Dringlichkeit"/><Select width="100%" selectedKey="{intake&gt;/urgency}" change=".onIntakeChange"><core:Item key="LOW" text="Niedrig"/><core:Item key="NORMAL" text="Normal"/><core:Item key="HIGH" text="Hoch"/><core:Item key="IMMEDIATE" text="Sofortige Bearbeitung"/></Select><Label text="Betroffene Personen"/><Input width="100%" type="Number" value="{intake&gt;/affectedUsers}"/><Label text="Ermittelte Priorität"/><ObjectStatus text="{path:'intake&gt;/priority',formatter:'.formatter.priority'}" state="{path:'intake&gt;/priority',formatter:'.formatter.priorityState'}"/>
<core:Title text="Steuerung und Umgebung"/><Label text="Abweichende Priorität"/><Select width="100%" selectedKey="{intake&gt;/priorityOverride}" change=".onIntakeChange"><core:Item key="" text="Aus Bewertung ermitteln"/><core:Item key="LOW" text="Niedrig"/><core:Item key="MEDIUM" text="Normal"/><core:Item key="HIGH" text="Hoch"/><core:Item key="CRITICAL" text="Kritisch"/></Select><Label text="Grund der Abweichung"/><TextArea width="100%" value="{intake&gt;/priorityReason}" rows="3" maxLength="2000" enabled="{= !!${intake&gt;/priorityOverride} }"/><Label text="Betroffener Bereich / Raum"/><Input width="100%" value="{intake&gt;/location}" maxLength="200"/><Label text="Systemumgebung / Version"/><TextArea width="100%" value="{intake&gt;/environment}" rows="3" maxLength="1000"/><Label text="Fehlercode / Meldung"/><Input width="100%" value="{intake&gt;/errorCode}" maxLength="120"/>
</form:content></form:SimpleForm>
<Panel headerText="Diagnose und interne Bearbeitungsinformationen" expandable="true" expanded="true"><form:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Reproduktion"/><Label text="Schritte zur Reproduktion"/><TextArea width="100%" value="{intake&gt;/reproductionSteps}" rows="5" maxLength="4000"/><core:Title text="Betriebliche Auswirkung"/><Label text="Ausfall / Geschäftsbeeinträchtigung"/><TextArea width="100%" value="{intake&gt;/businessImpact}" rows="5" maxLength="4000"/><core:Title text="Maßnahmen und Übergabe"/><Label text="Bekannter Workaround"/><TextArea width="100%" value="{intake&gt;/workaround}" rows="3" maxLength="4000"/><Label text="Interne Übergabe / Bearbeitungshinweise"/><TextArea width="100%" value="{intake&gt;/internalSummary}" rows="4" maxLength="4000"/></form:content></form:SimpleForm></Panel>
<Panel headerText="Verknüpfte Assets und betroffene Systeme" expandable="true" expanded="true" class="sapUiSmallMarginTop"><VBox><Label text="Assets des ausgewählten Kunden" labelFor="intakeAssetSelection"/><MultiComboBox id="intakeAssetSelection" width="100%" selectedKeys="{intake&gt;/assetIds}" selectionFinish=".onIntakeChange" items="{intake&gt;/assets}" placeholder="Assetnummer, Bezeichnung oder Seriennummer suchen"><core:Item key="{intake&gt;id}" text="{= ${intake&gt;number} + ' · ' + ${intake&gt;name} + (${intake&gt;serialNumber} ? ' · ' + ${intake&gt;serialNumber} : '') }"/></MultiComboBox><Table items="{intake&gt;/selectedAssets}" noDataText="Noch keine Assets verknüpft"><columns><Column><Text text="Asset"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Hersteller / Modell"/></Column><Column><Text text="Serien- / Inventarnummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Standort / Garantie"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{intake&gt;name}" text="{intake&gt;number}"/><Text text="{= ${intake&gt;manufacturer} + ' ' + ${intake&gt;model} }"/><ObjectIdentifier title="{intake&gt;serialNumber}" text="{intake&gt;inventoryNumber}"/><VBox><Text text="{intake&gt;location}"/><Text text="{path:'intake&gt;warrantyUntil',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox></cells></ColumnListItem></items></Table><Text text="Es werden bis zu500 kundenbezogene Auswahlwerte geladen. Die Verknüpfung ändert weder Lagerbestand noch Eigentum oder Abrechnung." class="sapUiSmallMarginTop"/></VBox></Panel>
<Panel headerText="Änderungsnachweis" visible="{intake&gt;/editingExisting}" class="sapUiSmallMarginTop"><VBox><Label text="Grund der Qualifikation / Änderung" labelFor="intakeChangeReason" required="true"/><TextArea id="intakeChangeReason" width="100%" rows="3" value="{intake&gt;/reason}" maxLength="2000"/><Text text="Bestehende SLA-Fristen bleiben an die ursprünglich gebundene Vereinbarung gekoppelt. Die Qualifikation erzeugt keine Kosten- oder Fakturabelege."/></VBox></Panel>
</VBox></core:FragmentDefinition>
