<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="netfusion.erp.controller.Pricing"><Page title="Preisfindung &amp; Konditionen" showNavButton="true" navButtonPress=".onHome" class="sapUiResponsiveContentPadding"><content><VBox><Table items="{view&gt;/conditions}" noDataText="Noch keine Konditionen konfiguriert"><headerToolbar><OverflowToolbar><Title text="Konditionen"/><ToolbarSpacer/><Button text="Kondition anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewCondition"/><Button icon="sap-icon://refresh" tooltip="Konditionen aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Konditionsart"/></Column><Column><Text text="Berechnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Reihenfolge / Priorität"/></Column><Column><Text text="Wert / Währung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Gültigkeit / Staffel"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;code}" text="{view&gt;taxCode}"/><Text text="{view&gt;kind}"/><Text text="{= ${view&gt;sequence} + ' / ' + ${view&gt;priority} }"/><ObjectNumber number="{view&gt;value}" unit="{= ${view&gt;kind} === 'TAX' || ${view&gt;kind} === 'DISCOUNT_PERCENT' || ${view&gt;kind} === 'SURCHARGE_PERCENT' ? '%' : ${view&gt;currency} }"/><VBox><Text text="{= ${view&gt;validFrom} + ' – ' + ${view&gt;validTo} }"/><Text text="{= 'Ab Menge ' + ${view&gt;minimumQuantity} }"/></VBox><VBox><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Historisch' }"/><Button text="Deaktivieren" press=".onDisable" visible="{= ${view&gt;active} &amp;&amp; (${view&gt;kind} === 'TAX' ? ${state&gt;/access/financeWrite} : ${state&gt;/access/salesWrite}) }"/></VBox></cells></ColumnListItem></items></Table><MessageStrip text="Reihenfolge und Priorität bestimmen die Preisfindung. Gleichrangige widersprüchliche Konditionen werden abgewiesen. Bestehende Auftragspositionen behalten ihren Preisstand." type="Information" showIcon="true" class="sapUiMediumMarginTop"/></VBox></content></Page></mvc:View>
