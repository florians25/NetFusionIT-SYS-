<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Order" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout id="orderObjectPage" height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showAnchorBar="true" enableLazyLoading="false">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle id="orderHeader">
   <uxap:heading><Title text="{view&gt;/order/title}" titleStyle="H2" wrapping="true"/></uxap:heading>
   <uxap:expandedContent><ObjectIdentifier title="{view&gt;/order/number}" text="{path:'view&gt;/order/kind',formatter:'.formatter.orderKind'}"/><ObjectStatus text="{path:'view&gt;/order/status',formatter:'.formatter.status'}" state="{path:'view&gt;/order/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent>
   <uxap:snappedContent><ObjectStatus text="{path:'view&gt;/order/status',formatter:'.formatter.status'}" state="{path:'view&gt;/order/status',formatter:'.formatter.statusState'}"/></uxap:snappedContent>
   <uxap:actions><Button text="Auftragsübersicht" icon="sap-icon://list" press=".onOrders"/><Button text="Auftrag einreichen" type="Emphasized" icon="sap-icon://approvals" press=".onSubmit" visible="{view&gt;/canEdit}"/><Button text="Technisch abschließen" icon="sap-icon://complete" press=".onComplete" visible="{view&gt;/execution/canComplete}"/><Button text="Für Fakturierung freigeben" press=".onBillingReady" visible="{view&gt;/execution/canBillingReady}"/><Button icon="sap-icon://refresh" tooltip="Auftrag aktualisieren" press=".load"/></uxap:actions>
  </uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><HBox wrap="Wrap" alignItems="Start">
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kunde"/><Title text="{view&gt;/order/partnerName}" titleStyle="H4"/><Label text="Preisdatum" class="sapUiSmallMarginTop"/><Text text="{view&gt;/order/pricingDate}"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Netto gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/net'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}" emphasized="false"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Steuer gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/tax'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}" emphasized="false"/></VBox>
   <VBox class="sapUiSmallMarginBottom"><Label text="Brutto gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/gross'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/></VBox>
  </HBox></uxap:headerContent>
  <uxap:sections>
   <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
    <Table items="{view&gt;/order/items}" noDataText="Noch keine Auftragspositionen"><headerToolbar><OverflowToolbar><Title text="Auftragspositionen"/><ToolbarSpacer/><Button text="Position anlegen" icon="sap-icon://add" type="Emphasized" press=".onAddItem" visible="{view&gt;/canEdit}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Position / Artikel"/></Column><Column><Text text="Plan / Ist / Einheit"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Abrechnung / Leistung"/></Column><Column hAlign="End"><Text text="Netto"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Steuer"/></Column><Column hAlign="End"><Text text="Brutto"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;sku} }"/><VBox><ObjectNumber number="{view&gt;quantity}" unit="{view&gt;unit}" emphasized="false"/><ObjectStatus text="{= 'Freigegeben: ' + ${view&gt;actualQuantity} + ' ' + ${view&gt;unit} }"/></VBox><VBox><Text text="{path:'view&gt;billingRule',formatter:'.formatter.billingRule'}"/><ObjectStatus text="{path:'view&gt;serviceStatus',formatter:'.formatter.status'}"/></VBox><ObjectNumber number="{parts:[{path:'view&gt;net'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/><ObjectNumber number="{parts:[{path:'view&gt;tax'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/><ObjectNumber number="{parts:[{path:'view&gt;gross'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/></cells></ColumnListItem></items></Table>
   </uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>

   <uxap:ObjectPageSection title="Leistungen &amp; Zeiten" visible="{state&gt;/access/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox>
    <OverflowToolbar><Title text="Vom Ticket übernommene Zeiten"/><ToolbarSpacer/><Button text="Im Ticket bearbeiten" visible="{state&gt;/access/service}" icon="sap-icon://customer-and-contacts" press=".onTicketWork"/></OverflowToolbar>
    <Table items="{view&gt;/execution/times}" noDataText="Noch keine Arbeitszeiten erfasst"><columns><Column><Text text="Tätigkeit / Mitarbeiter"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zeitraum"/></Column><Column hAlign="End"><Text text="Stunden"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Freigabe / Abrechnung"/></Column><Column hAlign="End" width="4rem"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;workerName}"/><VBox><Text text="{path:'view&gt;startedAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;endedAt',formatter:'.formatter.date'}"/><Text text="{= 'Pause: ' + ${view&gt;pauseSeconds} + ' s' }"/></VBox><ObjectNumber number="{view&gt;quantity}" unit="HUR"/><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{= ${view&gt;billable} ? 'Abrechenbar' : 'Nicht abrechenbar' }"/></VBox><Button icon="sap-icon://inspect" tooltip="Ursprungsticket öffnen" visible="{state&gt;/access/service}" press=".onTimeTicket"/></cells></ColumnListItem></items></Table>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Leistungsnachweise"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/execution/reports}" noDataText="Noch keine Leistungsnachweise"><headerToolbar><OverflowToolbar><Title text="Teil- und Endrückmeldungen"/><ToolbarSpacer/></OverflowToolbar></headerToolbar><columns><Column><Text text="Nachweis"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Verfasser"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kundenbestätigung"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onReport"/><Text text="{view&gt;title}"/><ObjectStatus text="{= ${view&gt;isFinal} ? 'Endrückmeldung' : 'Teilrückmeldung' }"/></VBox><Text text="{view&gt;authorName}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><ObjectStatus text="{= ${view&gt;customerConfirmedAt} ? 'Bestätigt' : 'Ausstehend' }" state="{= ${view&gt;customerConfirmedAt} ? 'Success' : 'Warning' }"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Material &amp; Beschaffung" visible="{state&gt;/access/requisitionRead}"><uxap:subSections>
    <uxap:ObjectPageSubSection title="Materialbedarf"><uxap:blocks><Table items="{view&gt;/procurement/requirements}" noDataText="Noch kein Materialbedarf"><headerToolbar><OverflowToolbar><Title text="Bedarfe des Serviceauftrags"/><ToolbarSpacer/><Button text="Materialbedarf anlegen" type="Emphasized" icon="sap-icon://add" press=".onNewRequirement" visible="{view&gt;/canMaterial}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Bedarf"/></Column><Column><Text text="Bezeichnung"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;title}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Bestellanforderungen"><uxap:blocks><Table items="{view&gt;/procurement/requisitions}" noDataText="Noch keine BANF"><columns><Column><Text text="BANF"/></Column><Column><Text text="Bezeichnung"/></Column><Column><Text text="Freigabe / Bestellung"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;title}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Bestellungen"><uxap:blocks><Table items="{view&gt;/procurement/purchaseOrders}" noDataText="Noch keine Bestellungen"><columns><Column><Text text="Bestellung"/></Column><Column><Text text="Lieferant"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;supplierName}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
   </uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Preisfindungsprotokoll" visible="{state&gt;/access/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/trace}" noDataText="Noch kein Preisfindungsprotokoll"><columns><Column><Text text="Position"/></Column><Column><Text text="Konditionsart"/></Column><Column><Text text="Wert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Vorher"/></Column><Column><Text text="Nachher"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;position}"/><Text text="{view&gt;code}"/><Text text="{view&gt;value}"/><Text text="{view&gt;before}"/><Text text="{view&gt;after}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  </uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
