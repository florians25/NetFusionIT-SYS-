<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Order" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout id="orderObjectPage" height="100%" showHeaderContent="{= !${device&gt;/system/phone} }" headerExpanded="{= !${device&gt;/system/phone} }" useIconTabBar="true" upperCaseAnchorBar="false" showAnchorBar="true" enableLazyLoading="false">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle id="orderHeader">
   <uxap:heading><Title text="{view&gt;/order/title}" titleStyle="H2" wrapping="true"/></uxap:heading>
   <uxap:expandedContent><ObjectIdentifier title="{view&gt;/order/number}" text="{path:'view&gt;/order/kind',formatter:'.formatter.orderKind'}"/><ObjectStatus text="{path:'view&gt;/order/status',formatter:'.formatter.status'}" state="{path:'view&gt;/order/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent>
   <uxap:snappedContent><ObjectStatus text="{path:'view&gt;/order/status',formatter:'.formatter.status'}" state="{path:'view&gt;/order/status',formatter:'.formatter.statusState'}"/></uxap:snappedContent>
   <uxap:actions><Button text="Fakturaanforderung" icon="sap-icon://sales-document" press=".onBillingRequest" visible="{= ${state&gt;/access/billingRelease} &amp;&amp; ['BILLING_READY','PARTIALLY_BILLED','FULLY_BILLED'].includes(${view&gt;/order/status}) }"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Auftragsübersicht" icon="sap-icon://list" press=".onOrders"/><Button text="Auftrag einreichen" type="Emphasized" icon="sap-icon://approvals" press=".onSubmit" visible="{view&gt;/canEdit}"/><Button text="Technisch abschließen" icon="sap-icon://complete" press=".onComplete" visible="{view&gt;/execution/canComplete}"/><Button text="Für Fakturierung freigeben" press=".onBillingReady" visible="{view&gt;/execution/canBillingReady}"/><Button icon="sap-icon://refresh" tooltip="Auftrag aktualisieren" press=".load"/></uxap:actions>
  </uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><HBox wrap="Wrap" alignItems="Start">
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kunde"/><Title text="{view&gt;/order/partnerName}" titleStyle="H4"/><Text text="{view&gt;/order/context/partnerEmail}"/><Text text="{view&gt;/order/context/partnerAddress/street}" visible="{= !!${view&gt;/order/context/partnerAddress/street} }"/><Text text="{= (${view&gt;/order/context/partnerAddress/postalCode} || '') + ' ' + (${view&gt;/order/context/partnerAddress/city} || '') }" visible="{= !!${view&gt;/order/context/partnerAddress} }"/><Label text="Servicefall" class="sapUiTinyMarginTop"/><Link text="{view&gt;/order/context/caseNumber}" press=".onCase" visible="{state&gt;/access/service}"/><Text text="{view&gt;/order/context/caseNumber}" visible="{= !${state&gt;/access/service} }"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Serviceorganisation"/><Text text="{view&gt;/order/context/organizationName}"/><Label text="Buchungskreis" class="sapUiTinyMarginTop"/><Text text="{= (${view&gt;/order/context/companyCode} || 'Nicht konfiguriert') + ' ' + (${view&gt;/order/context/companyName} || '') }"/><Label text="Materialversorgung" class="sapUiTinyMarginTop" visible="{= ${view&gt;/material/summary/positions} &gt; 0 }"/><ObjectStatus text="{path:'view&gt;/material/status',formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;/material/status',formatter:'.formatter.supplyState'}" visible="{= ${view&gt;/material/summary/positions} &gt; 0 }"/><Text text="{= ${view&gt;/material/summary/ready} + ' / ' + ${view&gt;/material/summary/positions} + ' Materialpositionen bereit' }" visible="{= ${view&gt;/material/summary/positions} &gt; 0 }"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Netto gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/net'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}" emphasized="false"/><Label text="Steuer gesamt" class="sapUiTinyMarginTop"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/tax'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}" emphasized="false"/><Label text="Brutto gesamt" class="sapUiTinyMarginTop"/><ObjectNumber number="{parts:[{path:'view&gt;/order/totals/gross'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/></VBox>
   <VBox class="sapUiSmallMarginBottom"><Label text="Leistungsnachweise freigegeben"/><Text text="{view&gt;/reportSummary}"/><Label text="Preisdatum" class="sapUiTinyMarginTop"/><Text text="{path:'view&gt;/order/pricingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><Label text="Erstellt von" class="sapUiTinyMarginTop"/><Text text="{view&gt;/order/context/createdByName}"/><Text text="{path:'view&gt;/order/context/createdAt',formatter:'.formatter.date'}"/></VBox>
  </HBox></uxap:headerContent>
  <uxap:sections>
   <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
    <Table items="{view&gt;/order/items}" noDataText="Noch keine Auftragspositionen"><headerToolbar><OverflowToolbar><Title text="Auftragspositionen"/><ToolbarSpacer/><Button text="Position anlegen" icon="sap-icon://add" type="Emphasized" press=".onAddItem" visible="{view&gt;/canEdit}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Position / Artikel"/></Column><Column><Text text="Plan / Ist / Einheit"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Abrechnung / Leistung"/></Column><Column hAlign="End"><Text text="Netto"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Steuer"/></Column><Column hAlign="End"><Text text="Brutto"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;sku} }"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" emphasized="false"/><ObjectStatus text="{= 'Freigegeben: ' + ${view&gt;actualQuantity} + ' ' + ${view&gt;unit} }"/></VBox><VBox><Text text="{path:'view&gt;billingRule',formatter:'.formatter.billingRule'}"/><ObjectStatus text="{path:'view&gt;serviceStatus',formatter:'.formatter.status'}"/><ObjectStatus text="{parts:[{path:'view&gt;supplyStatus'},{path:'view&gt;kind'}],formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;supplyStatus',formatter:'.formatter.supplyState'}" visible="{= ${view&gt;supplyStatus} !== 'NOT_REQUIRED' }"/></VBox><ObjectNumber number="{parts:[{path:'view&gt;net'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/><ObjectNumber number="{parts:[{path:'view&gt;tax'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/><ObjectNumber number="{parts:[{path:'view&gt;gross'},{path:'view&gt;/order/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/order/currency}"/></cells></ColumnListItem></items></Table>
   </uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>

   <uxap:ObjectPageSection title="Allgemeine Informationen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><form:SimpleForm layout="ResponsiveGridLayout" columnsL="3" columnsM="2" editable="false"><form:content><core:Title text="Geschäfts- und Organisationsdaten"/><Label text="Auftragsart"/><Text text="{path:'view&gt;/order/kind',formatter:'.formatter.orderKind'}"/><Label text="Serviceorganisation"/><Text text="{view&gt;/order/context/organizationName}"/><Label text="Buchungskreis"/><Text text="{= (${view&gt;/order/context/companyCode} || 'Nicht konfiguriert') + ' ' + (${view&gt;/order/context/companyName} || '') }"/><Label text="Währung"/><Text text="{view&gt;/order/currency}"/><core:Title text="Kunde und Ursprung"/><Label text="Kunde"/><Text text="{view&gt;/order/partnerName}"/><Label text="E-Mail"/><Text text="{view&gt;/order/context/partnerEmail}"/><Label text="Servicefall"/><Text text="{view&gt;/order/context/caseNumber}"/><Label text="Ursprungsticket"/><Text text="{= ${view&gt;/order/context/sourceTicketNumber} || 'Servicefallbezogener Auftrag' }"/><Label text="Servicevertrag"/><Text text="{= ${view&gt;/order/context/contractNumber} || 'Kein Vertragsbezug' }"/><core:Title text="Bearbeitung und Rückmeldung"/><Label text="Ausführungsstatus"/><ObjectStatus text="{path:'view&gt;/order/status',formatter:'.formatter.status'}"/><Label text="Materialversorgung"/><ObjectStatus text="{path:'view&gt;/material/status',formatter:'.formatter.supplyStatus'}"/><Label text="Nachweise freigegeben / gesamt"/><Text text="{view&gt;/reportSummary}"/><Label text="Erstellt von"/><Text text="{view&gt;/order/context/createdByName}"/><Label text="Erstellt am"/><Text text="{path:'view&gt;/order/context/createdAt',formatter:'.formatter.date'}"/><Label text="Belegversion"/><Text text="{view&gt;/order/version}"/></form:content></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Leistungen &amp; Zeiten" visible="{state&gt;/access/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox>
    <OverflowToolbar><Title text="Vom Ticket übernommene Zeiten"/><ToolbarSpacer/><Button text="Im Ticket bearbeiten" visible="{state&gt;/access/service}" icon="sap-icon://customer-and-contacts" press=".onTicketWork"/></OverflowToolbar>
    <Table items="{view&gt;/execution/times}" noDataText="Noch keine Arbeitszeiten erfasst"><columns><Column><Text text="Tätigkeit / Mitarbeiter"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zeitraum"/></Column><Column hAlign="End"><Text text="Stunden"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Freigabe / Abrechnung"/></Column><Column hAlign="End" width="4rem"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;workerName}"/><VBox><Text text="{path:'view&gt;startedAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;endedAt',formatter:'.formatter.date'}"/><Text text="{= 'Pause: ' + ${view&gt;pauseSeconds} + ' s' }"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="HUR"/><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{= ${view&gt;billable} ? 'Abrechenbar' : 'Nicht abrechenbar' }"/></VBox><Button icon="sap-icon://inspect" tooltip="Ursprungsticket öffnen" visible="{state&gt;/access/service}" press=".onTimeTicket"/></cells></ColumnListItem></items></Table>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Leistungsnachweise"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/execution/reports}" noDataText="Noch keine Leistungsnachweise"><headerToolbar><OverflowToolbar><Title text="Teil- und Endrückmeldungen"/><ToolbarSpacer/></OverflowToolbar></headerToolbar><columns><Column><Text text="Nachweis"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Verfasser"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kundenbestätigung"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onReport"/><Text text="{view&gt;title}"/><ObjectStatus text="{= ${view&gt;isFinal} ? 'Endrückmeldung' : 'Teilrückmeldung' }"/></VBox><Text text="{view&gt;authorName}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><ObjectStatus text="{= ${view&gt;customerConfirmedAt} ? 'Bestätigt' : 'Ausstehend' }" state="{= ${view&gt;customerConfirmedAt} ? 'Success' : 'Warning' }"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection id="materialSupplySection" title="Material &amp; Beschaffung" visible="{= ${state&gt;/access/requisitionRead} &amp;&amp; ${view&gt;/material/summary/positions} &gt; 0 }"><uxap:subSections>
    <uxap:ObjectPageSubSection title="Versorgung der Auftragspositionen"><uxap:blocks><VBox><MessageStrip text="{view&gt;/materialResult/text}" type="{view&gt;/materialResult/type}" showIcon="true" visible="{= !!${view&gt;/materialResult} }" class="sapUiSmallMarginBottom"/><MessageStrip text="{= ${view&gt;/material/summary/withoutStock} + ' Lagerposition(en) ohne ausreichenden freien Bestand. Vorhandene Mengen reservieren und Fehlmengen mit Teile bestellen anfordern.' }" type="Warning" showIcon="true" visible="{= ${view&gt;/material/summary/withoutStock} &gt; 0 }" class="sapUiSmallMarginBottom"/>
    <MessageStrip text="Für die Auslieferung zuerst eine offene Work Order Task im Ticket diesem Serviceauftrag zuordnen." type="Information" showIcon="true" visible="{view&gt;/deliveryNeedsTask}" class="sapUiSmallMarginBottom"/><Table items="{view&gt;/material/items}" noDataText="Keine Materialpositionen"><headerToolbar><OverflowToolbar><Title text="Materialversorgung"/><ObjectStatus text="{path:'view&gt;/material/status',formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;/material/status',formatter:'.formatter.supplyState'}"/><ToolbarSpacer/><Button text="Ausliefern" icon="sap-icon://shipping-status" type="Emphasized" press=".onDeliver" visible="{view&gt;/canDeliver}" enabled="{view&gt;/hasDeliverable}"/><Button text="Lagerbestand nutzen" icon="sap-icon://inventory" press=".onUseStock" visible="{view&gt;/canMaterial}" enabled="{view&gt;/hasUsableStock}"/><Button text="Teile bestellen" icon="sap-icon://cart" type="Emphasized" press=".onRequestParts" visible="{view&gt;/canRequestParts}" enabled="{view&gt;/hasUnrequestedNeed}"/></OverflowToolbar></headerToolbar><columns>
     <Column width="18rem"><Text text="Position / Artikel"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Bedarf / Termin"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Lager frei / reserviert / geliefert"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Fehlend / anzufordern"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="BANF / bestellt / geliefert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Versorgungsstatus"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Kontierung"/></Column><Column visible="{view&gt;/canMaterial}" minScreenWidth="Tablet" demandPopin="true"><Text text="Positionsaktionen"/></Column>
    </columns><items><ColumnListItem vAlign="Top"><cells>
     <VBox><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;sku} }"/><Text text="{path:'view&gt;kind',formatter:'.formatter.productKind'}"/></VBox>
     <VBox alignItems="End"><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{path:'view&gt;requiredOn',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/></VBox>
     <VBox><VBox alignItems="End" visible="{= ${view&gt;kind} === 'STOCK' }"><ObjectNumber number="{path:'view&gt;availableQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" emphasized="false"/><ObjectNumber number="{path:'view&gt;reservedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" state="Success" emphasized="false"/><ObjectNumber number="{path:'view&gt;consumedQuantity',formatter:'.formatter.decimal'}" unit="{= 'Ausgeliefert ' + ${view&gt;unit} }" state="Information"/></VBox><Text text="{= ${view&gt;kind} === 'EXTERNAL_SERVICE' ? 'Fremdleistungsbeschaffung' : 'Direktbeschaffung' }" visible="{= ${view&gt;kind} !== 'STOCK' }"/></VBox>
     <VBox alignItems="End"><ObjectNumber number="{path:'view&gt;physicalShortageQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" state="{= Number(${view&gt;physicalShortageQuantity}) &gt; 0 ? 'Warning' : 'None' }"/><ObjectStatus text="{parts:[{path:'view&gt;shortageQuantity'},{path:'view&gt;unit'}],formatter:'.formatter.toRequest'}"/></VBox>
     <VBox><HBox justifyContent="SpaceBetween"><Text text="BANF"/><ObjectNumber number="{path:'view&gt;requestedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" emphasized="false"/></HBox><HBox justifyContent="SpaceBetween"><Text text="Bestellt"/><ObjectNumber number="{path:'view&gt;orderedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" emphasized="false"/></HBox><HBox justifyContent="SpaceBetween"><Text text="Geliefert"/><ObjectNumber number="{path:'view&gt;receivedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" emphasized="false"/></HBox></VBox>
     <VBox><ObjectStatus text="{parts:[{path:'view&gt;supplyStatus'},{path:'view&gt;kind'}],formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;supplyStatus',formatter:'.formatter.supplyState'}"/><ObjectStatus text="Kein freier Lagerbestand" icon="sap-icon://alert" state="Warning" visible="{view&gt;noStock}"/></VBox>
     <ObjectIdentifier title="{view&gt;costCenter}" text="{view&gt;costObject}"/>
     <VBox><Button text="Ausliefern" icon="sap-icon://shipping-status" press=".onDeliver" visible="{view&gt;canDeliver}"/><Button text="Lager nutzen" icon="sap-icon://inventory" press=".onUseStock" visible="{view&gt;canUseStock}" enabled="{view&gt;hasUsableStock}"/><Button text="Teile bestellen" icon="sap-icon://cart" press=".onRequestParts" visible="{view&gt;canRequest}" enabled="{view&gt;hasUnrequestedNeed}"/></VBox>
    </cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Reservierungen und Lagerzuordnung" visible="{= ${view&gt;/material/reservations}.length &gt; 0 }"><uxap:blocks><Table items="{view&gt;/material/reservations}"><columns><Column><Text text="Artikel"/></Column><Column><Text text="Werk / Lagerort"/></Column><Column hAlign="End"><Text text="Menge / Offen / Geliefert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Herkunft"/></Column><Column><Text text="Status"/></Column><Column visible="{view&gt;/canMaterial}"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;remainingQuantity',formatter:'.formatter.decimal'}" unit="{= 'Offen ' + ${view&gt;unit} }" emphasized="false"/><ObjectNumber number="{path:'view&gt;consumedQuantity',formatter:'.formatter.decimal'}" unit="{= 'Geliefert ' + ${view&gt;unit} }" state="Information"/></VBox><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><Text text="{= ${view&gt;source} === 'STOCK' ? 'Vorhandener Lagerbestand' : 'Auftragsbeschaffung' }"/><ObjectStatus text="{= ${view&gt;status} === 'ACTIVE' ? 'Aktiv reserviert' : ${view&gt;status} === 'CONSUMED' ? 'Vollständig ausgeliefert' : 'Freigegeben' }"/><Button text="Reservierung freigeben" press=".onReleaseReservation" visible="{view&gt;canRelease}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Auslieferungen und Rücknahmen" visible="{= (${view&gt;/deliveries} || []).length &gt; 0 }"><uxap:blocks><Table items="{view&gt;/deliveries}"><columns><Column><Text text="Materialbeleg / Lieferschein"/></Column><Column><Text text="Bewegung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aufgabenzuordnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onGoodsIssue"/><Text text="{view&gt;deliveryNumber}"/></VBox><Text text="{path:'view&gt;movementType',formatter:'.formatter.movementType'}"/><Text text="{view&gt;taskNumber}"/><Text text="{path:'view&gt;postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><ObjectStatus text="{= ${view&gt;reversalId} ? 'Zurückgenommen' : 'Gebucht' }" state="{= ${view&gt;reversalId} ? 'Warning' : 'Success' }"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Automatisch erkannte Bedarfe"><uxap:blocks><Table items="{view&gt;/procurement/requirements}" noDataText="Bedarf wird bei Auftragsfreigabe automatisch aus den Materialpositionen erzeugt."><columns><Column><Text text="Bedarfsbeleg"/></Column><Column><Text text="Bezeichnung"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;title}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Bestellanforderungen" visible="{= ${view&gt;/procurement/requisitions}.length &gt; 0 }"><uxap:blocks><Table items="{view&gt;/procurement/requisitions}"><columns><Column><Text text="BANF"/></Column><Column><Text text="Bezeichnung"/></Column><Column><Text text="Freigabe / Bestellung"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;title}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Bestellungen" visible="{= ${view&gt;/procurement/purchaseOrders}.length &gt; 0 }"><uxap:blocks><Table items="{view&gt;/procurement/purchaseOrders}"><columns><Column><Text text="Bestellung"/></Column><Column><Text text="Lieferant"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onProcurement"/><Text text="{view&gt;supplierName}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection>
    <uxap:ObjectPageSubSection title="Wareneingänge" visible="{= ${view&gt;/procurement/receipts}.length &gt; 0 }"><uxap:blocks><Table items="{view&gt;/procurement/receipts}"><columns><Column><Text text="Materialbeleg"/></Column><Column><Text text="Bewegung"/></Column><Column><Text text="Lieferschein"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onGoodsReceipt"/><Text text="{path:'view&gt;movementType',formatter:'.formatter.movementType'}"/><Text text="{view&gt;deliveryNote}"/><Text text="{view&gt;postingDate}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Preisfindungsprotokoll" visible="{state&gt;/access/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/trace}" noDataText="Noch kein Preisfindungsprotokoll"><columns><Column><Text text="Position"/></Column><Column><Text text="Konditionsart"/></Column><Column><Text text="Wert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Vorher"/></Column><Column><Text text="Nachher"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;position}"/><Text text="{view&gt;code}"/><Text text="{view&gt;value}"/><Text text="{view&gt;before}"/><Text text="{view&gt;after}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  </uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
