<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.SalesOrders" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Kundenaufträge"/></f:heading><f:expandedContent><ObjectStatus text="Vertrieb · kommerzieller Auftragsbestand" state="Information" icon="sap-icon://sales-order"/></f:expandedContent><f:actions><Button text="Kundenauftrag anlegen" type="Emphasized" press=".onCreate" visible="{state&gt;/access/salesWrite}"/><Button text="Vertriebsstammdaten" press=".onSalesSetup" visible="{state&gt;/access/salesConfigRead}"/><Button icon="sap-icon://refresh" tooltip="Kundenaufträge aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><VBox><layout:Grid defaultSpan="XL3 L3 M6 S12"><VBox><Label text="Kunde / Auftrag / Referenz" labelFor="salesQuery"/><SearchField id="salesQuery" value="{view&gt;/query}" placeholder="Kunde, AU-Nummer, Bestellung, Vertriebsbereich" search=".onFilter" liveChange=".onFilter"/></VBox><VBox><Label text="Auftragsstatus" labelFor="salesStatus"/><Select id="salesStatus" width="100%" selectedKey="{view&gt;/status}" change=".onFilter"><core:Item key="" text="Alle Zustände"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="IN_REVIEW" text="In unabhängiger Prüfung"/><core:Item key="RELEASED" text="Freigegeben"/><core:Item key="REJECTED" text="Abgelehnt"/><core:Item key="CANCELLED" text="Abgebrochen"/></Select></VBox><VBox><Label text="Auftragsdatum von" labelFor="salesFrom"/><DatePicker id="salesFrom" width="100%" value="{view&gt;/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter"/></VBox><VBox><Label text="Auftragsdatum bis" labelFor="salesTo"/><DatePicker id="salesTo" width="100%" value="{view&gt;/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter"/></VBox></layout:Grid><HBox wrap="Wrap" 