<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.SalesSetup" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Vertriebsstammdaten"/></f:heading><f:expandedContent><ObjectStatus text="Verkaufsorganisation, Vertriebsweg, Sparte und Bedingungen" state="Information"/></f:expandedContent><f:actions><Button text="Einheit anlegen" press=".onUnit" visible="{state&gt;/access/salesConfigure}"/><Button text="Vertriebsbereich anlegen" press=".onArea" visible="{state&gt;/access/salesConfigure}"/><Button text="Bedingung anlegen" press=".onTerm" visible="{state&gt;/access/salesConfigure}"/><Button icon="sap-icon://refresh" tooltip="Vertriebsstammdaten aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><layout:Grid defaultSpan="XL3 L3 M6 S12"><VBox><Label text="Organisation" labelFor="salesOrganization"/><Select id="salesOrganization" width="100%" selectedKey="{view&gt;/organizationId}" items="{view&gt;/organizations}" change=".onFilter"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select></VBox><VBox><Label text="Aktive Einheiten"/><ObjectNumber number="{view&gt;/summary/units}" unit="Einheiten"/></VBox><VBox><Label text="Vollständig aktive Vertriebsbereiche"/><ObjectNumber number="{view&gt;/summary/areas}" unit="Bereiche"/></VBox><VBox><Label text="Aktive Bedingungen"/><ObjectNumber number="{view&gt;/summary/terms}" unit="Bedingungen"/></VBox></layout:Grid></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiSmallMargin"><MessageStrip text="Codes und Zuordnungen bleiben erhalten. Änderungen an Bezeichnung oder Aktivität erhalten eine neue Revision. Freigegebene Kundenaufträge und archivierte Formulare behalten ihren angenommenen Stand." showIcon="true"/><IconTabBar expandable="false" class="sapUiSmallMarginTop"><items><IconTabFilter text="Organisationseinheiten" icon="sap-icon://org-chart"><Table items="{view&gt;/list/units}" noDataText="Noch keine Vertriebseinheiten konfiguriert."><columns><Column><Text text="Einheit / Code"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Revision"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aktivität"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Pflege"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{path:'view&gt;kind',formatter:'.formatter.salesUnit'}" text="{view&gt;code}"/><Text text="{view&gt;name}"/><Text text="{view&gt;version}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Gesperrt' }" state="{= ${view&gt;active} ? 'Success' : 'Warning' }"/><Button text="Bearbeiten" press=".onEdit" visible="{state&gt;/access/salesConfigure}"><customData><core:CustomData key="kind" value="units"/></customData></Button></cells></ColumnListItem></items></Table></IconTabFilter><IconTabFilter text="Vertriebsbereiche" icon="sap-icon://sales-document"><Table items="{view&gt;/list/areas}" noDataText="Noch kein Vertriebsbereich aus passenden aktiven Einheiten angelegt."><columns><Column><Text text="Verkaufsorganisation"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Vertriebsweg"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Sparte"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Revision"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Verwendbarkeit"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Pflege"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;salesOrgCode}"/><Text text="{view&gt;channelCode}"/><Text text="{view&gt;divisionCode}"/><Text text="{view&gt;version}"/><ObjectStatus text="{= !${view&gt;active} ? 'Gesperrt' : ${view&gt;effectiveActive} ? 'Aktiv' : 'Komponente gesperrt' }" state="{= ${view&gt;effectiveActive} ? 'Success' : 'Warning' }"/><Button text="Bearbeiten" press=".onEdit" visible="{state&gt;/access/salesConfigure}"><customData><core:CustomData key="kind" value="areas"/></customData></Button></cells></ColumnListItem></items></Table></IconTabFilter><IconTabFilter text="Zahlung, Versand &amp; Incoterms" icon="sap-icon://shipping-status"><Table items="{view&gt;/list/terms}" noDataText="Noch keine verbindlichen Vertriebsbedingungen konfiguriert."><columns><Column><Text text="Bedingungsart / Code"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Netto-Tage / Version"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Revision"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aktivität"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Pflege"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{path:'view&gt;kind',formatter:'.formatter.salesTerm'}" text="{view&gt;code}"/><Text text="{view&gt;name}"/><Text text="{= ${view&gt;kind} === 'PAYMENT' ? ${view&gt;netDays} + ' Tage netto' : ${view&gt;edition} || '—' }"/><Text text="{view&gt;version}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Gesperrt' }" state="{= ${view&gt;active} ? 'Success' : 'Warning' }"/><Button text="Bearbeiten" press=".onEdit" visible="{state&gt;/access/salesConfigure}"><customData><core:CustomData key="kind" value="terms"/></customData></Button></cells></ColumnListItem></items></Table></IconTabFilter></items></IconTabBar></VBox></f:content></f:DynamicPage></mvc:View>
