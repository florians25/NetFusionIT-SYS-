<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.IncomingInvoices" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false">
  <f:title><f:DynamicPageTitle><f:heading><Title text="Rechnungseingang"/></f:heading><f:actions><Button text="Original empfangen" icon="sap-icon://upload" type="Emphasized" press=".onReceive" visible="{state&gt;/access/apReceive}"/><Button icon="sap-icon://refresh" tooltip="Rechnungseingang aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Eingänge"/><ObjectNumber number="{view&gt;/counts/total}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Prüfung offen / läuft"/><ObjectNumber number="{view&gt;/counts/pending}" state="Information"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Technisch validiert"/><ObjectNumber number="{view&gt;/counts/validated}" state="Success"/></VBox><VBox><Label text="Klärungsbedarf"/><ObjectNumber number="{view&gt;/counts/clarify}" state="Warning"/></VBox></HBox></f:DynamicPageHeader></f:header>
  <f:content><VBox><MessageStrip text="Originale prüfen und zuordnen. Eine technisch gültige E-Rechnung benötigt anschließend die sachliche und steuerliche Rechnungsprüfung." showIcon="true" class="sapUiSmallMarginBottom"/>
   <Toolbar><Label text="Prüfstatus"/><Select change=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="incomingList"/><core:CustomData key="filterField" value="importState"/></customData><items><core:Item key="" text="Alle Prüfstatus"/><core:Item key="PENDING" text="Prüfung vorgemerkt"/><core:Item key="VALIDATED" text="Technisch validiert"/><core:Item key="QUARANTINE" text="Quarantäne"/><core:Item key="INVALID" text="Ungültig"/><core:Item key="UNSUPPORTED" text="Manuell klären"/><core:Item key="FAILED" text="Prüfung fehlgeschlagen"/></items></Select><ToolbarSpacer/><SearchField width="22rem" placeholder="EG, Lieferantenbeleg oder Aussteller" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="incomingList"/><core:CustomData key="fields" value="number,externalNumber,supplierName,filename,companyCode"/></customData></SearchField></Toolbar>
   <Table id="incomingList" items="{view&gt;/invoices}" growing="true" growingThreshold="30" itemPress=".onOpen" noDataText="Noch keine Originalrechnungen empfangen"><headerToolbar><OverflowToolbar><Title text="Rechnungseingänge" level="H3"/><ToolbarSpacer/><Text text="Bis zu 500 aktuelle Eingänge"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Interner / externer Beleg"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aussteller / Originaldatei"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungskreis / Datum"/></Column><Column hAlign="End"><Text text="Rechnungsbetrag"/></Column><Column><Text text="Technik / Finanzstand"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;externalNumber}"/><ObjectIdentifier title="{view&gt;supplierName}" text="{view&gt;filename}"/><VBox><Text text="{view&gt;companyCode}"/><Text text="{path:'view&gt;invoiceDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><ObjectNumber number="{path:'view&gt;gross',formatter:'.formatter.money'}" unit="{view&gt;currency}"/><VBox><ObjectStatus text="{path:'view&gt;importState',formatter:'.formatter.incomingState'}" state="{path:'view&gt;importState',formatter:'.formatter.incomingValueState'}"/><ObjectStatus text="{path:'view&gt;financialStatus',formatter:'.formatter.status'}" state="{path:'view&gt;financialStatus',formatter:'.formatter.statusState'}"/><Text text="{path:'view&gt;scanStatus',formatter:'.formatter.incomingScan'}"/></VBox></cells></ColumnListItem></items></Table>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
