<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.GoodsIssue" height="100%" displayBlock="true"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{= ${view&gt;/document/movementType} === 'ISSUE_REVERSAL' ? 'Auslieferungsrücknahme' : 'Auslieferung zum Serviceauftrag' }" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="{view&gt;/document/deliveryNumber}"/><ObjectStatus text="{= ${view&gt;/document/reversalId} ? 'Zurückgenommen' : 'Gebucht' }" state="{= ${view&gt;/document/reversalId} ? 'Warning' : 'Success' }"/></uxap:expandedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Auslieferung zurücknehmen" press=".onReverse" visible="{view&gt;/canReverse}"/><Button text="Zum Serviceauftrag" press=".onOrder"/><Button text="Zum Ticket" press=".onTicket" visible="{state&gt;/access/service}"/><Button text="Lagerarbeitsplatz" press=".onInventory"/><Button icon="sap-icon://refresh" tooltip="Auslieferung aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Serviceauftrag"/><Link text="{view&gt;/document/orderNumber}" press=".onOrder"/><Label text="Ticket / Aufgabe" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/ticketNumber}"/><Text text="{view&gt;/document/taskNumber}"/><Label text="Verantwortlicher Techniker" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/workerName}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/document/postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><Label text="Belegdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/documentDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><Label text="Auslieferungstext" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/description}" wrapping="true"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Materialkosten"/><ObjectNumber number="{parts:[{path:'view&gt;/document/total'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/><Label text="Finanzbeleg" class="sapUiSmallMarginTop"/><Link text="{view&gt;/document/journal/number}" press=".onJournal" visible="{= !!${view&gt;/document/journal} &amp;&amp; ${state&gt;/access/financeRead} }"/><Text text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; !${state&gt;/access/financeRead} }"/><Text text="Wertfreie Materialbewegung" visible="{= !${view&gt;/document/journal} }"/><Label text="Ticket-Korrelations-ID" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/correlationId}"/></VBox><VBox visible="{= !!${view&gt;/document/reason} }"><Label text="Rücknahmegrund"/><Text text="{view&gt;/document/reason}" wrapping="true"/></VBox></HBox></uxap:headerContent><uxap:sections>
<uxap:ObjectPageSection title="Materialpositionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/document/lines}"><columns><Column><Text text="Artikel / Auftragsposition"/></Column><Column hAlign="End"><Text text="Istmenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort / Fach"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Wert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kontierung"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><Text text="{= 'Auftragsposition ' + ${view&gt;orderPosition} }"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><Text text="{= ${view&gt;binCode} || 'Historisch ohne Fachzuordnung' }"/></VBox><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/><ObjectIdentifier title="{view&gt;costCenter}" text="{view&gt;costObject}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
<uxap:ObjectPageSection title="Beleginformationen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><form:SimpleForm editable="false" layout="ResponsiveGridLayout"><Label text="Materialbeleg"/><Text text="{view&gt;/document/number}"/><Label text="Lieferschein"/><Text text="{view&gt;/document/deliveryNumber}"/><Label text="Serviceauftrag"/><Link text="{view&gt;/document/orderNumber}" press=".onOrder"/><Label text="Ticket"/><Text text="{view&gt;/document/ticketNumber}"/><Label text="Work Order Task"/><Text text="{view&gt;/document/taskNumber}"/><Label text="Ticket-Korrelations-ID"/><Text text="{view&gt;/document/correlationId}"/><Label text="Techniker"/><Text text="{view&gt;/document/workerName}"/><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/document/postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><Label text="Finanzbeleg"/><Text text="{view&gt;/document/journal/number}"/></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
<uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
</uxap:sections></uxap:ObjectPageLayout></mvc:View>
