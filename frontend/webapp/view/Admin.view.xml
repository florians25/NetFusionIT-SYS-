<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="netfusion.erp.controller.Admin"><Page showHeader="false" class="sapUiResponsiveContentPadding"><VBox>
  <Breadcrumbs currentLocationText="Administration"><Link text="Mein Arbeitsplatz" press=".onHome"/></Breadcrumbs>
  <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop sapUiMediumMarginBottom"><VBox><Text text="SYSTEMVERWALTUNG" /><Title text="Benutzer &amp; Organisation" titleStyle="H2"/><Text text="Zugänge verwalten. Verantwortung klar zuordnen." class="sapUiTinyMarginTop"/></VBox><Button text="Benutzer anlegen" icon="sap-icon://add" type="Emphasized" press=".onCreate"/></HBox>
  <Title text="Benutzer" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
  <Table items="{view&gt;/users}" ><columns><Column><Text text="Benutzer"/></Column><Column><Text text="Rolle"/></Column><Column><Text text="Zugang"/></Column><Column width="4rem" hAlign="End"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;email}"/><Text text="{path:'view&gt;role',formatter:'.formatter.role'}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Deaktiviert' }" state="{= ${view&gt;active} ? 'Success' : 'Error' }"/><Button icon="sap-icon://edit" tooltip="Rolle und Zugang bearbeiten" press=".onEdit"/></cells></ColumnListItem></items></Table>
  <Title text="Organisationsstruktur" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
  <List items="{view&gt;/organizations}" ><StandardListItem title="{view&gt;name}" description="{view&gt;kind}" icon="sap-icon://org-chart"/></List>
  <MessageStrip text="Rollen werden bei jeder Anfrage serverseitig geprüft. Der letzte aktive Administrator bleibt geschützt. Organisationspflege, MFA und mehrstufige Genehmigungen folgen im Ausbau." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
</VBox></Page></mvc:View>
