<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.Admin"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Benutzer, Organisation &amp; Nummernkreise"/></f:heading><f:actions><Button text="Benutzer anlegen" icon="sap-icon://add" type="Emphasized" press=".onCreate"/><Button icon="sap-icon://refresh" tooltip="Administration aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Aktive Benutzer"/><ObjectNumber number="{view&gt;/summary/activeUsers}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Aktive Administratoren"/><ObjectNumber number="{view&gt;/summary/administrators}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Organisationseinheiten"/><ObjectNumber number="{view&gt;/summary/organizations}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Nummernkreise"/><ObjectNumber number="{view&gt;/summary/series}"/></VBox><VBox><Label text="Gesperrte Nummernkreise"/><ObjectNumber number="{view&gt;/summary/lockedSeries}"/></VBox></HBox></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiResponsiveContentPadding"><IconTabBar expandable="false"><items><IconTabFilter text="Benutzer" icon="sap-icon://employee">
  <Table items="{view&gt;/users}" ><columns><Column><Text text="Benutzer"/></Column><Column><Text text="Rolle"/></Column><Column><Text text="Zugang"/></Column><Column width="4rem" hAlign="End"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;email}"/><VBox><Text text="{path:'view&gt;role',formatter:'.formatter.role'}"/><Text text="{view&gt;employeeNumber}"/></VBox><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Deaktiviert' }" state="{= ${view&gt;active} ? 'Success' : 'Error' }"/><Button icon="sap-icon://edit" tooltip="Rolle und Zugang bearbeiten" press=".onEdit"/></cells></ColumnListItem></items></Table>
</IconTabFilter><IconTabFilter text="Organisation" icon="sap-icon://org-chart">
  <List items="{view&gt;/organizations}" ><StandardListItem title="{view&gt;name}" description="{view&gt;kind}" icon="sap-icon://org-chart"/></List>
</IconTabFilter><IconTabFilter text="Nummernkreise" icon="sap-icon://number-sign"><Table items="{view&gt;/numberSeries}" growing="true" growingThreshold="70"><headerToolbar><OverflowToolbar><Title text="Geschäftliche Nummernkreise"/><ToolbarSpacer/><ObjectStatus text="Ohne Jahresrücksetzung" state="Information"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Kürzel / Bereich"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Fester Nummernbereich"/></Column><Column hAlign="End"><Text text="Zählerstand / Nächste"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Belegt / Verfügbar"/></Column><Column><Text text="Status"/></Column><Column><Text text="Verwaltung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;prefix}" text="{view&gt;name}"/><Text text="{= ${view&gt;rangeStart} + ' – ' + ${view&gt;rangeEnd} }"/><VBox><Text text="{= ${view&gt;currentValue} === null ? 'Noch keine Vergabe' : ${view&gt;prefix} + '-' + ${view&gt;currentValue} }"/><ObjectNumber number="{view&gt;nextValue}"/></VBox><VBox><Text text="{view&gt;allocated}"/><ObjectNumber number="{view&gt;remaining}"/></VBox><ObjectStatus text="{= !${view&gt;active} ? 'Gesperrt' : ${view&gt;remaining} === 0 ? 'Ausgeschöpft' : 'Aktiv' }" state="{= !${view&gt;active} || ${view&gt;remaining} === 0 ? 'Warning' : 'Success' }"/><Button text="Verwalten" icon="sap-icon://action-settings" press=".onNumberSeries"/></cells></ColumnListItem></items></Table><MessageStrip text="Neue Nummern folgen dem Format RE-45000001. Die angegebenen Bereichsgrenzen sind eingeschlossen; bestehende Belegnummern bleiben erhalten. Erhöhen des nächsten Werts überspringt Nummern dauerhaft und benötigt eine Begründung." type="Information" showIcon="true"/></IconTabFilter></items></IconTabBar>
  <MessageStrip text="Rollen werden bei jeder Anfrage serverseitig geprüft. Der letzte aktive Administrator bleibt geschützt. Mehrstufige Genehmigungen werden im Freigabearbeitsplatz konfiguriert. MFA und weitere Organisationspflege folgen im Ausbau." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
</VBox></f:content></f:DynamicPage></mvc:View>
