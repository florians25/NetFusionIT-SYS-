<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.Invoice" height="100%">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><ObjectIdentifier title="{view&gt;/invoice/snapshot/number}" text="Gebuchte Ausgangsrechnung"/></uxap:heading><uxap:actions><Button text="Rechnungs-PDF" icon="sap-icon://pdf-attachment" press=".onPdf" enabled="{= ${view&gt;/invoice/outputStatus} === 'READY' }"/><Button text="E-Rechnungs-XML" press=".onXml" enabled="{= ${view&gt;/invoice/outputStatus} === 'READY' }"/><Button text="Ausgabe erneut verarbeiten" press=".onOutput" visible="{= ${state&gt;/access/billingWrite} &amp;&amp; ${view&gt;/invoice/outputStatus} !== 'READY' }"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="FI-Beleg" press=".onJournal" visible="{state&gt;/access/financeRead}"/><Button text="Fakturavorrat" press=".onBilling" visible="{state&gt;/access/billingInternal}"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
 <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Rechnungsempfänger"/><Title text="{view&gt;/invoice/snapshot/buyer/name}"/><Text text="{view&gt;/invoice/snapshot/orderNumber}"/><Text text="{path:'view&gt;/invoice/snapshot/ticketNumbers',formatter:'.formatter.ticketNumbers'}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Rechnungsbetrag"/><ObjectNumber number="{path:'view&gt;/invoice/snapshot/gross',formatter:'.formatter.decimal'}" unit="{view&gt;/invoice/snapshot/currency}" emphasized="true"/><Text text="{= 'Netto ' + ${view&gt;/invoice/snapshot/net} + ' · USt. ' + ${view&gt;/invoice/snapshot/tax} }"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Rechnungsdatum / fällig"/><Text text="{path:'view&gt;/invoice/snapshot/date',formatter:'.formatter.dateOnly'}"/><Text text="{path:'view&gt;/invoice/snapshot/dueDate',formatter:'.formatter.dateOnly'}"/></VBox><VBox><Label text="PDF-/XML-Ausgabe"/><ObjectStatus text="{path:'view&gt;/invoice/outputStatus',formatter:'.formatter.invoiceOutputStatus'}" state="{= ${view&gt;/invoice/outputStatus} === 'READY' ? 'Success' : 'Warning' }"/><Text text="{= 'Offener Betrag: ' + ${view&gt;/invoice/openAmount} + ' ' + ${view&gt;/invoice/snapshot/currency} }"/></VBox></HBox></uxap:headerContent>
 <uxap:sections>
  <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/invoice/snapshot/items}"><columns><Column><Text text="Position / Leistung"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Menge"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Preis netto"/></Column><Column hAlign="End"><Text text="Nettowert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Leistungszeitraum / Steuer"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;sku} }"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.decimal'}" unit="{view&gt;/invoice/snapshot/currency}"/><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.decimal'}" unit="{view&gt;/invoice/snapshot/currency}"/><VBox><Text text="{parts:[{path:'view&gt;serviceFrom'},{path:'view&gt;serviceTo'}],formatter:'.formatter.servicePeriod'}"/><Text text="{= ${view&gt;taxRate} + ' % USt.' }"/></VBox></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  <uxap:ObjectPageSection title="Partner &amp; Zahlung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><form:SimpleForm layout="ResponsiveGridLayout" columnsL="2"><Title text="Rechnungsempfänger"/><Label text="Kunde"/><Text text="{view&gt;/invoice/snapshot/buyer/name}"/><Label text="Anschrift"/><Text text="{= ${view&gt;/invoice/snapshot/buyer/street} + ', ' + ${view&gt;/invoice/snapshot/buyer/postalCode} + ' ' + ${view&gt;/invoice/snapshot/buyer/city} }"/><Label text="Kundenreferenz"/><Text text="{view&gt;/invoice/snapshot/buyerReference}"/><Title text="Aussteller / Zahlung"/><Label text="Firma"/><Text text="{view&gt;/invoice/snapshot/seller/name}"/><Label text="USt-IdNr."/><Text text="{view&gt;/invoice/snapshot/seller/vatId}"/><Label text="IBAN"/><Text text="{view&gt;/invoice/snapshot/seller/iban}"/><Label text="BIC"/><Text text="{view&gt;/invoice/snapshot/seller/bic}"/><Label text="Fällig am"/><Text text="{path:'view&gt;/invoice/snapshot/dueDate',formatter:'.formatter.dateOnly'}"/><Label text="FI-Beleg" visible="{state&gt;/access/financeRead}"/><Text text="{view&gt;/invoice/journalNumber}" visible="{state&gt;/access/financeRead}"/></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  <uxap:ObjectPageSection title="Steuern &amp; Ausgabestatus"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><Table items="{view&gt;/invoice/snapshot/taxes}"><columns><Column><Text text="Umsatzsteuer"/></Column><Column hAlign="End"><Text text="Bemessungsgrundlage"/></Column><Column hAlign="End"><Text text="Steuerbetrag"/></Column></columns><items><ColumnListItem><cells><Text text="{= ${view&gt;rate} + ' %' }"/><ObjectNumber number="{path:'view&gt;basis',formatter:'.formatter.decimal'}" unit="{view&gt;/invoice/snapshot/currency}"/><ObjectNumber number="{path:'view&gt;amount',formatter:'.formatter.decimal'}" unit="{view&gt;/invoice/snapshot/currency}"/></cells></ColumnListItem></items></Table><MessageStrip text="{view&gt;/invoice/outputError}" visible="{= !!${view&gt;/invoice/outputError} }" type="Warning" showIcon="true"/><Text text="{= 'Verarbeitungsversuche: ' + ${view&gt;/invoice/attempts} }" class="sapUiSmallMarginTop"/></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 </uxap:sections></uxap:ObjectPageLayout>
</mvc:View>
