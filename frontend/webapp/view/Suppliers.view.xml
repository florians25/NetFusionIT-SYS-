<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.Suppliers" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Lieferanten"/></f:heading><f:actions><Button text="Lieferant anlegen" type="Emphasized" press=".onNew" visible="{state&gt;/access/partnerWrite}"/><Button icon="sap-icon://refresh" tooltip="Lieferanten aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:content><Table items="{view&gt;/suppliers}" noDataText="Noch keine Lieferanten angelegt"><columns><Column><Text text="Lieferant"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Adresse"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zahlungsziel"/></Column><Column><Text text="Freigabe"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;name}" press=".onPartner" visible="{state&gt;/access/partners}"/><Text text="{view&gt;name}" visible="{= !${state&gt;/access/partners} }"/><Text text="{view&gt;number}"/></VBox><VBox><Text text="{view&gt;street}"/><Text text="{= ${view&gt;postalCode} + ' ' + ${view&gt;city} }"/><Text text="{view&gt;country}"/></VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{= ${view&gt;paymentTermsDays} + ' Tage' }"/><Button text="Einreichen" press=".onSubmit" visible="{= ${state&gt;/access/partnerWrite} &amp;&amp; ['DRAFT','REJECTED'].indexOf(${view&gt;status}) &gt;= 0 }"/></cells></ColumnListItem></items></Table></f:content></f:DynamicPage></mvc:View>
