<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Suppliers" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Lieferanten"/></f:heading><f:actions><Button text="Lieferant anlegen" type="Emphasized" press=".onNew" visible="{state&gt;/access/partnerWrite}"/><Button icon="sap-icon://refresh" tooltip="Lieferanten aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Lieferanten"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Freigegeben"/><ObjectNumber number="{view&gt;/summary/active}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Entwurf / Korrektur"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="In Prüfung"/><ObjectNumber number="{view&gt;/summary/inReview}"/></VBox></HBox><OverflowToolbar><SearchField placeholder="Nummer, Bezeichnung oder Geschäftspartner" width="22rem" liveChange=".onWorklistFilter" search=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="suppliersTable"/><core:CustomData key="fields" value="name,number,email,city"/></customData></SearchField><ToolbarSpacer/><Label text="Status"/><Select change=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="suppliersTable"/><core:CustomData key="filterField" value="status"/></customData><items><core:Item key="" text="Alle Status"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="IN_REVIEW" text="In Prüfung"/><core:Item key="ACTIVE" text="Aktiv"/><core:Item key="REJECTED" text="Abgelehnt"/></items></Select></OverflowToolbar></f:DynamicPageHeader></f:header><f:content><Table id="suppliersTable" items="{vi