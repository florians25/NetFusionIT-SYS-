<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Catalog" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Artikel &amp; Servicekatalog"/></f:heading></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Artikel"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Aktiv"/><ObjectNumber number="{view&gt;/summary/active}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Entwurf / Korrektur"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="In Prüfung"/><ObjectNumber number="{view&gt;/summary/inReview}"/></VBox></HBox></f:DynamicPageHeader></f:header><f:content><VBox><IconTabBar expandable="false"><items><IconTabFilter text="Artikel" icon="sap-icon://product"><OverflowToolbar><SearchField placeholder="Nummer, Bezeichnung oder Geschäftspartner" width="22rem" liveChange=".onWorklistFilter" search=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="products"/><core:CustomData key="fields" value="sku,name,number"/></customData></SearchField><ToolbarSpacer/><Label text="Status"/><Select change=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="products"/><core:CustomData key="filterField" value="status"/></customData><items><core:Item key="" text="Alle Status"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="IN_REVIEW" text="In Prüfung"/><core:Item key="ACTIVE" text="Aktiv"/><core:Item key="REJECTED" text="Abgelehnt"/></items></Select></OverflowToolbar>
 <Table id="products" items="{view&gt;/products}" noDataText="Noch keine Artikel angelegt"><headerToolbar><OverflowToolbar><Title text="Artikelstamm"/><ToolbarSpacer/><Button text="Artikel anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewProduct" visible="{state&gt;/access/materialWrite}"/><Button icon="sap-icon://refresh" tooltip="Artikel aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Artikel"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Art / Einheit"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Steuerkennzeichen"/></Column><Column><Text text="Status"/></Column><Column visible="{state&gt;/access/materialWrite}"><Text text="Freigabe"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;name}" text="{view&gt;number}"/><Text text="{view&gt;sku}"/><Text text="{view&gt;productGroup}"/></VBox><VBox><Text text="{path:'view&gt;kind',formatter:'.formatter.productKind'}"/><Text text="{view&gt;unit}"/></VBox><Text text="{view&gt;taxCode}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Button text="Einreichen" press=".onSubmit" visible="{= ${state&gt;/access/materialWrite} &amp;&amp; (${view&gt;status} === 'DRAFT' || ${view&gt;status} === 'REJECTED') }"/></cells></ColumnListItem></items></Table>
 </IconTabFilter><IconTabFilter text="Währungen" icon="sap-icon://currency"><Table items="{view&gt;/currencies}" class="sapUiMediumMarginTop"><headerToolbar><OverflowToolbar><Title text="Konfigurierte Währungen"/><ToolbarSpacer/><Button text="Währung konfigurieren" press=".onCurrency" visible="{state&gt;/access/admin}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Code"/></Column><Column><Text text="Nachkommastellen"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><Text text="{view&gt;digits}"/></cells></ColumnListItem></items></Table>
 </IconTabFilter></items></IconTabBar></VBox></f:content></f:DynamicPage></mvc:View>
