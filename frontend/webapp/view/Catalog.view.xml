<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="netfusion.erp.controller.Catalog"><Page title="Artikel &amp; Servicekatalog" showNavButton="true" navButtonPress=".onHome" class="sapUiResponsiveContentPadding"><content><VBox>
 <Table id="products" items="{view&gt;/products}" noDataText="Noch keine Artikel angelegt"><headerToolbar><OverflowToolbar><Title text="Artikelstamm"/><ToolbarSpacer/><SearchField width="20rem" placeholder="Artikelnummer oder Bezeichnung" liveChange=".onSearch"/><Button text="Artikel anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewProduct" visible="{state&gt;/access/materialWrite}"/><Button icon="sap-icon://refresh" tooltip="Artikel aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Artikel"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Art / Einheit"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Steuerkennzeichen"/></Column><Column><Text text="Status"/></Column><Column visible="{state&gt;/access/materialWrite}"><Text text="Freigabe"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><VBox><Text text="{path:'view&gt;kind',formatter:'.formatter.productKind'}"/><Text text="{view&gt;unit}"/></VBox><Text text="{view&gt;taxCode}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Button text="Einreichen" press=".onSubmit" visible="{= ${state&gt;/access/materialWrite} &amp;&amp; (${view&gt;status} === 'DRAFT' || ${view&gt;status} === 'REJECTED') }"/></cells></ColumnListItem></items></Table>
 <Table items="{view&gt;/currencies}" class="sapUiMediumMarginTop"><headerToolbar><OverflowToolbar><Title text="Konfigurierte Währungen"/><ToolbarSpacer/><Button text="Währung konfigurieren" press=".onCurrency" visible="{state&gt;/access/admin}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Code"/></Column><Column><Text text="Nachkommastellen"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><Text text="{view&gt;digits}"/></cells></ColumnListItem></items></Table>
 </VBox></content></Page></mvc:View>
