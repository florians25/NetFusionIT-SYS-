<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.DocumentSettings" height="100%">
 <f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Dokumenteinstellungen"/></f:heading><f:actions><Button icon="sap-icon://refresh" tooltip="Dokumenteinstellungen aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
 <f:content><VBox class="sapUiSmallMargin"><MessageStrip text="Neue Geschäftsunterlagen benötigen einen aktiven Vertriebsmitarbeiter mit Vorname und Nachname. Der vollständige Vertriebsmitarbeiter steht im reduzierten Belegkopf rechts oben. Bereits archivierte Dokumente behalten ihren gespeicherten Stand." showIcon="true" class="sapUiSmallMarginBottom"/>
 <Table items="{view&gt;/companies}" noDataText="Zuerst einen berechtigten Buchungskreis anlegen." id="presentationTable1"><headerToolbar><OverflowToolbar><Title text="Vertriebsmitarbeiter je Buchungskreis" level="H2"/></OverflowToolbar></headerToolbar><columns>
 <Column width="19rem"><Text text="Buchungskreis"/></Column><Column><Text text="Vorname und Nachname"/></Column><Column demandPopin="true" minScreenWidth="Tablet"><Text text="E-Mail / Telefon"/></Column><Column demandPopin="true" minScreenWidth="Tablet"><Text text="Verwendung / Revision"/></Column><Column demandPopin="true" minScreenWidth="Tablet"><Text text="Pflege"/></Column>
 </columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;code}" text="{view&gt;name}"/><Text text="{= ${view&gt;firstName} ? ${view&gt;firstName} + ' ' + ${view&gt;lastName} : 'Noch nicht hinterlegt' }"/><VBox><Text text="{view&gt;email}"/><Text text="{view&gt;phone}" wrapping="false"/></VBox><VBox><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Nicht verwendbar' }" state="{= ${view&gt;active} ? 'Success' : 'Warning' }"/><Text text="{= 'Revision ' + ${view&gt;version} }"/></VBox><Button text="Bearbeiten" press=".onEdit" visible="{state&gt;/access/documentConfigure}"/></cells></ColumnListItem></items></Table>
 </VBox></f:content></f:DynamicPage>
</mvc:View>
