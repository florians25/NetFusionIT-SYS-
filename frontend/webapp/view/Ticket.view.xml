<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:f="sap.f" displayBlock="true" controllerName="netfusion.erp.controller.Ticket">
  <f:DynamicPage id="ticketDetailPage" fitContent="false"><f:title><f:DynamicPageTitle><f:heading><VBox><ObjectIdentifier title="{view&gt;/ticket/number}"/><Title text="{view&gt;/ticket/title}" level="H2" titleStyle="H3" wrapping="true"/></VBox></f:heading><f:expandedContent><HBox wrap="Wrap"><ObjectStatus text="{path:'view&gt;/ticket/status',formatter:'.formatter.status'}" state="{path:'view&gt;/ticket/status',formatter:'.formatter.statusState'}" class="sapUiSmallMarginEnd"/><ObjectStatus text="{path:'view&gt;/ticket/priority',formatter:'.formatter.priority'}" state="{path:'view&gt;/ticket/priority',formatter:'.formatter.priorityState'}"/></HBox></f:expandedContent><f:actions><Button text="Ticket qualifizieren" icon="sap-icon://edit" press=".onQualify" visible="{view&gt;/intakeDetail/canEdit}"/><Button text="Assets verknüpfen" icon="sap-icon://it-system" press=".onQualify" visible="{view&gt;/intakeDetail/canEdit}"/><Button text="Techniker zuweisen" type="Emphasized" icon="sap-icon://employee" press=".onAssign" visible="{state&gt;/access/assign}"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Servicefall öffnen" icon="sap-icon://folder-blank" press=".onCase"/><Button icon="sap-icon://refresh" tooltip="Ticket neu laden" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kunde / Ansprechpartner"/><ObjectIdentifier title="{view&gt;/ticket/partnerName}" text="{view&gt;/ticket/partnerEmail}"/><Text text="{= (${view&gt;/intakeDetail/contact/firstName} || '') + ' ' + (${view&gt;/intakeDetail/contact/lastName} || '') }"/><Text text="{view&gt;/intakeDetail/contact/phone}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Verantwortung / Servicefall"/><Text text="{view&gt;/ticket/technicianName}"/><Link text="{view&gt;/ticket/caseNumber}" press=".onCase"/><Text text="{path:'view&gt;/ticket/type',formatter:'.formatter.type'}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Eingang / Letzte Änderung"/><Text text="{path:'view&gt;/ticket/createdAt',formatter:'.formatter.date'}" wrapping="false"/><Text text="{path:'view&gt;/ticket/updatedAt',formatter:'.formatter.date'}" wrapping="false"/><Label text="Wiedervorlage"/><Text text="{path:'view&gt;/intakeDetail/intake/followUpOn',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" visible="{state&gt;/access/internal}"><Label text="Aufgaben / Zeitnachweise"/><ObjectNumber number="{view&gt;/workSummary/tasks}" unit="Aufgaben"/><ObjectNumber number="{view&gt;/workSummary/times}" unit="Zeitnachweise"/></VBox><VBox visible="{state&gt;/access/ticketIntake}"><Label text="Betroffene Assets / Verlauf"/><ObjectNumber number="{view&gt;/workSummary/assets}" unit="Assets"/><ObjectNumber number="{view&gt;/workSummary/comments}" unit="Nachrichten"/></VBox></FlexBox></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiContentPadding">
    <IconTabBar id="ticketSections" expandable="false" backgroundDesign="Transparent" class="sapUiMediumMarginTop">
      <items>
        <IconTabFilter text="Allgemeine Informationen" key="general"><VBox class="sapUiContentPadding"><Title text="Anliegen" titleStyle="H3"/><Text text="{view&gt;/ticket/description}" renderWhitespace="true" class="sapUiSmallMarginTop"/><form:SimpleForm editable="false" layout="ResponsiveGridLayout" class="sapUiMediumMarginTop"><Label text="Kontakt"/><Text text="{view&gt;/ticket/partnerEmail}"/><Label text="Quelle"/><Text text="{= ${view&gt;/ticket/source} === 'CUSTOMER_PORTAL' ? 'Kundenportal' : 'Intern erfasst' }"/><Label text="Korrelations-ID"/><Text text="{view&gt;/ticket/correlationId}" class="sapUiTinyMarginBottom"/><Label text="Version"/><Text text="{view&gt;/ticket/version}"/></form:SimpleForm></VBox></IconTabFilter>
        <IconTabFilter text="Qualifikation &amp; Assets" key="intake" visible="{state&gt;/access/ticketIntake}"><VBox class="sapUiContentPadding"><OverflowToolbar><Title text="Interner Ticketkontext"/><ToolbarSpacer/><Button text="Qualifikation bearbeiten" press=".onQualify" visible="{view&gt;/intakeDetail/canEdit}"/></OverflowToolbar><form:SimpleForm layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Klassifikation"/><Label text="Kategorie / Unterkategorie"/><VBox><Text text="{path:'view&gt;/intakeDetail/intake/category',formatter:'.formatter.intakeCategory'}"/><Text text="{view&gt;/intakeDetail/intake/subcategory}"/></VBox><Label text="Auswirkung / Dringlichkeit"/><VBox><Text text="{path:'view&gt;/intakeDetail/intake/impact',formatter:'.formatter.intakeImpact'}"/><Text text="{path:'view&gt;/intakeDetail/intake/urgency',formatter:'.formatter.intakeUrgency'}"/></VBox><Label text="Betroffene Personen"/><Text text="{view&gt;/intakeDetail/intake/affectedUsers}"/><core:Title text="Technische Diagnose"/><Label text="Systemumgebung / Version"/><Text text="{view&gt;/intakeDetail/intake/environment}"/><Label text="Fehlercode"/><Text text="{view&gt;/intakeDetail/intake/errorCode}"/><Label text="Reproduktion"/><Text text="{view&gt;/intakeDetail/intake/reproductionSteps}"/><core:Title text="Betriebliche Bearbeitung"/><Label text="Geschäftliche Auswirkung"/><Text text="{view&gt;/intakeDetail/intake/businessImpact}"/><Label text="Workaround"/><Text text="{view&gt;/intakeDetail/intake/workaround}"/><Label text="Interne Übergabe"/><Text text="{view&gt;/intakeDetail/intake/internalSummary}"/></form:content></form:SimpleForm><Title text="Betroffene Assets" level="H3"/><Table items="{view&gt;/intakeDetail/assets}" noDataText="Noch keine Assets mit diesem Ticket verknüpft" id="presentationTable1"><columns><Column><Text text="Asset"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Hersteller / Modell"/></Column><Column><Text text="Seriennummer / Inventarnummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Standort / Garantie"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;number}"/><Text text="{= ${view&gt;manufacturer} + ' ' + ${view&gt;model} }"/><ObjectIdentifier title="{view&gt;serialNumber}" text="{view&gt;inventoryNumber}"/><VBox><Text text="{view&gt;location}"/><Text text="{path:'view&gt;warrantyUntil',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox></cells></ColumnListItem></items></Table><Panel headerText="Verlauf der Assetzuordnungen" expandable="true" expanded="false"><Table items="{view&gt;/intakeDetail/assetHistory}" id="presentationTable2"><columns><Column><Text text="Asset"/></Column><Column><Text text="Verknüpft durch / am"/></Column><Column><Text text="Gelöst durch / am"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;number}"/><VBox><Text text="{view&gt;addedByName}"/><Text text="{path:'view&gt;addedAt',formatter:'.formatter.date'}"/></VBox><VBox><Text text="{view&gt;removedByName}"/><Text text="{path:'view&gt;removedAt',formatter:'.formatter.date'}"/></VBox></cells></ColumnListItem></items></Table></Panel></VBox></IconTabFilter>
        <IconTabFilter text="Bearbeitung" key="work" visible="{state&gt;/access/internal}"><VBox class="sapUiContentPadding"><Title text="Status ändern" titleStyle="H3"/><Text text="Es werden nur aktuell zulässige Statusübergänge angeboten." class="sapUiSmallMarginTop sapUiSmallMarginBottom"/><HBox wrap="Wrap"><Select selectedKey="{view&gt;/nextStatus}" items="{view&gt;/transitions}" width="280px" enabled="{= ${view&gt;/transitions}.length &gt; 0 }"><core:Item key="{view&gt;key}" text="{view&gt;text}"/></Select><Button text="Status übernehmen" type="Emphasized" press=".onStatus" enabled="{= ${view&gt;/transitions}.length &gt; 0 }" class="sapUiSmallMarginBegin"/></HBox><MessageStrip text="Kaufmännischer Status ist hier ausschließlich ein Bearbeitungsstatus. Es wird keine Rechnung oder Finanzbuchung erzeugt." type="Information" showIcon="true" class="sapUiMediumMarginTop"/></VBox></IconTabFilter>
        <core:Fragment fragmentName="netfusion.erp.view.fragment.TicketWork" type="XML"/>
        <IconTabFilter text="Kommunikation" key="comments"><VBox class="sapUiContentPadding"><TextArea value="{view&gt;/commentBody}" rows="4" width="100%" maxLength="10000" placeholder="Kommentar zum Ticket verfassen"/><OverflowToolbar><Select selectedKey="{view&gt;/commentVisibility}" visible="{state&gt;/access/internal}"><core:Item key="PUBLIC" text="Kundenkommentar"/><core:Item key="INTERNAL" text="Interne Notiz"/></Select><ToolbarSpacer/><Button text="Kommentar senden" type="Emphasized" press=".onComment"/></OverflowToolbar><List items="{view&gt;/comments}" noDataText="Noch keine Kommentare"><FeedListItem sender="{view&gt;authorName}" text="{view&gt;body}" info="{= ${view&gt;visibility} === 'INTERNAL' ? 'Intern' : 'Kundenkommentar' }" timestamp="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/></List></VBox></IconTabFilter>
        <IconTabFilter text="Service Level" key="sla"><VBox class="sapUiContentPadding">
          <MessageStrip text="Diesem Ticket ist keine vertragliche SLA-Policy zugeordnet." visible="{= !${view&gt;/slaDetail/sla} }" type="Information" showIcon="true"/>
          <form:SimpleForm editable="false" layout="ResponsiveGridLayout" visible="{= !!${view&gt;/slaDetail/sla} }">
            <Label text="Vereinbarung"/><Text text="{view&gt;/slaDetail/sla/snapshot/policyName}"/>
            <Label text="Reaktionsfrist"/><Text text="{path:'view&gt;/slaDetail/sla/responseDue',formatter:'.formatter.date'}"/>
            <Label text="Lösungsfrist"/><Text text="{path:'view&gt;/slaDetail/sla/resolutionDue',formatter:'.formatter.date'}"/>
            <Label text="Erste Reaktion"/><Text text="{path:'view&gt;/slaDetail/sla/respondedAt',formatter:'.formatter.date'}"/>
            <Label text="Technisch gelöst"/><Text text="{path:'view&gt;/slaDetail/sla/resolvedAt',formatter:'.formatter.date'}"/>
            <Label text="Pausiert seit"/><Text text="{path:'view&gt;/slaDetail/sla/pausedAt',formatter:'.formatter.date'}"/>
            <Label text="Kalenderzeitzone"/><Text text="{view&gt;/slaDetail/sla/snapshot/timeZone}"/>
          </form:SimpleForm><List items="{view&gt;/slaDetail/events}" noDataText="Keine SLA-Ereignisse"><StandardListItem title="{view&gt;kind}" description="{path:'view&gt;createdAt',formatter:'.formatter.date'}" info="{view&gt;deadlineType}"/></List>
        </VBox></IconTabFilter>
        <IconTabFilter text="Historie" key="history"><List items="{view&gt;/ticket/events}" noDataText="Keine Ereignisse"><ObjectListItem title="{path:'view&gt;action',formatter:'.formatter.event'}" intro="{view&gt;actorName}" number="{path:'view&gt;createdAt',formatter:'.formatter.date'}"><attributes><ObjectAttribute text="{path:'view&gt;details',formatter:'.formatter.eventDetail'}"/></attributes></ObjectListItem></List></IconTabFilter>
      </items>
    </IconTabBar>
  </VBox></f:content></f:DynamicPage>
</mvc:View>
