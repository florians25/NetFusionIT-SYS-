<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.Report" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" enableLazyLoading="false">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/report/title}" titleStyle="H2" wrapping="true"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/report/number}" text="{= ${view&gt;/report/isFinal} ? 'Endrückmeldung' : 'Teilrückmeldung' }"/><ObjectStatus text="{path:'view&gt;/report/status',formatter:'.formatter.status'}" state="{path:'view&gt;/report/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent><uxap:snappedContent><ObjectStatus text="{path:'view&gt;/report/status',formatter:'.formatter.status'}"/></uxap:snappedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Zum Ticket" press=".onTicket" visible="{state&gt;/access/service}"/><Button text="Zum Serviceauftrag" press=".onOrder"/><Button text="Nachweis einreichen" type="Emphasized" press=".onSubmit" visible="{view&gt;/report/canSubmit}"/><Button text="Entwurf verwerfen" press=".onCancel" visible="{view&gt;/report/canSubmit}"/><Button text="Leistung bestätigen" type="Emphasized" press=".onConfirm" visible="{view&gt;/report/canConfirm}"/><Button icon="sap-icon://refresh" tooltip="Nachweis aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kunde"/><Title text="{view&gt;/report/partnerName}" titleStyle="H4"/><Label text="Serviceorganisation" class="sapUiSmallMarginTop"/><Text text="{view&gt;/report/organizationName}"/><Label text="Ticket / Work Order Task" class="sapUiSmallMarginTop"/><Text text="{view&gt;/report/ticketNumber}"/><Text text="{view&gt;/report/taskNumber}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Serviceauftrag"/><Link text="{view&gt;/report/orderNumber}" press=".onOrder"/><Label text="Korrelations-ID"/><Text text="{view&gt;/report/correlationId}"/><Label text="Verfasser" class="sapUiSmallMarginTop"/><Text text="{view&gt;/report/authorName}"/></VBox><VBox><Label text="Kundenbestätigung"/><ObjectStatus text="{= !${view&gt;/report/confirmationRequired} ? 'Nicht erforderlich · interne Leistung' : ${view&gt;/report/customerConfirmedAt} ? 'Bestätigt' : 'Ausstehend' }" state="{= ${view&gt;/report/customerConfirmedAt} ? 'Success' : 'Warning' }"/><Text text="{view&gt;/report/confirmedByName}"/><Text text="{view&gt;/report/customerComment}" wrapping="true"/></VBox></HBox></uxap:headerContent>
  <uxap:sections>
   <uxap:ObjectPageSection title="Leistungsbericht"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><form:SimpleForm layout="ResponsiveGridLayout" editable="false"><Label text="Diagnose"/><Text text="{view&gt;/report/diagnosis}"/><Label text="Durchgeführte Arbeiten"/><Text text="{view&gt;/report/workDone}"/><Label text="Ergebnis"/><Text text="{view&gt;/report/outcome}"/></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Rückgemeldete Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/report/lines}" noDataText="Keine Leistungen"><columns><Column><Text text="Position"/></Column><Column><Text text="Leistung"/></Column><Column hAlign="End"><Text text="Istmenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true" visible="{state&gt;/access/internal}"><Text text="Quelle / Zeitraum"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;snapshot/position}"/><Text text="{view&gt;snapshot/description}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;snapshot/unit}"/><VBox><Link text="{view&gt;snapshot/issueNumber}" press=".onMaterialSource" visible="{= !!${view&gt;snapshot/issueId} }"/><Text text="{view&gt;snapshot/deliveryNumber}" visible="{= !!${view&gt;snapshot/issueId} }"/><Text text="{view&gt;snapshot/timeEntryNumber}"/><Text text="{path:'view&gt;snapshot/startedAt',formatter:'.formatter.date'}" visible="{= !!${view&gt;snapshot/startedAt} }"/><Text text="{path:'view&gt;snapshot/endedAt',formatter:'.formatter.date'}" visible="{= !!${view&gt;snapshot/endedAt} }"/></VBox></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
