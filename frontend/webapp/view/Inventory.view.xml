<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Inventory" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Lager &amp; Materialbewegungen"/></f:heading><f:actions><Button icon="sap-icon://refresh" tooltip="Lager aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox alignItems="Center" wrap="Wrap"><Label text="Buchungskreis" labelFor="inventoryCompany" class="sapUiTinyMarginEnd"/><Select id="inventoryCompany" selectedKey="{view&gt;/companyId}" items="{view&gt;/companies}" change=".load"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} }"/></Select></HBox></f:DynamicPageHeader></f:header><f:content><VBox><MessageStrip text="Zuerst einen Buchungskreis mit Hauswährung in der Finanzbuchhaltung konfigurieren." type="Information" showIcon="true" visible="{= !${view&gt;/companyId} }"/><IconTabBar expandable="false" visible="{= !!${view&gt;/companyId} }"><items>
 <IconTabFilter key="stock" text="Bestände" icon="sap-icon://inventory"><Table items="{view&gt;/context/balances}" noDataText="Keine positiven Bestände" growing="true" id="presentationTable1"><columns><Column><Text text="Artikel"/></Column><Column><Text text="Werk / Lagerort"/></Column><Column hAlign="End"><Text text="Bestand"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Reserviert"/></Column><Column hAlign="End"><Text text="Verfügbar"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;reservedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;availableQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" state="Success"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter key="valuation" text="Bewertung" icon="sap-icon://money-bills"><Table items="{view&gt;/context/valuations}" noDataText="Noch keine bewerteten Materialbewegungen" id="presentationTable2"><columns><Column><Text text="Artikel"/></Column><Column hAlign="End"><Text text="Gesamtmenge"/></Column><Column hAlign="End"><Text text="Bestandswert"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Durchschnittspreis"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/context/company/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/context/company/currency}"/><ObjectNumber number="{parts:[{path:'view&gt;averageCost'},{path:'view&gt;/context/company/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false,maxFractionDigits:6}}" unit="{view&gt;/context/company/currency}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter key="movements" text="Bewegungen" icon="sap-icon://shipping-status"><Table items="{view&gt;/context/receipts}" noDataText="Noch keine gebuchten Materialbelege" growing="true" id="presentationTable3"><columns><Column><Text text="Materialbeleg"/></Column><Column><Text text="Bewegung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auftrag / Bestellung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Lieferschein / Datum"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onReceipt"/><Text text="{path:'view&gt;movementType',formatter:'.formatter.movementType'}"/><ObjectIdentifier title="{view&gt;orderNumber}" text="{view&gt;purchaseOrderNumber}"/><ObjectIdentifier title="{view&gt;deliveryNote}" text="{path:'view&gt;postingDate',formatter:'.formatter.dateOnly'}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter key="issues" text="Auslieferungen" icon="sap-icon://outbox"><Table items="{view&gt;/context/issues}" noDataText="Noch keine Auslieferungen oder Rücknahmen" id="presentationTable4"><columns><Column><Text text="Materialbeleg / Lieferschein"/></Column><Column><Text text="Bewegung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auftrag / Aufgabe"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onIssue"/><Text text="{view&gt;deliveryNumber}"/></VBox><Text text="{path:'view&gt;movementType',formatter:'.formatter.movementType'}"/><ObjectIdentifier title="{view&gt;orderNumber}" text="{view&gt;taskNumber}"/><Text text="{path:'view&gt;postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter key="locations" text="Werke &amp; Lagerorte" icon="sap-icon://factory"><VBox><Table items="{view&gt;/context/plants}" noDataText="Noch keine Werke" id="presentationTable5"><headerToolbar><OverflowToolbar><Title text="Werke"/><ToolbarSpacer/><Button text="Werk anlegen" press=".onNewPlant" visible="{state&gt;/access/inventoryWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Werk"/></Column><Column><Text text="Bezeichnung"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><Text text="{view&gt;name}"/></cells></ColumnListItem></items></Table><Table items="{view&gt;/context/locations}" noDataText="Noch keine Lagerorte" class="sapUiMediumMarginTop" id="presentationTable6"><headerToolbar><OverflowToolbar><Title text="Lagerorte"/><ToolbarSpacer/><Button text="Lagerort anlegen" press=".onNewLocation" visible="{state&gt;/access/inventoryWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Werk / Lagerort"/></Column><Column><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Lagerart"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;code}"/><Text text="{view&gt;name}"/><Text text="{path:'view&gt;kind',formatter:'.formatter.storageKind'}"/></cells></ColumnListItem></items></Table></VBox></IconTabFilter>
 <IconTabFilter key="settings" text="Lagerführung" icon="sap-icon://product"><Table items="{view&gt;/context/materials}" id="presentationTable7"><columns><Column><Text text="Artikel"/></Column><Column><Text text="Bewertungsverfahren"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Tracking"/></Column><Column visible="{state&gt;/access/materialWrite}"><Text text="Konfiguration"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><Text text="{= ${view&gt;valuationMethod} ? 'Gleitender Durchschnittspreis' : 'Noch nicht konfiguriert' }"/><VBox><Text text="{= ${view&gt;serialRequired} ? 'Seriennummernpflicht' : 'Keine Seriennummernpflicht' }"/><Text text="{= ${view&gt;batchRequired} ? 'Chargenpflicht' : 'Keine Chargenpflicht' }"/></VBox><Button text="Lagerführung konfigurieren" press=".onSettings" enabled="{= !${view&gt;used} }"/></cells></ColumnListItem></items></Table></IconTabFilter>
 </items></IconTabBar></VBox></f:content></f:DynamicPage></mvc:View>
