<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.Case"><Page showHeader="false" class="sapUiResponsiveContentPadding"><VBox>
  <Breadcrumbs currentLocationText="{view&gt;/serviceCase/number}"><Link text="App-Zentrale" press=".onHome"/><Link text="Servicefälle" press=".onCases"/></Breadcrumbs>
  <VBox class="sapUiContentPadding"><Text text="{view&gt;/serviceCase/number}" /><Title text="{view&gt;/serviceCase/title}" titleStyle="H2" wrapping="true"/><ObjectStatus text="{path:'view&gt;/serviceCase/status',formatter:'.formatter.status'}" state="Information" class="sapUiSmallMarginTop"/><form:SimpleForm editable="false" layout="ResponsiveGridLayout"><Label text="Kunde"/><Text text="{view&gt;/serviceCase/partnerName}"/><Label text="Technischer Status"/><Text text="{= ${view&gt;/serviceCase/technicalStatus} === 'UNRESOLVED' ? 'Noch nicht bewertet' : ${view&gt;/serviceCase/technicalStatus} }"/><Label text="Kaufmännischer Status"/><Text text="{= ${view&gt;/serviceCase/commercialStatus} === 'NOT_ASSESSED' ? 'Noch nicht bewertet' : ${view&gt;/serviceCase/commercialStatus} }"/></form:SimpleForm></VBox>
  <Title text="Verknüpfte Tickets" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
  <Table items="{view&gt;/serviceCase/tickets}" itemPress=".onTicketPress" ><columns><Column><Text text="Ticket / Betreff"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Techniker"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{view&gt;technicianName}"/></cells></ColumnListItem></items></Table>
  <MessageStrip text="Der Servicefall ist ein eigenständiger Beleg. Einsätze, Aufträge, Materialien und Faktura werden in späteren Ausbaustufen ergänzt." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
</VBox></Page></mvc:View>
