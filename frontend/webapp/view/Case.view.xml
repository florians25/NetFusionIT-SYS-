<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" controllerName="netfusion.erp.controller.Case" height="100%" displayBlock="true"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/serviceCase/title}" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/serviceCase/number}" text="{view&gt;/serviceCase/partnerName}"/><ObjectStatus text="{path:'view&gt;/serviceCase/status',formatter:'.formatter.status'}" state="Information"/></uxap:expandedContent><uxap:actions><Button text="Servicefälle" press=".onCases"/><Button icon="sap-icon://refresh" tooltip="Servicefall aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Kunde"/><Title text="{view&gt;/serviceCase/partnerName}" titleStyle="H4"/><Label text="Technischer Status" class="sapUiSmallMarginTop"/><Text text="{= ${view&gt;/serviceCase/technicalStatus} === 'UNRESOLVED' ? 'Noch nicht bewertet' : ${view&gt;/serviceCase/technicalStatus} }"/><Label text="Kaufmännischer Status" class="sapUiSmallMarginTop"/><Text text="{= ${view&gt;/serviceCase/commercialStatus} === 'NOT_ASSESSED' ? 'Noch nicht bewertet' : ${view&gt;/serviceCase/commercialStatus} }"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Tickets im Fall"/><ObjectNumber number="{view&gt;/summary/tickets}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Serviceaufträge"/><ObjectNumber number="{view&gt;/summary/orders}"/></VBox><VBox><Label text="Belegbeziehungen"/><ObjectNumber number="{view&gt;/summary/relations}"/></VBox></HBox></uxap:headerContent><uxap:sections>
<uxap:ObjectPageSection title="Tickets"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/serviceCase/tickets}" itemPress=".onTicketPress"><headerToolbar><OverflowToolbar><Title text="Verknüpfte Tickets"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Ticket / Betreff"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Techniker"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{view&gt;technicianName}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
<uxap:ObjectPageSection title="Serviceaufträge"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/orders}" itemPress=".onOrder" noDataText="Noch kein Serviceauftrag zu diesem Fall"><columns><Column><Text text="Serviceauftrag"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Versorgung"/></Column><Column hAlign="End"><Text text="Netto"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><ObjectStatus text="{path:'view&gt;materialStatus',formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;materialStatus',formatter:'.formatter.supplyState'}"/><ObjectNumber number="{parts:[{path:'view&gt;totals/net'},{path:'view&gt;currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;currency}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
<uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
</uxap:sections></uxap:ObjectPageLayout></mvc:View>
