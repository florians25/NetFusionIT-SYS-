<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.ServiceLibrary" height="100%"><f:DynamicPage><f:title><f:DynamicPageTitle><f:heading><Title text="{view&gt;/title}"/></f:heading><f:actions><Button icon="sap-icon://refresh" tooltip="Bibliothek aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Vorlagen / Artikel"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Veröffentlicht"/><ObjectNumber number="{view&gt;/summary/active}"/></VBox><VBox><Label text="Entwürfe"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox></HBox><MessageStrip text="Veröffentlichte Revisionen behalten ihren ursprünglichen Inhalt. Neue Revisionen ändern bereits übernommene Ticket- oder Aufgabenstände nicht." showIcon="true" type="Information"/></f:DynamicPageHeader></f:header><f:content><Table id="libraryTable" items="{view&gt;/records}" itemPress=".onOpen" noDataText="Noch keine freigegebenen Bibliotheksstände"><headerToolbar><OverflowToolbar><Title text="Vorlagen und Wissensstände"/><ToolbarSpacer/><Button text="Ticketvorlage anlegen" press=".onNewTicketTemplate" visible="{= ${view&gt;/canWrite} &amp;&amp; !${view&gt;/knowledge} }"/><Button text="Checkliste anlegen" press=".onNewChecklist" visible="{= ${view&gt;/canWrite} &amp;&amp; !${view&gt;/knowledge} }"/><Button text="Wissensartikel anlegen" type="Emphasized" press=".onNewArticle" visible="{= ${view&gt;/canWrite} &amp;&amp; ${view&gt;/knowledge} }"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Bibliotheksstand"/></Column><Column><Text text="Art"/></Column><Column><Text text="Revision / Status"/></Column><Column><Text text="Verantwortung / Erstellt"/></Column><Column><Text text="Verwendung"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{= ${view&gt;title} || ${view&gt;name} }"/><Text text="{path:'view&gt;kind',formatter:'.formatter.libraryKind'}"/><VBox><ObjectNumber number="{view&gt;revision}" unit="Revision"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.libraryStatus'}"/></VBox><VBox><Text text="{view&gt;createdByName}"/><Text text="{path:'view&gt;created_at',formatter:'.formatter.date'}" wrapping="false"/></VBox><VBox visible="{view&gt;/canWrite}"><Button text="{= ${view&gt;status} === 'DRAFT' ? 'Veröffentlichen' : 'Stilllegen' }" press=".onStatus" visible="{= ${view&gt;status} !== 'RETIRED' }"/><Button text="Entwurf bearbeiten" press=".onRevision" visible="{= ${view&gt;status} === 'DRAFT' }"/><Button text="Neue Revision" press=".onRevision" visible="{= ${view&gt;status} !== 'DRAFT' }"/></VBox></cells></ColumnListItem></items></Table></f:content></f:DynamicPage></mvc:View>
