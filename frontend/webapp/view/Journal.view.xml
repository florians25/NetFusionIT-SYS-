<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" controllerName="netfusion.erp.controller.Journal" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" enableLazyLoading="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/journal/description}" titleStyle="H2" wrapping="true"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/journal/number}" text="{view&gt;/journal/reference}"/><ObjectStatus text="{path:'view&gt;/journal/status',formatter:'.formatter.status'}" state="{path:'view&gt;/journal/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent><uxap:snappedContent><ObjectStatus text="{path:'view&gt;/journal/status',formatter:'.formatter.status'}"/></uxap:snappedContent><uxap:actions><Button text="Buchhaltung" press=".onFinance"/><Button text="Zur Prüfung einreichen" press=".onSubmit" visible="{view&gt;/canSubmit}"/><Button text="Journal buchen" type="Emphasized" press=".onPost" visible="{view&gt;/canPost}"/><Button text="Storno anfordern" press=".onReverse" visible="{view&gt;/canReverse}"/><Button icon="sap-icon://refresh" tooltip="Journal aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
 <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Buchungsdatum"/><Text text="{view&gt;/journal/postingDate}"/><Label text="Belegdatum" class="sapUiSmallMarginTop"/><Text text="{view&gt;/journal/documentDate}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Soll gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/journal/totals/debit'},{path:'view&gt;/journal/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/journal/currency}"/></VBox><VBox><Label text="Haben gesamt"/><ObjectNumber number="{parts:[{path:'view&gt;/journal/totals/credit'},{path:'view&gt;/journal/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/journal/currency}"/></VBox></HBox></uxap:headerContent>
 <uxap:sections><uxap:ObjectPageSection title="Buchungspositionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/journal/lines}"><columns><Column><Text text="Konto"/></Column><Column><Text text="Soll / Haben"/></Column><Column hAlign="End"><Text text="Betrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Positionstext"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Kostenstelle"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;code}"/><ObjectStatus text="{= ${view&gt;side} === 'DEBIT' ? 'Soll' : 'Haben' }"/><ObjectNumber number="{parts:[{path:'view&gt;amount'},{path:'view&gt;/journal/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/journal/currency}"/><Text text="{view&gt;description}"/><Text text="{view&gt;costCenter}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
