<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.CustomerSettlement" displayBlock="true"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><ObjectIdentifier title="{view&gt;/number}" text="{path:'view&gt;/kind',formatter:'.formatter.settlementKind'}"/></uxap:heading><uxap:actions><Button text="Unabhängig freigeben" press=".onReview" visible="{view&gt;/canReview}" type="Emphasized"/><Button text="Zahlung buchen" press=".onPost" visible="{view&gt;/canPost}" type="Emphasized"/><Button text="Prüfstand verwerfen" press=".onCancel" visible="{view&gt;/canCancel}"/><Button text="Gegenbuchung vorbereiten" press=".onReverse" visible="{view&gt;/canReverse}"/><Button text="Originalrechnung" press=".onInvoice"/><Button text="Finanzbeleg" press=".onJournal" visible="{= !!${view&gt;/journalId} &amp;&amp; ${state&gt;/access/financeRead} }"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kunde / Originalrechnung"/><ObjectIdentifier title="{view&gt;/partnerName}" text="{view&gt;/invoiceNumber}"/><ObjectStatus text="{path:'view&gt;/status',formatter:'.formatter.status'}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Zahlungsbetrag"/><ObjectNumber number="{path:'view&gt;/amount',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><Label text="Aktueller Rechnungssaldo"/><ObjectNumber number="{path:'view&gt;/balance',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Bankkonto / Referenz"/><ObjectIdentifier title="{view&gt;/bank/code}" text="{view&gt;/bank/name}"/><Text text="{view&gt;/reference}" wrapping="false"/></VBox><VBox><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Belegdatum"/><Text text="{path:'view&gt;/documentDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox></FlexBox></uxap:headerContent><uxap:sections><uxap:ObjectPageSection title="Bankbewegung &amp; Kontierung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Es wird eine tatsächlich erfolgte Bankbewegung dokumentiert. Ungebuchte Prüfstände ändern den OP nicht. Rückzahlungen lösen keine Banküberweisung aus." showIcon="true"/><Table items="{view&gt;/lines}" noDataText="Noch keine Buchung vorhanden"><columns><Column><Text text="Konto"/></Column><Column><Text text="Kontobezeichnung"/></Column><Column><Text text="Soll / Haben"/></Column><Column hAlign="End"><Text text="Betrag"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><Text text="{view&gt;name}"/><Text text="{= ${view&gt;side} === 'DEBIT' ? 'Soll' : 'Haben' }"/><ObjectNumber number="{path:'view&gt;amount',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></cells></ColumnListItem></items></Table><Link text="Ursprünglichen Zahlungsbeleg öffnen" press=".onOriginal" visible="{= !!${view&gt;/originalId} }"/><Link text="Zugehörigen Zahlungsstorno öffnen" press=".onReversal" visible="{= !!${view&gt;/reversalId} }"/></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Unabhängige Finanzprüfung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><form:SimpleForm layout="ResponsiveGridLayout" columnsXL="2" columnsL="2"><form:content><core:Title text="Erfassung und Nachweis"/><Label text="Vorbereitet durch"/><Text text="{view&gt;/preparedByName}"/><Label text="Begründung"/><Text text="{view&gt;/reason}"/><core:Title text="Prüfung des unveränderten Stands"/><Label text="Geprüft durch"/><Text text="{view&gt;/reviewedByName}"/><Label text="Geprüft am"/><Text text="{path:'view&gt;/reviewedAt',formatter:'.formatter.date'}"/><Label text="Prüfvermerk"/><Text text="{view&gt;/reviewNote}"/></form:content></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections></uxap:ObjectPageLayout></mvc:View>
