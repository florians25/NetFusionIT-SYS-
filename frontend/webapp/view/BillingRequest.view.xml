<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.BillingRequest" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false"><f:title><f:DynamicPageTitle><f:heading><ObjectIdentifier title="{view&gt;/request/number}" text="Fakturaanforderung"/></f:heading><f:actions><Button text="Zur Freigabe einreichen" type="Emphasized" press=".onSubmit" visible="{= ${state&gt;/access/billingRelease} &amp;&amp; ['DRAFT','REJECTED'].includes(${view&gt;/request/status}) }"/><Button text="Zurücknehmen" press=".onCancel" visible="{= ${state&gt;/access/billingRelease} &amp;&amp; ['DRAFT','REJECTED','RELEASED'].includes(${view&gt;/request/status}) }"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Genehmigungen" press=".onWorkflow" visible="{state&gt;/access/workflow}"/><Button text="Fakturavorrat" press=".onBilling"/></f:actions></f:DynamicPageTitle></f:title>
 <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Kunde"/><Title text="{view&gt;/request/partnerName}"/><Text text="{view&gt;/request/title}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Freigabestatus"/><ObjectStatus text="{path:'view&gt;/request/status',formatter:'.formatter.status'}" state="{path:'view&gt;/request/status',formatter:'.formatter.statusState'}"/><Text text="{= 'Version ' + ${view&gt;/request/version} }"/></VBox><VBox><Label text="{= ${view&gt;/request/orderKind} === 'SALES_ORDER' ? 'Kundenauftrag' : 'Serviceauftrag' }"/><Link text="{view&gt;/request/orderNumber}" press=".onOrder"/></VBox></HBox></f:DynamicPageHeader></f:header>
 <f:content><VBox><Table items="{view&gt;/request/lines}" noDataText="Keine Positionen"><columns><Column><Text text="Position / Leistung"/></Column><Column hAlign="End"><Text text="Freigegeben / offen"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Preis / Netto"/></Column><Column><Text text="Lieferdatum / Leistungszeitraum"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Lieferschein / SRM / Korrelation"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;snapshot/description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;snapshot/sku} }"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{= 'Offen: ' + ${view&gt;remainingQuantity} }"/></VBox><VBox><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.decimal'}" unit="{view&gt;/request/currency}"/><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.decimal'}" unit="{view&gt;/request/currency}"/></VBox><Text text="{parts:[{path:'view&gt;serviceFrom'},{path:'view&gt;serviceTo'}],formatter:'.formatter.servicePeriod'}"/><VBox><Text text="{view&gt;snapshot/reportNumber}"/><Text text="{view&gt;snapshot/correlationId}"/></VBox></cells></ColumnListItem></items></Table><Panel headerText="Belegfluss" expandable="true" expanded="true" class="sapUiSmallMarginTop"><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></Panel></VBox></f:content></f:DynamicPage>
</mvc:View>
