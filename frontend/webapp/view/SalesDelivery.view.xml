<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" controllerName="netfusion.erp.controller.SalesDelivery" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{= ${view&gt;/document/movementType} === 'ISSUE_REVERSAL' ? 'Warenausgangsstorno zum Kundenauftrag' : 'Warenausgang zum Kundenauftrag' }" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="{view&gt;/document/deliveryNumber}"/><ObjectStatus text="{= ${view&gt;/document/reversalId} ? 'Zurückgenommen' : 'Gebucht' }" state="{= ${view&gt;/document/reversalId} ? 'Warning' : 'Success' }"/></uxap:expandedContent><uxap:actions><Button text="Fakturaanforderung" icon="sap-icon://request" press=".onBillingRequest" visible="{state&gt;/access/billingRelease}"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Auslieferung zurücknehmen" press=".onReverse" visible="{view&gt;/document/reversible}"/><Button text="Zur Vertriebsauslieferung" press=".onOrder"/><Button icon="sap-icon://refresh" tooltip="Warenausgang aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
 <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kundenauftrag"/><Link text="{view&gt;/document/orderNumber}" press=".onOrder"/><Label text="Vereinbarter Warenempfänger" class="sapUiSmallMarginTop"/><ObjectIdentifier title="{view&gt;/document/receiverSnapshot/name}" text="{view&gt;/document/receiverSnapshot/address/street}"/><Text text="{= ${view&gt;/document/receiverSnapshot/address/postalCode} + ' ' + ${view&gt;/document/receiverSnapshot/address/city} }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Tatsächliches Warenausgangsdatum"/><Text text="{path:'view&gt;/document/deliveryDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Buchungsdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Belegdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/documentDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" visible="{view&gt;/internal}"><Label text="Tatsächlicher Bestandswert"/><ObjectNumber number="{parts:[{path:'view&gt;/document/total'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/><Label text="Finanzbeleg" class="sapUiSmallMarginTop"/><Link text="{view&gt;/document/journal/number}" press=".onJournal" visible="{= !!${view&gt;/document/journal} &amp;&amp; ${state&gt;/access/financeRead} }"/><Text text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; !${state&gt;/access/financeRead} }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Auslieferungstext"/><Text text="{view&gt;/document/description}"/><Label text="Rücknahmegrund" class="sapUiSmallMarginTop" visible="{= !!${view&gt;/document/reason} }"/><Text text="{view&gt;/document/reason}"/></VBox></HBox></uxap:headerContent>
 <uxap:sections><uxap:ObjectPageSection title="Warenpositionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table id="salesDeliveryItems" items="{view&gt;/document/lines}"><columns><Column><Text text="Artikel / Auftragsposition"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Tatsächliche Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true" visible="{view&gt;/internal}"><Text text="Werk / Lagerort / Fach"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" visible="{view&gt;/internal}"><Text text="Bestandswert"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><Text text="{= 'AU-Position ' + ${view&gt;orderPosition} + ' · Einteilung ' + ${view&gt;schedulePosition} }"/><Text text="{view&gt;customerMaterial}"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><Text text="{view&gt;binCode}"/></VBox><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Beziehung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
