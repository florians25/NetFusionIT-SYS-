<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.ServiceSetup"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Servicekalender &amp; SLA"/></f:heading></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Servicekalender"/><ObjectNumber number="{= (${view&gt;/calendars} || []).length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="SLA-Policies"/><ObjectNumber number="{= (${view&gt;/policies} || []).length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Organisationen"/><ObjectNumber number="{= (${view&gt;/organizations} || []).length }"/></VBox></HBox></f:DynamicPageHeader></f:header><f:content><VBox>
 <Table items="{view&gt;/calendars}" noDataText="Noch keine Servicekalender"><headerToolbar><OverflowToolbar><Title text="Servicekalender"/><ToolbarSpacer/><Button text="Kalender anlegen" icon="sap-icon://add" type="Emphasized" press=".onCalendar" visible="{state&gt;/access/serviceManage}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Kalender"/></Column><Column><Text text="Zeitzone"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Geschäftszeiten"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Feiertage / Version"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><Text text="{view&gt;timeZone}"/><Text text="{path:'view&gt;weekly',formatter:'.formatter.calendarWindow'}"/><VBox><Text text="{= (${view&gt;holidays} || []).length + ' Feiertage' }"/><Text text="{= 'Version ' + ${view&gt;version} }"/></VBox></cells></ColumnListItem></items></Table>
 <Table items="{view&gt;/policies}" class="sapUiMediumMarginTop" noDataText="Noch keine SLA-Policies"><headerToolbar><OverflowToolbar><Title text="SLA-Policies"/><ToolbarSpacer/><Button text="SLA-Policy anlegen" icon="sap-icon://add" type="Emphasized" press=".onPolicy" visible="{state&gt;/access/serviceManage}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Policy"/></Column><Column><Text text="Kalender"/></Column><Column><Text text="Reaktion (Min.)"/></Column><Column><Text text="Lösung (Min.)"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><Text text="{view&gt;calendarName}"/><Text text="{view&gt;responseMinutes}"/><Text text="{view&gt;resolutionMinutes}"/></cells></ColumnListItem></items></Table>
 <MessageStrip text="Fristen werden aus konfigurierten Geschäftszeiten, Feiertagen und Zeitzonen berechnet. Tickets behalten ihren SLA- und Kalenderstand als Snapshot. Änderungen an der Stammdatenkonfiguration verändern bestehende Fristen nicht rückwirkend." showIcon="true" type="Information" class="sapUiMediumMarginTop"/>
 </VBox></f:content></f:DynamicPage></mvc:View>
