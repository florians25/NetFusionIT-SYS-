<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Orders" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Serviceaufträge"/></f:heading></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Aufträge"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Entwurf / Korrektur"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="In Prüfung"/><ObjectNumber number="{view&gt;/summary/inReview}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Freigegeben / in Arbeit"/><ObjectNumber number="{view&gt;/summary/released}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Materialversorgung offen"/><ObjectNumber number="{view&gt;/summary/shortage}"/></VBox></HBox><OverflowToolbar><SearchField placeholder="Nummer, Bezeichnung oder Geschäftspartner" width="22rem" liveChange=".onWorklistFilter" search=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="ordersTable"/><core:CustomData key="fields" value="number,title,partnerName,caseNumber"/></customData></SearchField><ToolbarSpacer/><Label text="Status"/><Select change=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="ordersTable"/><core:CustomData key="filterField" value="status"/></customData><items><core:Item key="" text="Alle Status"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="IN_REVIEW" text="In Prüfung"/><core:Item key="RELEASED" text="Freigegeben"/><core:Item key="IN_PROGRESS" text="In Bearbeitung"/><core:Item key="TECHNICALLY_COMPLETED" text="Technisch abgeschlossen"/><core:Item key="BILLING_READY" text="Fakturabereit"/><core:Item key="REJECTED" text="Abgelehnt"/></items></Select></OverflowToolbar></f:DynamicPageHeader></f:header><f:content><Table id="ordersTable" items="{view&gt;/orders}" itemPress=".onOrder" noDataText="Noch keine Serviceaufträge"><headerToolbar><OverflowToolbar><Title text="Auftragsbestand"/><ToolbarSpacer/><Button text="Serviceauftrag anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewOrder" visible="{state&gt;/access/orderWrite}"/><Button icon="sap-icon://refresh" tooltip="Aufträge aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Serviceauftrag"/></Column><Column><Text text="Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Art / Preisdatum"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Fall / Organisation"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Netto / Brutto"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Materialversorgung"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Positionen / Erstellt"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><Text text="{view&gt;partnerName}"/><VBox><Text text="{path:'view&gt;kind',formatter:'.formatter.orderKind'}"/><Text text="{path:'view&gt;pricingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/></VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><ObjectIdentifier title="{view&gt;caseNumber}" text="{view&gt;organizationName}"/><VBox><ObjectNumber number="{parts:[{path:'view&gt;totals/net'},{path:'view&gt;currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;currency}"/><ObjectNumber number="{parts:[{path:'view&gt;totals/gross'},{path:'view&gt;currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;currency}" emphasized="false"/></VBox><ObjectStatus text="{path:'view&gt;materialStatus',formatter:'.formatter.supplyStatus'}" state="{path:'view&gt;materialStatus',formatter:'.formatter.supplyState'}"/><VBox><Text text="{= ${view&gt;positionCount} + ' Positionen' }"/><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/></VBox></cells></ColumnListItem></items></Table></f:content></f:DynamicPage></mvc:View>
