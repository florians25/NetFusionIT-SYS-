<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.BillingSource" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false"><f:title><f:DynamicPageTitle><f:heading><Title text="Fakturaanforderung anlegen"/></f:heading><f:actions><Button text="Anforderung anlegen" type="Emphasized" press=".onCreate"/><Button text="Fakturavorrat" press=".onBilling"/></f:actions></f:DynamicPageTitle></f:title>
 <f:header><f:DynamicPageHeader><VBox><ObjectIdentifier title="{view&gt;/order/number}" text="{= 'Buchungskreis ' + ${view&gt;/company/code} + ' · ' + ${view&gt;/company/currency} }"/><Label text="Anforderungsbezeichnung" labelFor="billingTitle"/><Input id="billingTitle" value="{view&gt;/title}" maxLength="160"/><MessageStrip text="Tatsächlich freigegebene Leistungen auswählen. Menge und Leistungszeitraum werden mit der Anforderung unabhängig geprüft und freigegeben." type="Information" showIcon="true" class="sapUiSmallMarginTop"/></VBox></f:DynamicPageHeader></f:header>
 <f:content><Table id="billingSources" items="{view&gt;/sources}" mode="MultiSelect" noDataText="Keine ungebundenen fakturierbaren Leistungsquellen"><columns><Column><Text text="Position / Leistung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="SRM / Korrelation"/></Column><Column hAlign="End"><Text text="Verfügbar / Anfordern"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Preis / Abrechnungsregel"/></Column><Column><Text text="Leistungszeitraum"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;orderPosition} + ' · ' + ${view&gt;sku} }"/><VBox><Text text="{view&gt;reportNumber}"/><Text text="{view&gt;correlationId}" wrapping="true"/></VBox><VBox><ObjectNumber number="{path:'view&gt;remainingQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Input value="{view&gt;quantity}" description="{view&gt;unit}" tooltip="Anforderungsmenge"/></VBox><VBox><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.decimal'}" unit="{view&gt;/company/currency}"/><Text text="{path:'view&gt;sourceKind',formatter:'.formatter.billingRule'}"/></VBox><VBox><DatePicker value="{view&gt;serviceFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" tooltip="Leistungsbeginn"/><DatePicker value="{view&gt;serviceTo}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" tooltip="Leistungsende"/></VBox></cells></ColumnListItem></items></Table></f:content></f:DynamicPage>
</mvc:View>
