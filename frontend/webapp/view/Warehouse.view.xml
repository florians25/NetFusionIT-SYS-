<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:layout="sap.ui.layout" controllerName="netfusion.erp.controller.Warehouse" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Lagerplätze &amp; Einlagerung"/></f:heading><f:expandedContent><ObjectStatus text="Physischer Lagerarbeitsplatz" icon="sap-icon://shelf" state="Information"/></f:expandedContent><f:actions><Button text="Lagerorte &amp; Bewertung" press=".onInventory"/><Button icon="sap-icon://refresh" tooltip="Lagerarbeitsplatz aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><VBox><layout:Grid defaultSpan="XL4 L4 M6 S12" hSpacing="1" vSpacing="1"><VBox><Label text="Buchungskreis" labelFor="warehouseCompany"/><Select id="warehouseCompany" width="100%" selectedKey="{view&gt;/companyId}" items="{view&gt;/companies}" change=".load"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} }"/></Select></VBox><VBox><Label text="Werk / Lagerort" labelFor="warehouseLocation"/><Select id="warehouseLocation" width="100%" selectedKey="{view&gt;/locationId}" items="{view&gt;/locations}" change=".onFilter"><core:Item key="{view&gt;id}" text="{view&gt;label}"/></Select></VBox><VBox><Label text="Suche" labelFor="warehouseQuery"/><SearchField id="warehouseQuery" value="{view&gt;/query}" placeholder="Artikel, Platz, Charge, Seriennummer" search=".onSearch" liveChange=".onSearch"/></VBox></layout:Grid><HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginTop"><VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Fächer im Filter"/><ObjectNumber number="{view&gt;/counts/places}" unit="Plätze"/></VBox><VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Einlagerung offen"/><ObjectNumber number="{view&gt;/counts/bufferLines}" unit="Bestandszeilen" state="{= ${view&gt;/counts/bufferLines} &gt; 0 ? 'Warning' : 'Success' }"/></VBox><VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Positive Fach-/Pufferbestände"/><ObjectNumber number="{view&gt;/counts/stockLines}" unit="Bestandszeilen"/></VBox><VBox class="sapUiSmallMarginBottom"><Label text="Plätze gesperrt (einschl. Regal)"/><ObjectNumber number="{view&gt;/counts/blocked}" unit="Plätze" state="{= ${view&gt;/counts/blocked} &gt; 0 ? 'Warning' : 'None' }"/></VBox></HBox></VBox></f:DynamicPageHeader></f:header><f:content><VBox><MessageStrip text="Zuerst Buchungskreis, Werk und Lagerort im Bereich Lager &amp; Materialbewegungen konfigurieren." showIcon="true" visible="{= !${view&gt;/companyId} }"/><VBox visible="{= !!${view&gt;/companyId} }"><OverflowToolbar><Title text="Scannerarbeitsplatz" level="H3"/><ToolbarSpacer/><Select width="8rem" selectedKey="{view&gt;/scanKind}"><items><core:Item key="BIN" text="Lagerplatz"/><core:Item key="PRODUCT" text="Artikel"/></items></Select><Input id="warehouseScan" width="19rem" value="{view&gt;/scanValue}" placeholder="Barcode scannen · Enter" submit=".onScan"/><Button text="Scan prüfen" icon="sap-icon://bar-code" press=".onScan"/><Button text="Filter zurücksetzen" icon="sap-icon://clear-filter" press=".onClear"/></OverflowToolbar><ObjectStatus text="{view&gt;/scanResult}" visible="{= !!${view&gt;/scanResult} }" state="Information" class="sapUiSmallMargin"/><IconTabBar headerMode="Inline" selectedKey="{view&gt;/tab}" expandable="false"><items>
<IconTabFilter key="buffer" text="Einlagerung" count="{view&gt;/counts/bufferLines}" icon="sap-icon://inbox"><MessageStrip text="Wareneingänge und vorhandene Bestände ohne Fachzuordnung liegen im Eingangspuffer. Erst die bestätigte Einlagerung ordnet eine tatsächliche Teilmenge einem Fach zu." showIcon="true"/><Table id="warehouseBufferTable" items="{view&gt;/list/buffer}" growing="true" noDataText="Keine offenen Bestände im Eingangspuffer."><columns><Column><Text text="Artikel"/></Column><Column hAlign="End"><Text text="Istbestand"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column visible="{state&gt;/access/inventoryWrite}"><Text text="Einlagerung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{= ${view&gt;productNumber} + ' · ' + ${view&gt;sku} }"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><Button text="Einlagern" icon="sap-icon://shelf" press=".onTransfer" enabled="{= !${view&gt;unavailable} }"/></cells></ColumnListItem></items></Table></IconTabFilter>
<IconTabFilter key="stock" text="Fachbestände" count="{view&gt;/counts/stockLines}" icon="sap-icon://inventory"><Table id="warehouseStockTable" items="{view&gt;/list/balances}" growing="true" noDataText="Kein positiver Bestand für den gewählten Filter."><columns><Column><Text text="Artikel"/></Column><Column><Text text="Lagerplatz"/></Column><Column hAlign="End"><Text text="Istmenge"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Frei im Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true" visible="{state&gt;/access/inventoryWrite}"><Text text="Platzwechsel"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><VBox><ObjectIdentifier title="{view&gt;binCode}" text="{= ${view&gt;plantCode} + ' / ' + ${view&gt;locationCode} }"/><ObjectStatus text="Gesperrt" state="Warning" visible="{view&gt;unavailable}"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;locationFreeQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><VBox><Button text="Platz wechseln" press=".onTransfer" enabled="{= !${view&gt;unavailable} }"/><Button text="Umlagern" tooltip="Nur freier Lagerortbestand; Auftragsreservierungen bleiben geschützt" icon="sap-icon://shipping-status" press=".onRelocate" enabled="{= !${view&gt;unavailable} &amp;&amp; ${view&gt;locationFreeQuantity} &gt; 0 }"/></VBox></cells></ColumnListItem></items></Table></IconTabFilter>
<IconTabFilter key="bins" text="Plätze &amp; Etiketten" count="{view&gt;/counts/places}" icon="sap-icon://bar-code"><Table id="warehouseBinTable" items="{view&gt;/list/bins}" growing="true" noDataText="Noch keine Fächer für diesen Filter."><headerToolbar><OverflowToolbar><Title text="Lagerplätze"/><ToolbarSpacer/><Button text="Lagerfach anlegen" press=".onNewBin" visible="{state&gt;/access/inventoryWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Platz / Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bereich / Gang / Regal / Ebene / Fach"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Belegung / Kapazität"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Platzregeln"/></Column><Column><Text text="Aktionen"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;code}" text="{view&gt;name}"/><Text text="{= ${view&gt;plantCode} + ' / ' + ${view&gt;locationCode} }"/><ObjectStatus text="{= ${view&gt;unavailable} ? 'Für Bewegung gesperrt' : ${view&gt;systemBuffer} ? 'Zuordnung offen' : 'Für Bewegung offen' }" state="{= ${view&gt;unavailable} ? 'Warning' : 'None' }"/></VBox><Text text="{= ${view&gt;systemBuffer} ? 'Eingangspuffer' : ${view&gt;areaCode} + ' / ' + ${view&gt;aisle} + ' / ' + ${view&gt;rackCode} + ' / ' + ${view&gt;level} + ' / ' + ${view&gt;compartment} }"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{= ${view&gt;quantity} === null ? 'Gemischte Bestandseinheiten' : '' }"/><Text text="Ohne Mengengrenze" visible="{= ${view&gt;capacity} === null }"/><HBox visible="{= ${view&gt;capacity} !== null }"><Text text="Kapazität" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;capacity',formatter:'.formatter.decimal'}" unit="{view&gt;capacityUnit}" emphasized="false"/></HBox></VBox><VBox><Text text="{= ${view&gt;allowMixedProducts} ? 'Artikelmischung erlaubt' : 'Ein Artikel je Platz' }"/><Text text="{= ${view&gt;allowMixedBatches} ? 'Chargenmischung erlaubt' : 'Eine Charge je Artikel' }"/></VBox><VBox><Button text="Platzetiketten" icon="sap-icon://bar-code" press=".onLabel"/><Button text="Platz bearbeiten" press=".onEdit" visible="{= ${state&gt;/access/inventoryWrite} &amp;&amp; !${view&gt;systemBuffer} }"><customData><core:CustomData key="kind" value="bins"/></customData></Button></VBox></cells></ColumnListItem></items></Table></IconTabFilter>
<IconTabFilter key="structure" text="Lagerstruktur" icon="sap-icon://org-chart"><VBox><Table items="{view&gt;/list/areas}" noDataText="Noch keine Bereiche angelegt."><headerToolbar><OverflowToolbar><Title text="Lagerbereiche"/><ToolbarSpacer/><Button text="Bereich anlegen" press=".onNewArea" visible="{state&gt;/access/inventoryWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Bereich / Lagerort"/></Column><Column><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Sperre"/></Column><Column visible="{state&gt;/access/inventoryWrite}"><Text text="Bearbeiten"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;code}" text="{view&gt;locationCode}"/><Text text="{view&gt;name}"/><ObjectStatus text="{= ${view&gt;blocked} ? 'Gesperrt' : 'Offen' }" state="{= ${view&gt;blocked} ? 'Warning' : 'None' }"/><Button text="Bereich bearbeiten" press=".onEdit"><customData><core:CustomData key="kind" value="areas"/></customData></Button></cells></ColumnListItem></items></Table><Table items="{view&gt;/list/racks}" noDataText="Noch keine Regale angelegt." class="sapUiMediumMarginTop"><headerToolbar><OverflowToolbar><Title text="Gänge &amp; Regale"/><ToolbarSpacer/><Button text="Regal anlegen" press=".onNewRack" visible="{state&gt;/access/inventoryWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Bereich / Gang / Regal"/></Column><Column><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Sperre"/></Column><Column visible="{state&gt;/access/inventoryWrite}"><Text text="Bearbeiten"/></Column></columns><items><ColumnListItem><cells><Text text="{= ${view&gt;areaCode} + ' / ' + ${view&gt;aisle} + ' / ' + ${view&gt;code} }"/><Text text="{view&gt;name}"/><ObjectStatus text="{= ${view&gt;blocked} ? 'Gesperrt' : 'Offen' }" state="{= ${view&gt;blocked} ? 'Warning' : 'None' }"/><Button text="Regal bearbeiten" press=".onEdit"><customData><core:CustomData key="kind" value="racks"/></customData></Button></cells></ColumnListItem></items></Table></VBox></IconTabFilter>
<IconTabFilter key="movements" text="Bewegungsjournal" icon="sap-icon://shipping-status"><VBox><Title text="Letzte 100 Platzwechsel im Buchungskreis" level="H3" class="sapUiSmallMargin"/><Table items="{view&gt;/list/transfers}" growing="true" noDataText="Noch keine gebuchten Platzwechsel."><columns><Column><Text text="Materialbeleg"/></Column><Column><Text text="Bewegung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Datum / Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Grund"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onMovement"/><ObjectStatus text="Zurückgenommen" state="Warning" visible="{= !!${view&gt;reversalId} }"/></VBox><Text text="{parts:[{path:'view&gt;movementType'},{path:'view&gt;destinationLocationId'}],formatter:'.formatter.warehouseMovement'}"/><VBox><Text text="{path:'view&gt;movementDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{view&gt;locationCode}"/><Text text="{= 'Ziel: ' + ${view&gt;destinationPlantCode} + ' / ' + ${view&gt;destinationLocationCode} }" visible="{= !!${view&gt;destinationLocationId} }"/></VBox><Text text="{view&gt;reason}"/></cells></ColumnListItem></items></Table><Title text="Letzte 200 Platzbuchungen im Buchungskreis" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/><Table items="{view&gt;/list/entries}" growing="true" noDataText="Noch keine Platzbuchungen."><columns><Column><Text text="Quelle / Zeitpunkt"/></Column><Column><Text text="Artikel / Lagerplatz"/></Column><Column hAlign="End"><Text text="Mengenänderung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;sourceNumber}" press=".onEntry"/><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/></VBox><ObjectIdentifier title="{view&gt;sku}" text="{view&gt;binCode}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/></cells></ColumnListItem></items></Table></VBox></IconTabFilter>
</items></IconTabBar></VBox></VBox></f:content></f:DynamicPage></mvc:View>
