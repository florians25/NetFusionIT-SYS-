<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.IncomingInvoice" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false">
  <f:title><f:DynamicPageTitle><f:heading><ObjectIdentifier title="{view&gt;/number}" text="{= ${view&gt;/financial/reversed} ? 'Stornierte Eingangsrechnung' : ${view&gt;/status} === 'POSTED' ? 'Gebuchte Eingangsrechnung' : 'Eingangsrechnung · Originalübernahme' }"/></f:heading><f:actions><Button text="Original prüfen" icon="sap-icon://validate" type="Emphasized" press=".onProcess" enabled="{view&gt;/canProcess}" visible="{state&gt;/access/apReceive}"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onFiles"/><Button text="Virenprüfung" icon="sap-icon://shield" press=".onScan" visible="{state&gt;/access/apReceive}" enabled="{= ${view&gt;/importState} !== 'PROCESSING' }"/><Button text="Eingang abbrechen" press=".onCancel" visible="{view&gt;/canCancel}"/><Button icon="sap-icon://refresh" tooltip="Eingangsrechnung aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Lieferantenbeleg"/><ObjectIdentifier title="{view&gt;/externalNumber}" text="{view&gt;/supplierName}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Technische Prüfung"/><ObjectStatus text="{path:'view&gt;/importState',formatter:'.formatter.incomingState'}" state="{path:'view&gt;/importState',formatter:'.formatter.incomingValueState'}"/><Text text="{path:'view&gt;/scanStatus',formatter:'.formatter.incomingScan'}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Belegdatum"/><Text text="{path:'view&gt;/invoiceDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Fälligkeit"/><Text text="{path:'view&gt;/dueDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Betrag netto / Steuer"/><ObjectNumber number="{path:'view&gt;/net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><ObjectNumber number="{path:'view&gt;/tax',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox><VBox><Label text="Rechnungsbetrag"/><ObjectNumber number="{path:'view&gt;/gross',formatter:'.formatter.money'}" unit="{view&gt;/currency}" emphasized="true"/></VBox></HBox></f:DynamicPageHeader></f:header>
  <f:content><VBox><MessageStrip text="{view&gt;/lastError}" visible="{= !!${view&gt;/lastError} }" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/><MessageStrip text="Gleiche externe Rechnungsnummer in weiteren Eingängen vorhanden. Dubletten vor einer späteren Buchung klären." visible="{= !!${view&gt;/duplicates} &amp;&amp; ${view&gt;/duplicates}.length &gt; 0 }" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
   <MessageStrip text="Diese Eingangsrechnung ist vollständig gegengebucht. Original und historische Zuordnung bleiben erhalten; die ursprüngliche WE-Verrechnung ist aufgehoben." visible="{view&gt;/financial/reversed}" showIcon="true" class="sapUiSmallMarginBottom"/><IconTabBar expandable="false"><items>
    <IconTabFilter text="Positionen" count="{= ${view&gt;/items}.length }"><Table items="{view&gt;/items}" noDataText="Positionen werden erst nach erfolgreicher Originalprüfung übernommen"><columns><Column width="4rem"><Text text="Pos."/></Column><Column><Text text="Artikel / Leistung"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Menge"/></Column><Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="Preis netto"/></Column><Column hAlign="End"><Text text="Netto / Steuer"/></Column><Column width="15rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Leistungsdatum"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;externalPosition}"/><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.price'}" unit="{view&gt;/currency}"/><VBox><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><Text text="{parts:[{path:'view&gt;taxRate'}],formatter:'.formatter.taxRate'}"/></VBox><Text text="{parts:[{path:'view&gt;serviceFrom'},{path:'view&gt;serviceTo'}],formatter:'.formatter.servicePeriod'}" wrapping="false"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Bestellabgleich" key="matching"><MessageStrip text="Gespeicherte Vorprüfung von Bestellung, tatsächlichem Wareneingang und Rechnungsoriginal. Sachliche und steuerliche Freigabe sowie Buchung erfolgen gesondert." showIcon="true" class="sapUiSmallMarginBottom"/>
     <OverflowToolbar><Title text="Kaufmännische Zuordnung" level="H3"/><ToolbarSpacer/><ObjectStatus text="Auswahl geändert · neu prüfen" state="Warning" visible="{view&gt;/matching/dirty}"/><Button text="Bestellung auswählen" icon="sap-icon://purchase-order" press=".onChooseOrder" visible="{view&gt;/matching/canEdit}"/><Button text="Zuordnung speichern &amp; prüfen" type="Emphasized" press=".onSaveMatching" visible="{view&gt;/matching/canEdit}" enabled="{= !!${view&gt;/matching/purchaseOrderId} }"/></OverflowToolbar>
     <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Bestell-/Auftragsbezug"/><Label text="Bestellung"/><Link text="{view&gt;/matching/purchaseOrderNumber}" press=".onMatchingPurchaseOrder" enabled="{state&gt;/access/requisitionRead}"/><Label text="Lieferant"/><Text text="{view&gt;/matching/supplierName}"/><Label text="Serviceauftrag"/><Link text="{view&gt;/matching/orderNumber}" press=".onMatchingOrder" enabled="{state&gt;/access/orders}"/><core:Title text="Kreditorenrolle"/><Label text="Konto"/><Text text="{view&gt;/matching/creditor/accountNumber}"/><Label text="Freigabe"/><ObjectStatus text="{path:'view&gt;/matching/creditor/status',formatter:'.formatter.status'}"/><Label text="Zahlungssperre"/><Text text="{= ${view&gt;/matching/creditor/id} ? (${view&gt;/matching/creditor/paymentBlock} ? 'Gesetzt' : 'Nicht gesetzt') : 'Nicht bewertet' }"/><core:Title text="Gespeicherter Prüfstand"/><Label text="Zuletzt zugeordnet"/><Text text="{path:'view&gt;/matching/matchedAt',formatter:'.formatter.date'}"/><Label text="Vorprüfung"/><ObjectStatus text="{= ${view&gt;/matching/clear} ? 'Ohne festgestellte Abweichung' : 'Klärungsbedarf vorhanden' }" state="{= ${view&gt;/matching/clear} ? 'Success' : 'Warning' }"/><Label text="Prüfnotiz"/><TextArea value="{view&gt;/matching/matchNote}" editable="{view&gt;/matching/canEdit}" rows="3" width="100%" change=".onMatchingChanged"/></form:content></form:SimpleForm>
     <Table id="matchingLines" items="{view&gt;/matching/lines}" noDataText="Zunächst das Original prüfen"><headerToolbar><Toolbar><Title text="Rechnungspositionen zuordnen" level="H3"/></Toolbar></headerToolbar><columns><Column width="4rem"><Text text="Pos."/></Column><Column><Text text="Leistung / Artikel laut Original"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Menge / Preis"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bestellposition"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;externalPosition}"/><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.price'}" unit="{view&gt;/currency}"/></VBox><Select width="100%" forceSelection="false" selectedKey="{view&gt;purchaseOrderItemId}" items="{path:'view&gt;/matching/selectItems',templateShareable:false}" enabled="{view&gt;/matching/canEdit}" change=".onMatchingChanged"><items><core:Item key="{view&gt;key}" text="{view&gt;text}"/></items></Select></cells></ColumnListItem></items></Table>
     <Table id="matchingComparison" items="{view&gt;/matching/items}" noDataText="Bestellung auswählen"><headerToolbar><Toolbar><Title text="Bestellung · tatsächlicher WE · Rechnung" level="H3"/></Toolbar></headerToolbar><columns><Column width="4rem"><Text text="Pos."/></Column><Column><Text text="Bestellartikel / SA-Position"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Bestellt"/></Column><Column hAlign="End"><Text text="WE wirksam"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Andere Rechnungen / offen"/></Column><Column hAlign="End"><Text text="Rechnungsmenge"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Preis-/Einheitenprüfung"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;position}"/><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;sku} + ' · SA-Pos. ' + ${view&gt;orderPosition} }"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;receivedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><ObjectNumber number="{path:'view&gt;otherInvoicedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;remainingQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/></VBox><ObjectNumber number="{path:'view&gt;invoiceQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}" state="{= ${view&gt;quantityDifference} ? 'Error' : 'None' }"/><VBox><ObjectStatus text="{= ${view&gt;priceDifference} ? 'Preisabweichung' : 'Bestellpreis eingehalten' }" state="{= ${view&gt;priceDifference} ? 'Warning' : 'Success' }"/><ObjectStatus text="{= ${view&gt;unitDifference} ? 'Einheit klären' : 'Einheit stimmt überein' }" state="{= ${view&gt;unitDifference} ? 'Warning' : 'None' }"/></VBox></cells></ColumnListItem></items></Table>
     <List items="{view&gt;/matching/issues}" noDataText="Keine Abweichung in der gespeicherten Vorprüfung"><headerToolbar><Toolbar><Title text="Prüfbefunde" level="H3"/></Toolbar></headerToolbar><items><StandardListItem title="{view&gt;message}" description="{path:'view&gt;code',formatter:'.formatter.incomingIssue'}" icon="sap-icon://message-warning" wrapping="true"/></items></List>
     <Table id="matchingReceipts" items="{view&gt;/matching/receipts}" noDataText="Noch keine gebuchten Wareneingänge zu dieser Bestellung"><headerToolbar><Toolbar><Title text="Tatsächliche Wareneingänge und Gegenbewegungen" level="H3"/></Toolbar></headerToolbar><columns><Column><Text text="Materialbeleg"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum / Lieferschein"/></Column><Column hAlign="End"><Text text="Menge"/></Column><Column><Text text="Wirksamkeit"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;number}" press=".onMatchingReceipt" enabled="{state&gt;/access/inventory}"/><VBox><Text text="{path:'view&gt;postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{view&gt;deliveryNote}"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}"/><ObjectStatus text="{= ${view&gt;reversed} ? 'Gegenbewegung / storniert' : 'Als WE berücksichtigt' }" state="{= ${view&gt;reversed} ? 'None' : 'Success' }"/></cells></ColumnListItem></items></Table>
    </IconTabFilter>
    <IconTabFilter text="Kopfdaten &amp; Parteien"><form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" labelSpanXL="4" labelSpanL="4"><form:content>
     <core:Title text="Rechnungseingang"/><Label text="Buchungskreis"/><Text text="{= ${view&gt;/companyCode} + ' · ' + ${view&gt;/companyName} }"/><Label text="Empfangen"/><Text text="{path:'view&gt;/receivedAt',formatter:'.formatter.date'}"/><Label text="Originaldatei"/><Text text="{view&gt;/filename}"/><Label text="Datenformat / Profil"/><Text text="{= ${view&gt;/parsed/format} + ' · ' + ${view&gt;/parsed/profile} }"/><Label text="Bestellreferenz"/><Text text="{view&gt;/parsed/purchaseOrderReference}"/><Label text="Käuferreferenz"/><Text text="{view&gt;/parsed/buyerReference}"/>
     <core:Title text="Aussteller laut Original"/><Label text="Name"/><Text text="{view&gt;/parsed/seller/name}"/><Label text="Straße"/><Text text="{view&gt;/parsed/seller/street}"/><Label text="PLZ / Ort"/><Text text="{= ${view&gt;/parsed/seller/postalCode} + ' ' + ${view&gt;/parsed/seller/city} }"/><Label text="Land"/><Text text="{view&gt;/parsed/seller/country}"/><Label text="USt-ID"/><Text text="{view&gt;/parsed/seller/vatId}"/><Label text="IBAN laut Original"/><Text text="{view&gt;/parsed/seller/iban}"/>
     <core:Title text="Empfänger laut Original"/><Label text="Name"/><Text text="{view&gt;/parsed/buyer/name}"/><Label text="Straße"/><Text text="{view&gt;/parsed/buyer/street}"/><Label text="PLZ / Ort"/><Text text="{= ${view&gt;/parsed/buyer/postalCode} + ' ' + ${view&gt;/parsed/buyer/city} }"/><Label text="Land"/><Text text="{view&gt;/parsed/buyer/country}"/><Label text="USt-ID"/><Text text="{view&gt;/parsed/buyer/vatId}"/>
    </form:content></form:SimpleForm><MessageStrip text="Parteien und Bankangaben stammen aus der Rechnung. Sie verändern weder freigegebene Kreditorenstammdaten noch Zahlungsfreigaben." showIcon="true"/></IconTabFilter>
    <IconTabFilter text="Prüfungen &amp; Historie"><form:SimpleForm editable="false" layout="ResponsiveGridLayout"><form:content><Label text="Normatives Prüfwerkzeug"/><Text text="{view&gt;/validator}"/><Label text="Prüfversuche"/><Text text="{view&gt;/attempts}"/><Label text="Letzte Prüfung"/><Text text="{path:'view&gt;/completedAt',formatter:'.formatter.date'}"/><Label text="Original SHA-256"/><Text text="{view&gt;/sha256}"/></form:content></form:SimpleForm><Table items="{view&gt;/scans}" noDataText="Noch keine Sicherheitsprüfung erfolgt"><columns><Column><Text text="Zeitpunkt"/></Column><Column><Text text="Prüfergebnis"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Prüfdienst"/></Column><Column><Text text="Hinweis"/></Column></columns><items><ColumnListItem><cells><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;status',formatter:'.formatter.incomingScan'}"/><Text text="{view&gt;engine}"/><Text text="{view&gt;detail}"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Dublettenprüfung" count="{= ${view&gt;/duplicates}.length }"><Table items="{view&gt;/duplicates}" itemPress=".onDuplicate" noDataText="Keine weiteren Eingänge mit gleicher externer Belegnummer im Buchungskreis"><columns><Column><Text text="Eingang"/></Column><Column><Text text="Aussteller"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Belegdatum"/></Column><Column hAlign="End"><Text text="Bruttobetrag"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{view&gt;supplierName}"/><Text text="{path:'view&gt;invoiceDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;gross',formatter:'.formatter.money'}" unit="{view&gt;currency}"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Finanzprüfung &amp; Buchung" key="financial"><OverflowToolbar><Title text="Verbindliche Rechnungsprüfung" level="H3"/><ToolbarSpacer/><Button text="Storno vorbereiten" icon="sap-icon://undo" press=".onCreateReversal" visible="{view&gt;/financial/canReverse}"/><Button text="Stornobeleg öffnen" press=".onReversal" visible="{= !!${view&gt;/financial/reversal} }"/><Button text="Buchung vorbereiten" icon="sap-icon://accounting-document-verification" press=".onPrepare" visible="{view&gt;/financial/canPrepare}"/><Button text="Zur Freigabe einreichen" press=".onSubmitFinancial" visible="{view&gt;/financial/canSubmit}"/><Button text="Freigabe zurückziehen" press=".onWithdrawFinancial" visible="{view&gt;/financial/canWithdraw}"/><Button text="Eingangsrechnung buchen" type="Emphasized" press=".onPostFinancial" visible="{view&gt;/financial/canPost}"/></OverflowToolbar>
     <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Buchungsvorbereitung"/><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/financial/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Fälligkeit"/><Text text="{path:'view&gt;/financial/dueDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Vorbereitet von"/><Text text="{view&gt;/financial/preparedByName}"/><Label text="Vorbereitet am"/><Text text="{path:'view&gt;/financial/preparedAt',formatter:'.formatter.date'}"/><Label text="Sachliche Prüfnotiz"/><Text text="{view&gt;/financial/commercialNote}"/>
      <core:Title text="Unabhängige Finanzprüfung"/><Label text="Freigabestatus"/><ObjectStatus text="{path:'view&gt;/financial/status',formatter:'.formatter.status'}" state="{path:'view&gt;/financial/status',formatter:'.formatter.statusState'}"/><Label text="Steuerprüfung durch"/><Text text="{view&gt;/financial/taxReviewedByName}"/><Label text="Prüfbegründung"/><Text text="{view&gt;/financial/taxReviewNote}"/>
      <core:Title text="Finanzbeleg und offener Posten"/><Label text="Finanzbeleg"/><Link text="{view&gt;/financial/journal/number}" press=".onFinancialJournal" enabled="{state&gt;/access/financeRead}"/><Label text="Gebucht am"/><Text text="{path:'view&gt;/financial/postedAt',formatter:'.formatter.date'}"/><Label text="Kreditorenposten"/><ObjectNumber number="{path:'view&gt;/financial/openItem/amount',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><Label text="Offener Rest"/><ObjectNumber number="{path:'view&gt;/financial/openItem/balance',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><Label text="Stornobeleg"/><Link text="{view&gt;/financial/reversal/number}" press=".onReversal"/><Label text="Zahlungsfreigabe"/><ObjectStatus text="{= ${view&gt;/financial/reversed} ? 'Durch Storno aufgehoben' : ${view&gt;/financial/openItem} ? 'Zahlung gesperrt · separat freigeben' : 'Kein gebuchter Posten' }" state="{= ${view&gt;/financial/openItem} ? 'Warning' : 'None' }"/></form:content></form:SimpleForm>
     <MessageStrip text="Die Vorbereitung bindet den geprüften Finanzstand. Ändern sich Restmengen oder Konten, sind Vorbereitung und unabhängige Freigabe zu erneuern. Die Zahlung wird getrennt freigegeben." showIcon="true" class="sapUiSmallMarginBottom"/>
     <Table id="financialAllocations" items="{view&gt;/financial/allocations}" noDataText="Noch keine verbindliche Buchungsvorbereitung vorhanden"><headerToolbar><Toolbar><Title text="WE-Verrechnung im gespeicherten Finanzstand" level="H3"/></Toolbar></headerToolbar><columns><Column width="4rem"><Text text="Pos."/></Column><Column><Text text="Rechnungsposition / Original-WE"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="WE-Menge / Ursprungswert"/></Column><Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Zuvor gebucht"/></Column><Column hAlign="End"><Text text="Diese Rechnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Historisches WE/RE-Konto"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;invoicePosition}"/><ObjectIdentifier title="{view&gt;description}" text="{view&gt;receiptNumber}"/><VBox><ObjectNumber number="{path:'view&gt;originalQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;originalClearingValue',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox><VBox><ObjectNumber number="{path:'view&gt;previousPostedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;previousPostedNet',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox><Text text="{view&gt;grirAccountCode}"/></cells></ColumnListItem></items></Table>
    </IconTabFilter>
   </items></IconTabBar>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
