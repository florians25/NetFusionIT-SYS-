<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.IncomingInvoice" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false">
  <f:title><f:DynamicPageTitle><f:heading><ObjectIdentifier title="{view&gt;/number}" text="Eingangsrechnung · Originalübernahme"/></f:heading><f:actions><Button text="Original prüfen" icon="sap-icon://validate" type="Emphasized" press=".onProcess" enabled="{view&gt;/canProcess}" visible="{state&gt;/access/apReceive}"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onFiles"/><Button text="Virenprüfung" icon="sap-icon://shield" press=".onScan" visible="{state&gt;/access/apReceive}" enabled="{= ${view&gt;/importState} !== 'PROCESSING' }"/><Button text="Eingang abbrechen" press=".onCancel" visible="{view&gt;/canCancel}"/><Button icon="sap-icon://refresh" tooltip="Eingangsrechnung aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Lieferantenbeleg"/><ObjectIdentifier title="{view&gt;/externalNumber}" text="{view&gt;/supplierName}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Technische Prüfung"/><ObjectStatus text="{path:'view&gt;/importState',formatter:'.formatter.incomingState'}" state="{path:'view&gt;/importState',formatter:'.formatter.incomingValueState'}"/><Text text="{path:'view&gt;/scanStatus',formatter:'.formatter.incomingScan'}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Belegdatum"/><Text text="{path:'view&gt;/invoiceDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Fälligkeit"/><Text text="{path:'view&gt;/dueDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Betrag netto / Steuer"/><ObjectNumber number="{path:'view&gt;/net',formatter:'.formatter.decimal'}" unit="{view&gt;/currency}"/><ObjectNumber number="{path:'view&gt;/tax',formatter:'.formatter.decimal'}" unit="{view&gt;/currency}"/></VBox><VBox><Label text="Rechnungsbetrag"/><ObjectNumber number="{path:'view&gt;/gross',formatter:'.formatter.decimal'}" unit="{view&gt;/currency}" emphasized="true"/></VBox></HBox></f:DynamicPageHeader></f:header>
  <f:content><VBox><MessageStrip text="{view&gt;/lastError}" visible="{= !!${view&gt;/lastError} }" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/><MessageStrip text="Gleiche externe Rechnungsnummer in weiteren Eingängen vorhanden. Dubletten vor einer späteren Buchung klären." visible="{= !!${view&gt;/duplicates} &amp;&amp; ${view&gt;/duplicates}.length &gt; 0 }" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
   <IconTabBar expandable="false"><items>
    <IconTabFilter text="Positionen" count="{= ${view&gt;/items}.length }"><Table items="{view&gt;/items}" noDataText="Positionen werden erst nach erfolgreicher Originalprüfung übernommen"><columns><Column width="4rem"><Text text="Pos."/></Column><Column><Text text="Artikel / Leistung"/></Column><Column hAlign="End"><Text text="Menge"/></Column><Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="Preis netto"/></Column><Column hAlign="End"><Text text="Netto / Steuer"/></Column><Column width="15rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Leistungsdatum"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;externalPosition}"/><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.decimal'}" unit="{view&gt;/currency}"/><VBox><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.decimal'}" unit="{view&gt;/currency}"/><Text text="{= ${view&gt;taxRate} + ' % USt.' }"/></VBox><Text text="{parts:[{path:'view&gt;serviceFrom'},{path:'view&gt;serviceTo'}],formatter:'.formatter.servicePeriod'}" wrapping="false"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Kopfdaten &amp; Parteien"><form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" labelSpanXL="4" labelSpanL="4"><form:content>
     <Title text="Rechnungseingang"/><Label text="Buchungskreis"/><Text text="{= ${view&gt;/companyCode} + ' · ' + ${view&gt;/companyName} }"/><Label text="Empfangen"/><Text text="{path:'view&gt;/receivedAt',formatter:'.formatter.date'}"/><Label text="Originaldatei"/><Text text="{view&gt;/filename}"/><Label text="Datenformat / Profil"/><Text text="{= ${view&gt;/parsed/format} + ' · ' + ${view&gt;/parsed/profile} }"/><Label text="Bestellreferenz"/><Text text="{view&gt;/parsed/purchaseOrderReference}"/><Label text="Käuferreferenz"/><Text text="{view&gt;/parsed/buyerReference}"/>
     <Title text="Aussteller laut Original"/><Label text="Name"/><Text text="{view&gt;/parsed/seller/name}"/><Label text="Straße"/><Text text="{view&gt;/parsed/seller/street}"/><Label text="PLZ / Ort"/><Text text="{= ${view&gt;/parsed/seller/postalCode} + ' ' + ${view&gt;/parsed/seller/city} }"/><Label text="Land"/><Text text="{view&gt;/parsed/seller/country}"/><Label text="USt-ID"/><Text text="{view&gt;/parsed/seller/vatId}"/><Label text="IBAN laut Original"/><Text text="{view&gt;/parsed/seller/iban}"/>
     <Title text="Empfänger laut Original"/><Label text="Name"/><Text text="{view&gt;/parsed/buyer/name}"/><Label text="Straße"/><Text text="{view&gt;/parsed/buyer/street}"/><Label text="PLZ / Ort"/><Text text="{= ${view&gt;/parsed/buyer/postalCode} + ' ' + ${view&gt;/parsed/buyer/city} }"/><Label text="Land"/><Text text="{view&gt;/parsed/buyer/country}"/><Label text="USt-ID"/><Text text="{view&gt;/parsed/buyer/vatId}"/>
    </form:content></form:SimpleForm><MessageStrip text="Parteien und Bankangaben stammen aus der Rechnung. Sie verändern weder freigegebene Kreditorenstammdaten noch Zahlungsfreigaben." showIcon="true"/></IconTabFilter>
    <IconTabFilter text="Prüfungen &amp; Historie"><form:SimpleForm editable="false" layout="ResponsiveGridLayout"><form:content><Label text="Normatives Prüfwerkzeug"/><Text text="{view&gt;/validator}"/><Label text="Prüfversuche"/><Text text="{view&gt;/attempts}"/><Label text="Letzte Prüfung"/><Text text="{path:'view&gt;/completedAt',formatter:'.formatter.date'}"/><Label text="Original SHA-256"/><Text text="{view&gt;/sha256}"/></form:content></form:SimpleForm><Table items="{view&gt;/scans}" noDataText="Noch keine Sicherheitsprüfung erfolgt"><columns><Column><Text text="Zeitpunkt"/></Column><Column><Text text="Prüfergebnis"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Prüfdienst"/></Column><Column><Text text="Hinweis"/></Column></columns><items><ColumnListItem><cells><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;status',formatter:'.formatter.incomingScan'}"/><Text text="{view&gt;engine}"/><Text text="{view&gt;detail}"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Dublettenprüfung" count="{= ${view&gt;/duplicates}.length }"><Table items="{view&gt;/duplicates}" itemPress=".onDuplicate" noDataText="Keine weiteren Eingänge mit gleicher externer Belegnummer im Buchungskreis"><columns><Column><Text text="Eingang"/></Column><Column><Text text="Aussteller"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Belegdatum"/></Column><Column hAlign="End"><Text text="Bruttobetrag"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{view&gt;supplierName}"/><Text text="{path:'view&gt;invoiceDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;gross',formatter:'.formatter.decimal'}" unit="{view&gt;currency}"/></cells></ColumnListItem></items></Table></IconTabFilter>
   </items></IconTabBar>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
