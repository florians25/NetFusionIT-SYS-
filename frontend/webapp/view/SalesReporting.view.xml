<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:table="sap.ui.table" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="netfusion.erp.controller.SalesReporting" displayBlock="true">
 <f:DynamicPage id="salesReportPage" headerExpanded="true" fitContent="false">
  <f:title><f:DynamicPageTitle><f:heading><Title text="Umsatz &amp; Deckungsbeitrag"/></f:heading><f:actions><Button text="Filter anzeigen" icon="sap-icon://filter" press=".onToggleFilters" enabled="{view&gt;/hasCompany}"/><Button text="CSV exportieren" icon="sap-icon://download" press=".onExport" enabled="{view&gt;/hasData}"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".onApply" enabled="{view&gt;/hasCompany}"/></f:actions><f:expandedContent><ObjectStatus text="FI-Buchungsdatum · tatsächliche Quellen · je Buchungskreis und Währung" state="Information"/></f:expandedContent></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><VBox visible="{view&gt;/hasCompany}">
   <form:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" labelSpanXL="4" labelSpanL="4" labelSpanM="4" adjustLabelSpan="false"><form:content>
    <core:Title text="Buchungszeitraum"/><Label text="Buchungskreis"/><Select id="reportCompany" selectedKey="{view&gt;/filters/companyId}" change=".onCompany" items="{view&gt;/companies}" width="100%"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} + ' · ' + ${view&gt;currency} }"/></Select>
    <Label text="Buchungsdatum von"/><DatePicker id="reportFrom" value="{view&gt;/filters/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%"/>
    <Label text="Buchungsdatum bis"/><DatePicker id="reportTo" value="{view&gt;/filters/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%"/>
    <core:Title text="Herkunft und Auswertung"/><Label text="Geschäftsprozess"/><Select id="reportProcess" selectedKey="{view&gt;/filters/process}" width="100%"><core:Item key="DIRECT_SALES" text="Direktvertrieb · Lagerartikel"/><core:Item key="SERVICE" text="Service"/><core:Item key="ALL" text="Service und Direktvertrieb"/></Select>
    <Label text="Gruppierung"/><Select id="reportGrouping" selectedKey="{view&gt;/filters/groupBy}" width="100%"><core:Item key="DAY" text="Tag"/><core:Item key="MONTH" text="Monat"/><core:Item key="QUARTER" text="Quartal"/><core:Item key="YEAR" text="Jahr"/><core:Item key="CUSTOMER" text="Kunde"/><core:Item key="PRODUCT" text="Artikel"/><core:Item key="ORDER" text="Auftrag"/></Select>
    <Label text="Kunde"/><ComboBox id="reportPartner" selectedKey="{view&gt;/filters/partnerId}" width="100%" items="{view&gt;/partners}"><core:Item key="{view&gt;id}" text="{= ${view&gt;number} ? ${view&gt;number} + ' · ' + ${view&gt;name} : 'Alle Kunden' }"/></ComboBox>
    <Label text="Artikel"/><ComboBox id="reportProduct" selectedKey="{view&gt;/filters/productId}" width="100%" items="{view&gt;/products}"><core:Item key="{view&gt;id}" text="{= ${view&gt;sku} ? ${view&gt;sku} + ' · ' + ${view&gt;name} : 'Alle Artikel' }"/></ComboBox>
    <Label text="Vertriebsbereich"/><Select id="reportArea" selectedKey="{view&gt;/filters/salesAreaId}" width="100%" items="{view&gt;/areas}"><core:Item key="{view&gt;id}" text="{= ${view&gt;id} ? ${view&gt;salesOrgCode} + ' / ' + ${view&gt;channelCode} + ' / ' + ${view&gt;divisionCode} : 'Alle Vertriebsbereiche' }"/></Select>
    <core:Title text="Periodenvergleich"/><Label text="Vergleich"/><CheckBox text="Gleiche Anzahl Kalendertage vergleichen" selected="{view&gt;/filters/compare}" wrapping="true"/>
    <Label text="Vergleich von"/><DatePicker value="{view&gt;/filters/compareFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" enabled="{view&gt;/filters/compare}" width="100%"/>
    <Label text="Vergleich bis"/><DatePicker value="{view&gt;/filters/compareTo}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" enabled="{view&gt;/filters/compare}" width="100%"/>
   </form:content></form:SimpleForm>
   <OverflowToolbar><ObjectStatus text="Auf einen Auftrag eingegrenzt" visible="{= !!${view&gt;/filters/orderId} }"/><ToolbarSpacer/><Button text="Filter zurücksetzen" press=".onReset"/><Button text="Bericht anzeigen" type="Emphasized" press=".onApply"/></OverflowToolbar>
  </VBox></f:DynamicPageHeader></f:header>
  <f:content><VBox class="sapUiContentPadding">
   <MessageStrip text="Für den Bericht zuerst einen Buchungskreis mit Währung und tatsächlichen Geschäftsbelegen einrichten." visible="{= !${view&gt;/hasCompany} }" showIcon="true"/>
   <VBox visible="{view&gt;/hasData}">
    <FlexBox wrap="Wrap" class="sapUiSmallMarginBottom">
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Fakturiert netto"/><ObjectNumber number="{path:'view&gt;/report/summary/invoiceNet',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectStatus text="{= ${view&gt;/report/summary/invoiceCount} + (${view&gt;/report/summary/invoiceCount} === 1 ? ' Rechnung' : ' Rechnungen') }"/></VBox>
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Gutschriften netto"/><ObjectNumber number="{path:'view&gt;/report/summary/creditNet',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectStatus text="{= ${view&gt;/report/summary/creditCount} + (${view&gt;/report/summary/creditCount} === 1 ? ' Gutschrift' : ' Gutschriften') }"/></VBox>
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Nettoumsatz"/><ObjectNumber id="netRevenue" number="{path:'view&gt;/report/summary/netRevenue',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}" emphasized="true"/><Text text="{parts:[{path:'view&gt;/report/filters/from'},{path:'view&gt;/report/filters/to'}],formatter:'.formatter.servicePeriod'}" wrapping="false"/></VBox>
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" visible="{view&gt;/canReadCosts}"><Label text="DB I · fakturabezogen"/><ObjectNumber id="billingMargin" number="{path:'view&gt;/report/summary/billingMargin',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectNumber number="{path:'view&gt;/report/summary/billingMarginPercent',formatter:'.formatter.money'}" unit="%"/></VBox>
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" visible="{view&gt;/canReadCosts}"><Label text="Tatsächlicher Warenaufwand"/><ObjectNumber number="{path:'view&gt;/report/summary/stockExpense',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><Text text="WA und tatsächliche Rücknahmen"/></VBox>
     <VBox class="sapUiSmallMarginBottom" visible="{view&gt;/canReadCosts}"><Label text="Periodenbeitrag Waren"/><ObjectNumber number="{path:'view&gt;/report/summary/periodContribution',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><Text text="Nettoumsatz abzüglich Warenaufwand"/></VBox>
    </FlexBox>
    <MessageStrip text="Die Istkosten des Service sind noch nicht vollständig verfügbar. Für diese Auswahl wird kein vollständiger Deckungsbeitrag berechnet; bekannte Warenwerte bleiben getrennt sichtbar." type="Warning" visible="{view&gt;/costsIncomplete}" showIcon="true" class="sapUiSmallMarginBottom"/>
    <MessageStrip text="Die Kundenauswahl und Artikelauswahl zeigen jeweils höchstens500 Einträge. Ohne Einzelfilter werden alle berechtigten Quellen berücksichtigt." visible="{view&gt;/selectionLimited}" showIcon="true" class="sapUiSmallMarginBottom"/>
    <Panel headerText="Vergleich des Nettoumsatzes" visible="{= !!${view&gt;/report/comparison} }" class="sapUiSmallMarginBottom"><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Vergleichszeitraum"/><Text text="{parts:[{path:'view&gt;/report/comparison/from'},{path:'view&gt;/report/comparison/to'}],formatter:'.formatter.servicePeriod'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;/report/comparison/summary/netRevenue',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Veränderung absolut"/><ObjectNumber number="{path:'view&gt;/report/comparison/revenueDelta',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/></VBox><VBox><Label text="Veränderung relativ"/><ObjectNumber number="{path:'view&gt;/report/comparison/revenueDeltaPercent',formatter:'.formatter.money'}" unit="%"/><Text text="Bei Vergleichsbasis null keine Prozentangabe"/></VBox></FlexBox></Panel>
    <Panel headerText="Gruppenauswertung und Entwicklung" class="sapUiSmallMarginBottom"><VBox>
     <Text text="Eine Gruppe wählen, um die tatsächlichen Quellen einzugrenzen. Die Balken zeigen den Betrag im Verhältnis zum größten Umsatzbetrag dieser Auswahl." class="sapUiSmallMarginBottom"/>
     <table:Table id="revenueGroups" rows="{view&gt;/report/groups}" selectionMode="None" width="100%" visible="{= !${device&gt;/system/phone} }" ariaLabelledBy="revenueGroupsTitle"><table:extension><OverflowToolbar><Title id="revenueGroupsTitle" text="Umsatz und Kosten nach Gruppe" level="H3"/><ToolbarSpacer/><Text text="{view&gt;/report/company/currency}"/></OverflowToolbar></table:extension><table:rowMode><rowmodes:Auto minRowCount="3" maxRowCount="10"/></table:rowMode><table:columns>
      <table:Column width="12rem"><Label text="Gruppe / Quellen"/><table:template><Link text="{view&gt;label}" press=".onGroup" enabled="{= ${view&gt;key} !== 'UNASSIGNED' }"/></table:template></table:Column>
      <table:Column width="10rem" hAlign="End"><Label text="Fakturiert netto"/><table:template><ObjectNumber number="{path:'view&gt;invoiceNet',formatter:'.formatter.money'}"/></table:template></table:Column>
      <table:Column width="11rem" hAlign="End"><Label text="Gutschriften netto"/><table:template><ObjectNumber number="{path:'view&gt;creditNet',formatter:'.formatter.money'}"/></table:template></table:Column>
      <table:Column width="14rem"><Label text="Nettoumsatz"/><table:template><ProgressIndicator percentValue="{view&gt;barPercent}" displayValue="{path:'view&gt;netRevenue',formatter:'.formatter.money'}" state="{view&gt;barState}"/></table:template></table:Column>
      <table:Column width="11rem" hAlign="End" visible="{view&gt;/canReadCosts}"><Label text="Warenwert Faktura"/><table:template><ObjectNumber number="{path:'view&gt;billedCost',formatter:'.formatter.money'}"/></table:template></table:Column>
      <table:Column width="10rem" hAlign="End" visible="{view&gt;/canReadCosts}"><Label text="DB I Faktura"/><table:template><ObjectNumber number="{path:'view&gt;billingMargin',formatter:'.formatter.money'}"/></table:template></table:Column>
      <table:Column width="12rem" hAlign="End" visible="{view&gt;/canReadCosts}"><Label text="Warenaufwand Zeitraum"/><table:template><ObjectNumber number="{path:'view&gt;stockExpense',formatter:'.formatter.money'}"/></table:template></table:Column>
      <table:Column width="11rem" hAlign="End" visible="{view&gt;/canReadCosts}"><Label text="Periodenbeitrag"/><table:template><ObjectNumber number="{path:'view&gt;periodContribution',formatter:'.formatter.money'}"/></table:template></table:Column>
     </table:columns></table:Table>
     <Table items="{view&gt;/report/groups}" visible="{device&gt;/system/phone}"><columns><Column><Text text="Gruppe"/></Column><Column hAlign="End"><Text text="Nettoumsatz"/></Column><Column minScreenWidth="Tablet" demandPopin="true" visible="{view&gt;/canReadCosts}"><Text text="DB I Faktura / Warenaufwand"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;label}" press=".onGroup" enabled="{= ${view&gt;key} !== 'UNASSIGNED' }"/><ObjectNumber number="{path:'view&gt;netRevenue',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><VBox><ObjectNumber number="{path:'view&gt;billingMargin',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectNumber number="{path:'view&gt;stockExpense',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/></VBox></cells></ColumnListItem></items></Table>
     <MessageStrip text="Mehr als500 Gruppen vorhanden. Bitte Zeitraum oder Dimension weiter eingrenzen; die Gesamtsummen enthalten alle berechtigten Quellen." visible="{view&gt;/report/groupsTruncated}" type="Warning" showIcon="true"/>
    </VBox></Panel>
    <Panel headerText="Tatsächliche Belegpositionen" class="sapUiSmallMarginBottom"><VBox>
     <OverflowToolbar><Title text="Quellen mit Originalbezug" level="H3"/><ToolbarSpacer/><Text text="{= 'Ab Position ' + (${view&gt;/offset} + 1) + ' von ' + ${view&gt;/report/totalRows} }"/><Button text="Vorherige Seite" icon="sap-icon://navigation-left-arrow" press=".onPrevious" enabled="{= ${view&gt;/offset} &gt; 0 }"/><Button text="Nächste Seite" icon="sap-icon://navigation-right-arrow" press=".onNext" enabled="{view&gt;/report/hasMore}"/></OverflowToolbar>
     <Table id="reportSources" items="{view&gt;/report/rows}" noDataText="Keine gebuchten Quellen für die gewählten Filter vorhanden" sticky="ColumnHeaders"><columns>
      <Column width="11rem"><Text text="Beleg / Position"/></Column><Column minScreenWidth="Tablet" demandPopin="true" width="9rem"><Text text="Buchungsdatum"/></Column><Column><Text text="Kunde / Auftrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Artikel / Belegmenge"/></Column><Column hAlign="End" width="9rem"><Text text="Nettoumsatz"/></Column><Column hAlign="End" minScreenWidth="Desktop" demandPopin="true" visible="{view&gt;/canReadCosts}"><Text text="Warenwert Faktura"/></Column><Column hAlign="End" minScreenWidth="Desktop" demandPopin="true" visible="{view&gt;/canReadCosts}"><Text text="Warenaufwand"/></Column>
     </columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;documentNumber}" press=".onSource" enabled="{view&gt;canOpenSource}"/><Text text="{path:'view&gt;eventKind',formatter:'.formatter.reportEvent'}"/><Text text="{= 'Pos. ' + ${view&gt;position} }"/></VBox><VBox><Text text="{path:'view&gt;postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{path:'view&gt;documentDate',formatter:'.formatter.dateOnly'}" wrapping="false" tooltip="Belegdatum"/></VBox><VBox><Text text="{view&gt;partnerName}"/><Link text="{view&gt;orderNumber}" press=".onOrder" enabled="{view&gt;canOpenOrder}"/></VBox><VBox><ObjectIdentifier title="{view&gt;sku}" text="{view&gt;description}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/></VBox><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectNumber number="{path:'view&gt;billedCost',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/><ObjectNumber number="{path:'view&gt;stockExpense',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/></cells></ColumnListItem></items></Table>
    </VBox></Panel>
    <Panel headerText="Kennzahlendefinition und Quellenabdeckung" expandable="true" expanded="false"><form:SimpleForm layout="ResponsiveGridLayout" columnsXL="2" columnsL="2"><form:content><Label text="Nettoumsatz"/><Text text="{view&gt;/report/definitions/revenue}"/><Label text="DB I Faktura"/><Text text="{view&gt;/report/definitions/billingMargin}"/><Label text="Warenaufwand"/><Text text="{view&gt;/report/definitions/stockExpense}"/><Label text="Periodenbeitrag"/><Text text="{view&gt;/report/definitions/periodContribution}"/><Label text="Abdeckung"/><Text text="{view&gt;/report/definitions/coverage}"/><Label text="Datenstand"/><Text text="{path:'view&gt;/report/asOf',formatter:'.formatter.date'}"/></form:content></form:SimpleForm></Panel>
   </VBox>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
