<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
 <IconTabFilter text="Work Order Tasks" key="tasks" visible="{state&gt;/access/internal}"><Table items="{view&gt;/execution/tasks}" noDataText="Noch keine Aufgaben angelegt"><headerToolbar><OverflowToolbar><Title text="Aufgaben im Ticket"/><ToolbarSpacer/><Button text="Aufgabe anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewTask" visible="{view&gt;/execution/canRecord}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Aufgabe"/></Column><Column><Text text="Status / Serviceauftrag"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Korrelations-ID"/></Column><Column><Text text="Bearbeitung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Link text="{view&gt;orderNumber}" press=".onWorkOrder" visible="{= !!${view&gt;orderId} }"/><Link text="SRM anzeigen" press=".onWorkReport" visible="{= !!${view&gt;reportId} }"/></VBox><Text text="{view&gt;correlationId}" wrapping="true"/><VBox><Button text="Auftrag zuordnen" press=".onTaskOrder" visible="{= ${view&gt;canEdit} &amp;&amp; !${view&gt;orderId} }"/><Button text="Aufgabe verwerfen" press=".onCancelTask" visible="{view&gt;canEdit}"/><Button text="Aufgabe abschließen" type="Emphasized" press=".onCompleteTask" visible="{view&gt;canEdit}"/></VBox></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter text="Arbeits- &amp; Fahrzeiten" key="times" visible="{state&gt;/access/internal}"><VBox>
  <OverflowToolbar><Title text="Zeiten am Ticket"/><ToolbarSpacer/><Button text="Zeit starten" icon="sap-icon://media-play" press=".onStartTimer" visible="{view&gt;/execution/canRecord}" enabled="{= !${view&gt;/execution/timer} }"/><Button text="Zeit erfassen" icon="sap-icon://time-entry-request" press=".onManualTime" visible="{view&gt;/execution/canRecord}"/></OverflowToolbar>
  <Panel headerText="Aktiver Ticket-Timer" visible="{= !!${view&gt;/execution/timer} }"><content><VBox><Text text="{view&gt;/execution/timer/description}"/><ObjectStatus text="{= ${view&gt;/execution/timer/pausedAt} ? 'Pausiert' : 'Läuft' }" state="Information"/><Link text="Zum Ticket des Timers" press=".onTimerTicket"/><OverflowToolbar visible="{view&gt;/ownTimer}"><Button text="Pause" press=".onTimerAction" enabled="{= !${view&gt;/execution/timer/pausedAt} }"><customData><core:CustomData key="action" value="pause"/></customData></Button><Button text="Fortsetzen" press=".onTimerAction" enabled="{= !!${view&gt;/execution/timer/pausedAt} }"><customData><core:CustomData key="action" value="resume"/></customData></Button><Button text="Stoppen und buchen" type="Emphasized" press=".onTimerAction"><customData><core:CustomData key="action" value="stop"/></customData></Button><Button text="Timer verwerfen" press=".onTimerAction"><customData><core:CustomData key="action" value="discard"/></customData></Button></OverflowToolbar></VBox></content></Panel>
  <Table items="{view&gt;/execution/times}" noDataText="Noch keine Zeiten erfasst"><columns><Column><Text text="Tätigkeit / Aufgabe"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Art / Zeitraum"/></Column><Column hAlign="End"><Text text="Stunden"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status / Abrechnung"/></Column><Column><Text text="Übernahme"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;description}" text="{view&gt;number}"/><Text text="{view&gt;taskNumber}"/></VBox><VBox><ObjectStatus text="{= ${view&gt;category} === 'TRAVEL' ? 'Fahrzeit' : 'Arbeitszeit' }"/><Text text="{path:'view&gt;startedAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;endedAt',formatter:'.formatter.date'}"/><Text text="{= 'Pause: ' + ${view&gt;pauseSeconds} + ' s' }"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="HUR"/><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{= ${view&gt;billable} ? 'Abrechenbar' : 'Nicht abrechenbar' }"/></VBox><VBox><Link text="{view&gt;orderNumber}" press=".onWorkOrder" visible="{= !!${view&gt;orderId} }"/><Button text="An Auftrag übergeben" press=".onAllocateWork" visible="{view&gt;canAllocate}"/><Button text="Verwerfen" type="Transparent" press=".onVoidWork" visible="{view&gt;canEdit}"/></VBox></cells></ColumnListItem></items></Table>
 </VBox></IconTabFilter>
 <IconTabFilter text="Pauschalen &amp; Fahrtleistungen" key="charges" visible="{state&gt;/access/internal}"><Table items="{view&gt;/execution/charges}" noDataText="Noch keine Pauschalen oder Fahrtleistungen erfasst"><headerToolbar><OverflowToolbar><Title text="Weitere Leistungen am Ticket"/><ToolbarSpacer/><Button text="Pauschale erfassen" icon="sap-icon://add" press=".onCharge" visible="{view&gt;/execution/canRecord}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Leistung"/></Column><Column hAlign="End"><Text text="Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status"/></Column><Column><Text text="Übernahme"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;productName}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><VBox><Link text="{view&gt;orderNumber}" press=".onWorkOrder" visible="{= !!${view&gt;orderId} }"/><Button text="An Auftrag übergeben" press=".onAllocateWork" visible="{view&gt;canAllocate}"><customData><core:CustomData key="charge" value="true"/></customData></Button><Button text="Verwerfen" press=".onVoidWork" visible="{view&gt;canEdit}"><customData><core:CustomData key="charge" value="true"/></customData></Button></VBox></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter text="Materialausgaben" key="material" visible="{state&gt;/access/internal}"><Table items="{view&gt;/execution/materialIssues}" noDataText="Noch keine Materialausgaben zum Ticket"><headerToolbar><OverflowToolbar><Title text="Material aus Serviceaufträgen"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Materialbeleg / Lieferschein"/></Column><Column><Text text="Bewegung / Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Serviceauftrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aufgabe / Datum"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onMaterialIssue"/><Text text="{view&gt;deliveryNumber}"/></VBox><VBox><Text text="{path:'view&gt;movementType',formatter:'.formatter.movementType'}"/><ObjectStatus text="{= ${view&gt;reversalId} ? 'Zurückgenommen' : 'Gebucht' }"/></VBox><Link text="{view&gt;orderNumber}" press=".onWorkOrder"/><ObjectIdentifier title="{view&gt;taskNumber}" text="{view&gt;postingDate}"/></cells></ColumnListItem></items></Table></IconTabFilter>
</core:FragmentDefinition>
