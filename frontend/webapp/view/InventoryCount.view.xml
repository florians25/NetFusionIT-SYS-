<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.InventoryCount" height="100%"><uxap:ObjectPageLayout height="100%" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/document/title}"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="Inventur / kontrollierte Differenzbuchung"/><ObjectStatus text="{path:'view&gt;/document/status',formatter:'.formatter.status'}" state="{path:'view&gt;/document/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent><uxap:actions><Button text="Zählstand vorbereiten" press=".onPrepare" visible="{view&gt;/document/canPrepare}"/><Button text="Zur Prüfung einreichen" press=".onSubmit" visible="{view&gt;/document/canSubmit}"/><Button text="Differenz buchen" press=".onPost" visible="{view&gt;/document/canPost}"/><Button text="Freigabe zurückziehen" press=".onWithdraw" visible="{view&gt;/document/canWithdraw}"/><Button text="Abbrechen mit Grund" press=".onCancel" visible="{view&gt;/document/canCancel}"/><Button text="Gegenbewegung anlegen" press=".onReverse" visible="{view&gt;/document/canReverse}"/><Button text="Anlagenliste" press=".onAttachments" icon="sap-icon://attachment"/><Button text="Genehmigungen" press=".onWorkflow"/><Button text="Inventurarbeitsliste" press=".onInventoryCounts"/><Button icon="sap-icon://refresh" tooltip="Inventur aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><VBox width="100%" class="sapUiSmallMarginTop"><layout:Grid defaultSpan="XL3 L3 M6 S12"><VBox><Label text="Zähltag"/><Text text="{path:'view&gt;/document/countDay',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Buchungsdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox><Label text="Erfassungen"/><ObjectNumber number="{view&gt;/summary/total}" unit="Positionen"/><ObjectStatus text="{= ${view&gt;/summary/remaining} + ' Mengen noch offen · ' + ${view&gt;/summary/empty} + ' Leerprüfungen offen' }" state="Warning"/></VBox><VBox><Label text="Differenz- / Finanzbeleg"/><Text text="{view&gt;/document/correctionNumber}"/><Link text="Finanzbeleg öffnen" press=".onJournal" visible="{= !!${view&gt;/document/journalId} }"/><Label text="Kostenstelle" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/costCenter}"/></VBox><VBox><Label text="Quellen / Gegenbewegung"/><Link text="Ursprungsinventur öffnen" press=".onOriginal" visible="{= !!${view&gt;/document/reversesId} }"/><Link text="{view&gt;/document/reversal/number}" press=".onReversal" visible="{= !!${view&gt;/document/reversal} }"/><Label text="Zählgrund" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/reason}"/></VBox></layout:Grid><MessageStrip text="{= ${view&gt;/document/status} === 'POSTED' ? 'Inventur abgeschlossen. Originalerfassungen, Vorbereitung und unabhängige Prüfung bleiben erhalten.' : ${view&gt;/document/status} === 'CANCELLED' ? 'Inventur begründet abgebrochen; Fachsperren aufgehoben. Keine Differenz gebucht.' : 'Fächer sind bis zur Buchung oder zum begründeten Abbruch gesperrt. Sollmengen sind keine bestätigten Zählmengen.' }" showIcon="true" class="sapUiSmallMarginTop"/></VBox></uxap:headerContent><uxap:sections><uxap:ObjectPageSection title="Zählpositionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><OverflowToolbar><Label text="Zählidentität scannen" labelFor="countScan"/><Select width="9rem" selectedKey="{view&gt;/scanKind}"><core:Item key="BIN" text="Lagerfach"/><core:Item key="PRODUCT" text="Artikel"/></Select><Input id="countScan" value="{view&gt;/scanValue}" placeholder="Barcode scannen und Enter" submit=".onScan" width="18rem"/><Button text="Identität prüfen" press=".onScan"/><Button text="Alle Positionen" press=".onClearScan"/></OverflowToolbar><ObjectStatus text="{view&gt;/scanResult}" state="Information"/><Table id="countLines" items="{view&gt;/document/lines}" noDataText="Keine Einträge vorhanden."><headerToolbar><OverflowToolbar><Title text="Tatsächliche Zählmengen"/><ToolbarSpacer/><Button text="Gefundenen Artikel ergänzen" press=".onAdd" visible="{view&gt;/document/canCount}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Artikel / Position"/></Column><Column><Text text="Lagerfach / Tracking"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Sollmenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Tatsächlich gezählt"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Geprüfte Differenz / Wert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Erfassung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;product/name}" text="{= ${view&gt;position} + ' · ' + ${view&gt;product/sku} }"/><VBox><Text text="{view&gt;place/code}"/><Text text="{view&gt;batch}"/><Text text="{view&gt;serial}"/></VBox><Text text="{path:'view&gt;expectedQuantity',formatter:'.formatter.decimal'}"/><Text text="{path:'view&gt;countedQuantity',formatter:'.counted'}"/><VBox><Text text="{path:'view&gt;delta',formatter:'.counted'}"/><ObjectNumber number="{path:'view&gt;value',formatter:'.countMoney'}" unit="{view&gt;/document/preparedSnapshot/currency}" emphasized="false"/></VBox><Button text="Menge erfassen" press=".onCapture" visible="{view&gt;/document/canCount}"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Zählumfang &amp; Fachsperren"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><Table items="{view&gt;/document/scopes}" noDataText="Keine Einträge vorhanden." id="presentationTable2"><columns><Column><Text text="Werk / Lagerort"/></Column><Column><Text text="Lagerfach"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Leerprüfung / Positionen"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Sperre"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><Text text="{= ${view&gt;snapshot/plantCode} + ' / ' + ${view&gt;snapshot/locationCode} }"/><ObjectIdentifier title="{view&gt;snapshot/code}" text="{view&gt;snapshot/name}"/><Text text="{= ${view&gt;hasLines} ? 'Einzeln je Zählposition' : ${view&gt;emptyConfirmedAt} ? 'Leer bestätigt' : 'Leerprüfung offen' }"/><ObjectStatus text="{= ${view&gt;releasedAt} ? 'Aufgehoben' : 'Für Inventur gesperrt' }" state="{= ${view&gt;releasedAt} ? 'Success' : 'Warning' }"/><Button text="Leer bestätigen" press=".onEmpty" visible="{= ${view&gt;/document/canCount} &amp;&amp; !${view&gt;hasLines} }"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Bewertung &amp; Kontierung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Bewertet wird mit dem gebundenen Unternehmensbestand. Reservierungen müssen am Serviceauftrag geklärt werden. Eine reine Fachzuordnung erzeugt keinen Gewinn oder Verlust." showIcon="true"/><Table items="{view&gt;/valuation}" noDataText="Noch kein vollständig vorbereiteter Bewertungsstand." id="presentationTable3"><columns><Column><Text text="Artikel / Bewertungsgrundlage"/></Column><Column><Text text="Mengendifferenz"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Wertdifferenz"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><Label text="Unternehmensmenge"/><ObjectNumber number="{path:'v