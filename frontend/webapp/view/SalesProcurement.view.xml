<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:t="sap.ui.table" xmlns:rm="sap.ui.table.rowmodes" controllerName="netfusion.erp.controller.SalesProcurement" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/order/title}" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/order/number}" text="Vertriebsbeschaffung · direkte AU-Kontierung"/></uxap:expandedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Beschaffungsarbeitsvorrat" press=".onWorklist"/><Button icon="sap-icon://refresh" tooltip="AU-Versorgung aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
 <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Kundenbestellreferenz"/><Title text="{view&gt;/order/customerReference}"/><Text text="{view&gt;/order/currency}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Einteilungen / offener Bedarf"/><ObjectNumber number="{view&gt;/order/summary/positions}"/><ObjectNumber number="{view&gt;/order/summary/uncovered}" unit="ungedeckt"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Einteilungen mit Fehlmenge"/><ObjectNumber number="{view&gt;/order/summary/shortages}" state="Warning"/></VBox><VBox><Label text="Aktive Beschaffungsbelege"/><ObjectNumber number="{view&gt;/order/summary/requisitions}" unit="BANF"/><ObjectNumber number="{view&gt;/order/summary/purchases}" unit="Bestellungen"/></VBox></HBox></uxap:headerContent>
 <uxap:sections><uxap:ObjectPageSection title="Materialbedarf"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Lager nutzen reserviert tatsächlich freien Bestand. Teile bestellen nutzt zuerst vorhandene Ware und gibt nur die verbleibende Fehlmenge als BANF in die unabhängige Prüfung." showIcon="true" type="Information" class="sapUiSmallMarginBottom"/><OverflowToolbar><Title text="Versorgung je AU-Position und Einteilung"/><ToolbarSpacer/><SearchField width="16rem" placeholder="Artikel oder Kurztext" liveChange=".onSearch"/><Button text="Lager nutzen" icon="sap-icon://inventory" press=".onUseStock" visible="{view&gt;/order/canPlan}"/><Button text="Teile bestellen" icon="sap-icon://cart" type="Emphasized" press=".onRequestParts" visible="{view&gt;/order/canPlan}"/></OverflowToolbar>
 <t:Table id="salesProcurementGrid" rows="{view&gt;/order/items}" selectionMode="MultiToggle" selectionBehavior="RowSelector" enableSelectAll="true" visible="{= !${device&gt;/system/phone} }"><t:rowMode><rm:Fixed rowCount="{view&gt;/gridRows}"/></t:rowMode><t:columns>
 <t:Column width="6rem"><Label text="Pos. / Einteilung"/><t:template><Text text="{= ${view&gt;position} + ' / ' + ${view&gt;schedulePosition} }"/></t:template></t:Column><t:Column width="10rem"><Label text="Artikel"/><t:template><Text text="{view&gt;sku}"/></t:template></t:Column><t:Column width="22rem"><Label text="Kurztext"/><t:template><Text text="{view&gt;description}" wrapping="false"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Bedarf"/><t:template><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Reserviert"/><t:template><ObjectNumber number="{path:'view&gt;reserved',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Frei verfügbar"/><t:template><ObjectNumber number="{path:'view&gt;available',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Fehlmenge"/><t:template><ObjectNumber number="{path:'view&gt;shortage',formatter:'.formatter.decimal'}" state="Warning"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Angefordert"/><t:template><ObjectNumber number="{path:'view&gt;requested',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Bestellt"/><t:template><ObjectNumber number="{path:'view&gt;ordered',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="9rem"><Label text="Bedarfstermin"/><t:template><Text text="{path:'view&gt;neededOn',formatter:'.formatter.dateOnly'}"/></t:template></t:Column><t:Column width="13rem"><Label text="Versorgungsstatus"/><t:template><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.supplyStatus'}"/></t:template></t:Column><t:Column width="15rem"><Label text="Kostenstelle / Kostenträger"/><t:template><Text text="{= ${view&gt;costCenter} + ' / ' + ${view&gt;costObject} }"/></t:template></t:Column>
 <t:Column width="9rem" hAlign="End"><Label text="WE netto"/><t:template><ObjectNumber number="{path:'view&gt;received',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="9rem" hAlign="End"><Label text="Beschaffung offen"/><t:template><ObjectNumber number="{path:'view&gt;openProcurement',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="9rem" hAlign="End"><Label text="Geliefert"/><t:template><ObjectNumber number="{path:'view&gt;delivered',formatter:'.formatter.decimal'}"/></t:template></t:Column></t:columns></t:Table>
 <Table id="salesProcurementMobile" items="{view&gt;/order/items}" mode="MultiSelect" visible="{device&gt;/system/phone}"><columns><Column><Text text="AU-Position / Artikel"/></Column><Column hAlign="End"><Text text="Bedarf"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Reserviert / angefordert / bestellt"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bedarfstermin / Status"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><HBox><Text text="Reserviert:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;reserved',formatter:'.formatter.decimal'}"/></HBox><HBox><Text text="Angefordert:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;requested',formatter:'.formatter.decimal'}"/></HBox><HBox><Text text="Bestellt:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;ordered',formatter:'.formatter.decimal'}"/></HBox><HBox><Text text="WE netto:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;received',formatter:'.formatter.decimal'}"/></HBox><HBox><Text text="Beschaffung offen:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;openProcurement',formatter:'.formatter.decimal'}"/></HBox><HBox><Text text="Geliefert:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{path:'view&gt;delivered',formatter:'.formatter.decimal'}"/></HBox></VBox><VBox><Text text="{path:'view&gt;neededOn',formatter:'.formatter.dateOnly'}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.supplyStatus'}"/></VBox></cells></ColumnListItem></items></Table>
 </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Beschaffungsbelege"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/order/documents}" itemPress=".onDocumentOpen"><columns><Column><Text text="Beleg / Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Belegart"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;title}"/><Text text="{path:'view&gt;kind',formatter:'.formatter.procurementKind'}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections></uxap:ObjectPageLayout>
</mvc:View>
