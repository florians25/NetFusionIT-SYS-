<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" controllerName="netfusion.erp.controller.Procurement" height="100%" displayBlock="true"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" enableLazyLoading="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/document/title}" titleStyle="H2" wrapping="true"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="{path:'view&gt;/document/kind',formatter:'.formatter.procurementKind'}"/><ObjectStatus text="{path:'view&gt;/document/status',formatter:'.formatter.status'}" state="{path:'view&gt;/document/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent><uxap:snappedContent><ObjectStatus text="{path:'view&gt;/document/status',formatter:'.formatter.status'}"/></uxap:snappedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Wareneingang buchen" type="Emphasized" press=".onReceive" visible="{view&gt;/canReceive}"/><Button text="{= ${view&gt;/document/orderKind} === 'SALES_ORDER' ? 'Zum Kundenauftrag' : 'Zum Serviceauftrag' }" press=".onOrder"/><Button text="Einreichen" type="Emphasized" press=".onSubmit" visible="{view&gt;/canSubmit}"/><Button text="BANF anlegen" type="Emphasized" press=".onNewRequisition" visible="{view&gt;/canRequisition}"/><Button text="Bestellung anlegen" type="Emphasized" press=".onNewPurchase" visible="{view&gt;/canPurchase}"/><Button text="Beleg verwerfen" press=".onCancel" visible="{view&gt;/canCancel}"/><Button icon="sap-icon://refresh" tooltip="Beschaffungsbeleg aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="{= ${view&gt;/document/orderKind} === 'SALES_ORDER' ? 'Kundenauftrag' : 'Serviceauftrag' }"/><Link text="{view&gt;/document/orderNumber}" press=".onOrder"/></VBox><VBox class="sapUiLargeMarginEnd" visible="{= !!${view&gt;/document/supplier} }"><Label text="Lieferant"/><Title text="{view&gt;/document/supplier/name}" titleStyle="H4"/><Text text="{view&gt;/document/supplier/street}"/><Text text="{= (${view&gt;/document/supplier/postalCode} || '') + ' ' + (${view&gt;/document/supplier/city} || '') }"/></VBox><VBox visible="{= !!${view&gt;/document/totalNet} }"><Label text="Bestellwert netto"/><ObjectNumber number="{parts:[{path:'view&gt;/document/totalNet'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/></VBox></HBox></uxap:headerContent><uxap:sections>
