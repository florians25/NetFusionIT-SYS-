lumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
