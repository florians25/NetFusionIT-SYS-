<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" controllerName="netfusion.erp.controller.Dispatch"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Service-Disposition"/></f:heading><f:actions><Button text="Einsatzplanung" icon="sap-icon://appointment-2" press=".onPlanning"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Ohne Techniker"/><ObjectNumber number="{view&gt;/dashboard/unassigned}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Hohe / kritische Priorität"/><ObjectNumber number="{view&gt;/dashboard/critical}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="In Bearbeitung"/><ObjectNumber number="{view&gt;/dashboard/inProgress}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Wartende Tickets"/><ObjectNumber number="{view&gt;/dashboard/waiting}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Aktive Techniker"/><ObjectNumber number="{= ${view&gt;/technicians}.length }"/></VBox></HBox></f:DynamicPageHeader></f:header><f:content><VBox>
  <Breadcrumbs currentLocationText="Dispatching"><Link text="App-Zentrale" press=".onHome"/></Breadcrumbs>
  <Title text="Techniker" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
  <FlexBox items="{view&gt;/technicians}" wrap="Wrap" class="sapUiSmallMarginBottom"><items><VBox class="sapUiContentPadding sapUiTinyMarginEnd sapUiTinyMarginBottom"><HBox alignItems="Center"><Avatar initials="{path:'view&gt;name',formatter:'.formatter.initials'}" displaySize="S" backgroundColor="Accent6"/><VBox class="sapUiSmallMarginBegin"><Title text="{view&gt;name}" titleStyle="H4"/><ObjectStatus text="Aktiver Techniker" state="Success"/></VBox></HBox><HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop"><Label text="Offene Zuordnungen"/><ObjectNumber number="{view&gt;assignedCount}"/></HBox><Text text="Zuordnung ohne Termin- oder Kapazitätsprüfung" class="sapUiSmallMarginTop"/></VBox></items></FlexBox>
  <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginTop sapUiSmallMarginBottom"><Title text="Noch nicht zugewiesen" titleStyle="H3"/><ObjectStatus text="{= ${view&gt;/dashboard/unassigned} + ' Tickets' }" state="Information"/></HBox>
  <Table id="dispatchTable" items="{path:'/Tickets',parameters:{$count:true,$orderby:'createdAt asc'}}" growing="true" growingThreshold="20" itemPress=".onTicketPress" noDataText="Alle offenen Anfragen sind zugewiesen." ><columns><Column><Text text="Ticket / Betreff"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kunde"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Eingang / Servicefall"/></Column><Column><Text text="Priorität"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{title}" text="{number}"/><Text text="{partnerName}"/><VBox><Text text="{path:'createdAt',formatter:'.formatter.date'}"/><Text text="{caseNumber}"/></VBox><ObjectStatus text="{path:'priority',formatter:'.formatter.priority'}" state="{path:'priority',formatter:'.formatter.priorityState'}"/><ObjectStatus text="{path:'status',formatter:'.formatter.status'}" state="{path:'status',formatter:'.formatter.statusState'}"/></cells></ColumnListItem></items></Table>
  <Button text="Einsatzplanung öffnen" icon="sap-icon://appointment-2" press=".onPlanning" class="sapUiMediumMarginTop"/><MessageStrip text="Öffnen Sie ein Ticket, um einen Techniker zuzuweisen. Für Termine mit Arbeitszeit- und Kollisionsprüfung öffnen Sie die Einsatzplanung." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
</VBox></f:content></f:DynamicPage></mvc:View>
