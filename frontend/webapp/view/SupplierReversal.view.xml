<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.SupplierReversal" displayBlock="true">
 <f:DynamicPage fitContent="false" headerExpanded="true">
  <f:title><f:DynamicPageTitle><f:heading><ObjectIdentifier title="{view&gt;/number}" text="Storno zur Eingangsrechnung"/></f:heading><f:actions>
   <Button text="Prüfstand vorbereiten" press=".onPrepare" visible="{view&gt;/canPrepare}"/>
   <Button text="Zur Freigabe einreichen" press=".onSubmit" visible="{view&gt;/canSubmit}"/>
   <Button text="Freigabe zurückziehen" press=".onWithdraw" visible="{view&gt;/canWithdraw}"/>
   <Button text="Storno buchen" icon="sap-icon://undo" type="Emphasized" press=".onPost" visible="{view&gt;/canPost}"/>
   <Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/>
   <Button icon="sap-icon://refresh" tooltip="Stornobeleg aktualisieren" press=".load"/>
  </f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><FlexBox wrap="Wrap" alignItems="Start">
   <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Ursprungsrechnung"/><Link text="{view&gt;/invoiceNumber}" press=".onInvoice"/><Text text="{view&gt;/externalNumber}"/><Text text="{view&gt;/supplierName}"/></VBox>
   <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Stornofreigabe"/><ObjectStatus text="{path:'view&gt;/status',formatter:'.formatter.status'}" state="{path:'view&gt;/status',formatter:'.formatter.statusState'}"/><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox>
   <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom"><Label text="Gegenbuchung netto / Steuer"/><ObjectNumber number="{path:'view&gt;/net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><ObjectNumber number="{path:'view&gt;/tax',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox>
   <VBox class="sapUiSmallMarginBottom"><Label text="Aufzuhebende Verbindlichkeit"/><ObjectNumber number="{path:'view&gt;/gross',formatter:'.formatter.money'}" unit="{view&gt;/currency}" emphasized="true"/><ObjectStatus text="{= ${view&gt;/status} === 'POSTED' ? 'Gegengebucht · offener Rest 0,00' : 'Ursprünglicher Posten bleibt wirksam' }" state="{= ${view&gt;/status} === 'POSTED' ? 'Success' : 'Warning' }"/></VBox>
  </FlexBox></f:DynamicPageHeader></f:header>
  <f:content><VBox class="sapUiContentPadding">
   <MessageStrip text="{= ${view&gt;/status} === 'POSTED' ? 'Die ursprünglichen Finanzpositionen sind vollständig gegengebucht. Der Kreditorenrest beträgt null; die ursprüngliche WE-Verrechnung ist freigegeben. Originalrechnung, frühere Buchungen und Anhänge bleiben erhalten.' : 'Der Stornoantrag verändert noch keine Buchung. Erst unabhängige Freigabe und tatsächliche Gegenbuchung heben den Kreditorenrest und die ursprüngliche WE-Verrechnung auf.' }" showIcon="true" class="sapUiSmallMarginBottom"/>
   <IconTabBar expandable="false"><items>
    <IconTabFilter text="Gegenkontierung" key="accounting"><form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content>
     <core:Title text="Stornobegründung"/><Label text="Grund"/><Text text="{view&gt;/reason}"/><Label text="Belegdatum"/><Text text="{path:'view&gt;/documentDate',formatter:'.formatter.dateOnly'}" wrapping="false"/>
     <core:Title text="Unabhängige Prüfung"/><Label text="Vorbereitet von"/><Text text="{view&gt;/preparedByName}"/><Label text="Vorbereitet am"/><Text text="{path:'view&gt;/preparedAt',formatter:'.formatter.date'}"/><Label text="Freigegeben von"/><Text text="{view&gt;/reviewedByName}"/><Label text="Prüfbegründung"/><Text text="{view&gt;/reviewNote}"/>
     <core:Title text="Finanzbelege"/><Label text="Ursprüngliche FI"/><Link text="{view&gt;/sourceJournal/number}" press=".onOriginalJournal" enabled="{state&gt;/access/financeRead}"/><Label text="Gegen-FI"/><Link text="{view&gt;/journal/number}" press=".onCounterJournal" enabled="{state&gt;/access/financeRead}"/><Label text="Gegengebucht am"/><Text text="{path:'view&gt;/postedAt',formatter:'.formatter.date'}"/>
    </form:content></form:SimpleForm>
     <Table id="counterLines" items="{view&gt;/lines}"><headerToolbar><Toolbar><Title text="Ursprüngliche Kontierung und vollständige Gegenbuchung" level="H3"/></Toolbar></headerToolbar><columns>
      <Column width="5rem"><Text text="Konto"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kontobezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Ursprünglich"/></Column><Column width="6rem"><Text text="Storno" wrapping="false"/></Column><Column hAlign="End"><Text text="Betrag"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Steuerzuordnung"/></Column>
     </columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><ObjectIdentifier title="{view&gt;name}" text="{view&gt;description}"/><Text text="{= ${view&gt;side} === 'DEBIT' ? 'Soll' : 'Haben' }"/><Text text="{= ${view&gt;counterSide} === 'DEBIT' ? 'Soll' : 'Haben' }"/><ObjectNumber number="{path:'view&gt;amount',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><Text text="{view&gt;taxCode}"/></cells></ColumnListItem></items></Table>
    </IconTabFilter>
    <IconTabFilter text="Freigabehistorie" key="history" count="{= ${view&gt;/decisions}.length }"><Table items="{view&gt;/decisions}" noDataText="Noch keine unabhängige Entscheidung vorhanden"><columns><Column><Text text="Entscheidung"/></Column><Column><Text text="Verantwortlich"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zeitpunkt"/></Column><Column><Text text="Begründung"/></Column></columns><items><ColumnListItem><cells><Text text="{path:'view&gt;decision',formatter:'.formatter.approvalDecision'}"/><Text text="{view&gt;actorName}"/><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/><Text text="{view&gt;comment}"/></cells></ColumnListItem></items></Table></IconTabFilter>
    <IconTabFilter text="Originalnachweis" key="original"><form:SimpleForm editable="false" layout="ResponsiveGridLayout"><form:content><Label text="Eingangsrechnung"/><Link text="{view&gt;/invoiceNumber}" press=".onInvoice"/><Label text="Lieferantenbeleg"/><Text text="{view&gt;/externalNumber}"/><Label text="Original SHA-256"/><Text text="{view&gt;/preparedSnapshot/invoiceSnapshot/originalSha256}"/><Label text="Ursprünglicher Finanzhash"/><Text text="{view&gt;/sourceJournal/hash}"/></form:content></form:SimpleForm><MessageStrip text="Der eigene SB-Beleg dokumentiert eine interne Rechnungskorrektur. Lieferantengutschriften, Zahlungen und physische Lagergegenbewegungen sind eigene Vorgänge." showIcon="true"/></IconTabFilter>
   <IconTabFilter text="Belegfluss" key="flow"><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></IconTabFilter></items></IconTabBar>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
