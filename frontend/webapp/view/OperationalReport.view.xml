<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.OperationalReport" displayBlock="true"><f:DynamicPage id="operationalReportPage" fitContent="false"><f:title><f:DynamicPageTitle><f:heading><Title text="{view&gt;/definition/title}"/></f:heading><f:actions><Button text="CSV exportieren" icon="sap-icon://download" press=".onExport" enabled="{view&gt;/hasData}"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".onApply" enabled="{= !!${view&gt;/filters/companyId} }"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><form:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Auswahl und Zeitraum"/><Label text="Buchungskreis"/><Select width="100%" selectedKey="{view&gt;/filters/companyId}" items="{view&gt;/companies}"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} + ' · ' + ${view&gt;currency} }"/></Select><Label text="Belegdatum von" visible="{= ${view&gt;/kind} !== 'AGING' }"/><DatePicker id="reportFrom" value="{view&gt;/filters/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%" visible="{= ${view&gt;/kind} !== 'AGING' }"/><Label text="Belegdatum bis" visible="{= ${view&gt;/kind} !== 'AGING' }"/><DatePicker id="reportTo" value="{view&gt;/filters/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%" visible="{= ${view&gt;/kind} !== 'AGING' }"/><core:Title text="Stichtag und Berichtsumfang"/><Label text="Datenbasis" visible="{= ${view&gt;/kind} === 'ORDERS' }"/><Text text="Aktuelle Auftrags- und Lieferstände; Vorrat nach Anforderungsdatum. Die Datumsfilter bilden die jeweilige Belegkohorte." visible="{= ${view&gt;/kind} === 'ORDERS' }"/><Label text="Buchungsstichtag / Gültigkeit" visible="{= ${view&gt;/kind} !== 'ORDERS' }"/><DatePicker id="reportAsOf" value="{view&gt;/filters/asOf}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%" visible="{= ${view&gt;/kind} !== 'ORDERS' }"/><Label text="Kontoart" visible="{= ${view&gt;/kind} === 'AGING' }"/><Select width="100%" selectedKey="{view&gt;/filters/side}" visible="{= ${view&gt;/kind} === 'AGING' }"><core:Item key="ALL" text="Debitoren und Kreditoren getrennt"/><core:Item key="AR" text="Debitoren"/><core:Item key="AP" text="Kreditoren"/></Select><core:Title text="Persönliche Berichtsvarianten"/><Label text="Gespeicherte Auswahl"/><Select id="reportVariant" width="100%" selectedKey="{view&gt;/variantId}" change=".onVariant" items="{view&gt;/variants}"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select></form:content></form:SimpleForm><OverflowToolbar><Button text="Angezeigte Auswahl speichern" press=".onSaveVariant" enabled="{view&gt;/hasData}"/><Button text="Variante löschen" press=".onDeleteVariant" enabled="{= !!${view&gt;/variantId} }"/><ToolbarSpacer/><Button text="Bericht anzeigen" press=".onApply" type="Emphasized" enabled="{= !!${view&gt;/filters/companyId} }"/></OverflowToolbar></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiContentPadding"><MessageStrip text="Zuerst einen Buchungskreis konfigurieren, um tatsächliche Geschäftsquellen auszuwerten." visible="{= !${view&gt;/filters/companyId} }" showIcon="true"/><MessageStrip text="{view&gt;/definition/scope}" type="Information" showIcon="true" class="sapUiSmallMarginBottom"/><VBox visible="{view&gt;/hasData}"><FlexBox wrap="Wrap" items="{view&gt;/metrics}"><items><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="{view&gt;label}"/><ObjectNumber number="{path:'view&gt;value',formatter:'.formatter.money'}" unit="{view&gt;/report/company/currency}"/></VBox></items></FlexBox><FlexBox wrap="Wrap" visible="{= ${view&gt;/kind} === 'PIPELINE' }"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Angebote in der Kohorte"/><ObjectNumber number="{view&gt;/report/summary/quoteCount}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Entschiedene Positionen"/><ObjectNumber number="{view&gt;/report/summary/decidedPositions}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Annahmequote nach Wert"/><ObjectNumber number="{path:'view&gt;/report/summary/acceptancePercent',formatter:'.formatter.money'}" unit="%"/></VBox></FlexBox><Panel headerText="Altersklassen je Kontoart" visible="{= ${view&gt;/kind} === 'AGING' }"><Table items="{view&gt;/report/agingBySide}"><columns><Column><Text text="Kontoart"/></Column><Column hAlign="End"><Text text="Nicht fällig"/></Column><Column hAlign="End"><Text text="1–30 Tage"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="31–60 Tage"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="61–90 Tage"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Über90 Tage"/></Column></columns><items><ColumnListItem><cells><Text text="{= ${view&gt;side} === 'AR' ? 'Debitoren' : 'Kreditoren' }"/><ObjectNumber number="{path:'view&gt;current',formatter:'.formatter.money'}"/><ObjectNumber number="{path:'view&gt;days30',formatter:'.formatter.money'}"/><ObjectNumber number="{path:'view&gt;days60',formatter:'.formatter.money'}"/><ObjectNumber number="{path:'view&gt;days90',formatter:'.formatter.money'}"/><ObjectNumber number="{path:'view&gt;over90',formatter:'.formatter.money'}"/></cells></ColumnListItem></items></Table></Panel><OverflowToolbar><Title text="Tatsächliche Belegquellen"/><ToolbarSpacer/><Text text="{= 'Ab Zeile ' + (${view&gt;/offset} + 1) + ' von ' + ${view&gt;/report/summary/count} }"/><Button text="Zurück" icon="sap-icon://navigation-left-arrow" press=".onPrevious" enabled="{= ${view&gt;/offset} &gt; 0 }"/><Button text="Weiter" icon="sap-icon://navigation-right-arrow" press=".onNext" enabled="{view&gt;/report/hasMore}"/></OverflowToolbar><VBox id="sourceTableHost" width="100%"/><Label text="Datenstand" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/report/asOf',formatter:'.formatter.date'}"/></VBox></VBox></f:content></f:DynamicPage></mvc:View>
