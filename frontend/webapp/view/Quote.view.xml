   <uxap:ObjectPageSection title="Kundenentscheidung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><form:SimpleForm layout="ResponsiveGridLayout" columnsL="2" editable="false"><Label text="Bereitgestelltes Original"/><Link text="{view&gt;/order/publishedDocument/filename}" href="{view&gt;/order/publishedDocument/url}" target="_blank"/><Label text="Bereitgestellt am"/><Text text="{path:'view&gt;/order/publishedAt',formatter:'.formatter.date'}"/><Label text="Annahmefrist bis"/><Text text="{path:'view&gt;/order/validUntil',formatter:'.formatter.dateOnly'}" wrapping="false"/><Label text="Entschieden von"/><Text text="{view&gt;/order/customerDecision/actorName}"/><Label text="Zeitpunkt der Entscheidung"/><Text text="{path:'view&gt;/order/customerDecision/at',formatter:'.formatter.date'}"/><Label text="Kundenbestellreferenz"/><Text text="{view&gt;/order/customerDecision/customerReference}"/><Label text="Erläuterung"/><Text text="{view&gt;/order/customerDecision/comment}"/></form:SimpleForm><Table items="{view&gt;/decisions}" noDataText="Noch keine verbindliche Kundenentscheidung."><columns><Column><Text text="Position"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Entscheidung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Begründung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;position}"/><ObjectStatus text="{= ${view&gt;decision} === 'ACCEPT' ? 'Angenommen' : 'Abgelehnt' }" state="{= ${view&gt;decision} === 'ACCEPT' ? 'Success' : 'Warning' }"/><Text text="{view&gt;reason}"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
