<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout" controllerName="netfusion.erp.controller.InventoryCounts" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Inventuren &amp; Differenzprüfung"/></f:heading><f:expandedContent><ObjectStatus text="Tatsächliche Bestände je Lagerfach" icon="sap-icon://inventory" state="Information"/></f:expandedContent><f:actions><Button text="Inventur beginnen" type="Emphasized" press=".onCreate" visible="{state&gt;/access/inventoryWrite}"/><Button text="Lagerarbeitsplatz" press=".onWarehouse"/><Button icon="sap-icon://refresh" tooltip="Inventuren aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><layout:Grid defaultSpan="XL3 L3 M6 S12"><VBox><Label text="Buchungskreis" labelFor="countCompany"/><Select id="countCompany" width="100%" selectedKey="{view&gt;/companyId}" items="{view&gt;/companies}" change=".load"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} }"/></Select></VBox><VBox><Label text="Offene Zählvorgänge"/><ObjectNumber number="{view&gt;/summary/open}" unit="Inventuren"/></VBox><VBox><Label text="Differenzprüfung / Freigabe"/><ObjectNumber number="{view&gt;/summary/review}" unit="Inventuren" state="Warning"/></VBox><VBox><Label text="Abgeschlossen gebucht"/><ObjectNumber number="{view&gt;/summary/posted}" unit="Inventuren" state="Success"/></VBox></layout:Grid></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiSmallMargin"><MessageStrip text="Der Zählbeginn sperrt die gewählten Fächer für Lagerbewegungen. Mengen einschließlich 0 und leere Fächer ausdrücklich bestätigen; Differenzen unabhängig freigeben lassen." showIcon="true"/><Table id="inventoryCountList" items="{view&gt;/counts}" growing="true" noDataText="Noch keine Inventur in diesem Buchungskreis." itemPress=".onOpen" class="sapUiSmallMarginTop"><headerToolbar><OverflowToolbar><Title text="Inventurvorgänge"/><ToolbarSpacer/><SearchField width="16rem" placeholder="Nummer oder Bezeichnung" search=".onWorklistFilter" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="inventoryCountList"/><core:CustomData key="fields" value="number,title,correctionNumber"/></customData></SearchField></OverflowToolbar></headerToolbar><columns><Column><Text text="Inventur / Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zähltag"/></Column><Column><Text text="Status"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Positionen / Offen"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Korrekturbeleg"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><Text text="{path:'view&gt;countDay',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{= ${view&gt;positions} + ' / ' + ${view&gt;remaining} }"/><Text text="{view&gt;correctionNumber}"/></cells></ColumnListItem></items></Table></VBox></f:content></f:DynamicPage></mvc:View>
