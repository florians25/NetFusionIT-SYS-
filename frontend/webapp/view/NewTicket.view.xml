<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.NewTicket">
  <Page showHeader="false" class="sapUiResponsiveContentPadding" showFooter="true"><content><VBox>
    <Breadcrumbs currentLocationText="Ticket anlegen"><Link text="App-Zentrale" press=".onHome"/><Link text="Tickets" press=".onTickets"/></Breadcrumbs>
    <VBox class="sapUiMediumMarginTop sapUiMediumMarginBottom"><Text text="NEUE SERVICEANFRAGE" /><Title text="Wie können wir helfen?" titleStyle="H2"/><Text text="Beschreiben Sie Ihr Anliegen. Ticket und Servicefall werden gemeinsam angelegt." class="sapUiTinyMarginTop"/></VBox>
    <MessageStrip text="{view&gt;/error}" type="Error" showIcon="true" visible="{= !!${view&gt;/error} }" class="sapUiSmallMarginBottom"/>
    <Panel headerText="Allgemeine Informationen" class="sapUiNoMargin">
      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" columnsXL="2" columnsL="2" columnsM="1">
        <core:Title text="Kunde und Servicebezug"/>
        <Label text="Kunde" required="true" labelFor="partner"/><Select id="partner" change=".onPartnerChange" selectedKey="{view&gt;/partnerId}" items="{view&gt;/partners}" width="100%" enabled="{= !${state&gt;/access/customer} }"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select>
        <Label text="Technisches Objekt" labelFor="technicalObject"/><Select id="technicalObject" change=".onContextChange" selectedKey="{view&gt;/technicalObjectId}" items="{view&gt;/assets}" width="100%"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select>
        <Label text="Servicevertrag" labelFor="contract"/><Select id="contract" change=".onContextChange" selectedKey="{view&gt;/contractId}" items="{view&gt;/contracts}" width="100%"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select>
        <core:Title text="Anliegen und Priorität"/>
        <Label text="Betreff" required="true" labelFor="title"/><Input id="title" value="{view&gt;/title}" placeholder="z. B. VPN-Verbindung am Standort nicht möglich" maxLength="160"/>
        <Label text="Anfrageart" labelFor="type"/><Select id="type" selectedKey="{view&gt;/type}" width="100%"><core:Item key="INCIDENT" text="Störung"/><core:Item key="SERVICE_REQUEST" text="Serviceanfrage"/><core:Item key="PROBLEM" text="Problem"/><core:Item key="CHANGE" text="Änderung"/><core:Item key="MAINTENANCE" text="Wartung"/><core:Item key="REPAIR" text="Reparatur"/><core:Item key="INSTALLATION" text="Installation"/><core:Item key="COMPLAINT" text="Reklamation"/><core:Item key="WARRANTY" text="Garantie"/><core:Item key="INTERNAL" text="Interner IT-Auftrag"/></Select>
        <Label text="Priorität" labelFor="priority"/><Select id="priority" selectedKey="{view&gt;/priority}" width="100%"><core:Item key="LOW" text="Niedrig · geringe Auswirkung"/><core:Item key="MEDIUM" text="Normal · reguläre Anfrage"/><core:Item key="HIGH" text="Hoch · Arbeit eingeschränkt"/><core:Item key="CRITICAL" text="Kritisch · Betrieb unterbrochen"/></Select>
        <Label text="Beschreibung" required="true" labelFor="description"/><TextArea id="description" value="{view&gt;/description}" rows="7" maxLength="10000" showExceededText="true" width="100%" placeholder="Was ist passiert? Seit wann besteht das Problem? Welche Systeme sind betroffen?"/>
      </form:SimpleForm>
    </Panel>
    <Panel headerText="Technischer und vertraglicher Kontext" expandable="true" expanded="true" class="sapUiMediumMarginTop"><HBox wrap="Wrap" class="sapUiSmallMargin"><VBox width="24rem" class="sapUiLargeMarginEnd sapUiSmallMarginBottom" visible="{= !!${view&gt;/selectedAsset/id} }"><Title text="{view&gt;/selectedAsset/name}" titleStyle="H4"/><ObjectIdentifier title="{view&gt;/selectedAsset/number}" text="{view&gt;/selectedAsset/serialNumber}"/><Label text="Hersteller / Modell"/><Text text="{= (${view&gt;/selectedAsset/manufacturer} || '') + ' ' + (${view&gt;/selectedAsset/model} || '') }"/><Label text="Standort"/><Text text="{view&gt;/selectedAsset/location}"/><Label text="Garantie bis"/><Text text="{view&gt;/selectedAsset/warrantyUntil}"/></VBox><VBox width="24rem" class="sapUiSmallMarginBottom" visible="{= !!${view&gt;/selectedContract/id} }"><Title text="{view&gt;/selectedContract/name}" titleStyle="H4"/><ObjectIdentifier title="{view&gt;/selectedContract/number}" text="{view&gt;/selectedContract/kind}"/><Label text="Gültigkeit"/><Text text="{parts:[{path:'view&gt;/selectedContract/validFrom'},{path:'view&gt;/selectedContract/validTo'}],formatter:'.formatter.servicePeriod'}"/><Label text="Leistungsumfang"/><Text text="{view&gt;/selectedContract/scope}"/></VBox><MessageStrip text="Wählen Sie ein technisches Objekt oder einen Servicevertrag, um die zugehörigen Stammdaten vor der Ticketerstellung zu prüfen." showIcon="true" visible="{= !${view&gt;/selectedAsset/id} &amp;&amp; !${view&gt;/selectedContract/id} }"/></HBox></Panel>
    <MessageStrip text="Ihre Anfrage wird Ihrem Kundenkonto zugeordnet. Sie erhalten nach dem Speichern eine eindeutige Ticketnummer und Korrelations-ID." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
  </VBox></content><footer><OverflowToolbar><ToolbarSpacer/><Button text="Abbrechen" press=".onCancel"/><Button text="Ticket speichern" type="Emphasized" icon="sap-icon://save" press=".onSave"/></OverflowToolbar></footer></Page>
</mvc:View>
