<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Tickets">
  <Page showHeader="false" class="sapUiResponsiveContentPadding"><VBox>
    <Breadcrumbs currentLocationText="Tickets"><Link text="Mein Arbeitsplatz" press=".onHome"/></Breadcrumbs>
    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop sapUiMediumMarginBottom"><VBox><Text text="SERVICE DESK" /><Title text="Tickets" titleStyle="H2"/><Text text="Serviceanfragen zentral bearbeiten und verfolgen." class="sapUiTinyMarginTop"/></VBox><Button text="Ticket anlegen" icon="sap-icon://add" type="Emphasized" press=".onNew" visible="{state&gt;/access/create}"/></HBox>
    <VBox class="sapUiContentPadding">
      <HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
        <VBox width="280px"><Label text="Suche" labelFor="search"/><SearchField id="search" placeholder="Ticket, Betreff oder Kunde" value="{view&gt;/search}" search=".onSearch"/></VBox>
        <VBox width="220px"><Label text="Status" labelFor="status"/><Select id="status" selectedKey="{view&gt;/status}" change=".onFilter" width="100%"><items><core:Item key="" text="Alle Status"/><core:Item key="NEW" text="Neu"/><core:Item key="QUALIFYING" text="Qualifizierung"/><core:Item key="ASSIGNED" text="Zugewiesen"/><core:Item key="IN_PROGRESS" text="In Bearbeitung"/><core:Item key="WAITING_CUSTOMER" text="Wartet auf Kunde"/><core:Item key="WAITING_MATERIAL" text="Wartet auf Material"/><core:Item key="WAITING_VENDOR" text="Wartet auf Hersteller"/><core:Item key="TECHNICALLY_RESOLVED" text="Technisch gelöst"/><core:Item key="COMMERCIALLY_CLOSED" text="Kaufmännisch abgeschlossen"/><core:Item key="CLOSED" text="Geschlossen"/><core:Item key="ESCALATED" text="Eskaliert"/><core:Item key="REOPENED" text="Wiedereröffnet"/><core:Item key="CANCELLED" text="Storniert"/></items></Select></VBox>
        <VBox width="180px"><Label text="Priorität" labelFor="priority"/><Select id="priority" selectedKey="{view&gt;/priority}" change=".onFilter" width="100%"><items><core:Item key="" text="Alle Prioritäten"/><core:Item key="CRITICAL" text="Kritisch"/><core:Item key="HIGH" text="Hoch"/><core:Item key="MEDIUM" text="Normal"/><core:Item key="LOW" text="Niedrig"/></items></Select></VBox>
        <Button text="Zurücksetzen" type="Transparent" press=".onReset"/>
      </HBox>
    </VBox>
    <Table id="ticketTable" items="{path:'/Tickets',parameters:{$count:true,$orderby:'createdAt desc'}}" growing="true" growingThreshold="20" noDataText="Keine Tickets für diese Auswahl." itemPress=".onTicketPress" class="sapUiMediumMarginTop">
      <headerToolbar><OverflowToolbar><Title text="Ticketübersicht" titleStyle="H4"/><ToolbarSpacer/><Button icon="sap-icon://refresh" tooltip="Tickets aktualisieren" press=".onRefresh"/></OverflowToolbar></headerToolbar>
      <columns><Column width="30%"><Text text="Ticket / Betreff"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kunde"/></Column><Column><Text text="Priorität"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Verantwortlich"/></Column></columns>
      <items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{title}" text="{number}"/><Text text="{partnerName}"/><ObjectStatus text="{path:'priority',formatter:'.formatter.priority'}" state="{path:'priority',formatter:'.formatter.priorityState'}"/><ObjectStatus text="{path:'status',formatter:'.formatter.status'}" state="{path:'status',formatter:'.formatter.statusState'}"/><Text text="{technicianName}"/></cells></ColumnListItem></items>
    </Table>
  </VBox></Page>
</mvc:View>
