<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:table="sap.ui.table" xmlns:rm="sap.ui.table.rowmodes" controllerName="netfusion.erp.controller.GoodsReceipt" height="100%"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{= ${view&gt;/document/movementType} === 'RECEIPT_REVERSAL' ? 'Wareneingangsstorno' : 'Wareneingang' }" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="{view&gt;/document/deliveryNote}"/><ObjectStatus text="{= ${view&gt;/document/reversalId} ? 'Storniert' : 'Gebucht' }" state="{= ${view&gt;/document/reversalId} ? 'Warning' : 'Success' }"/></uxap:expandedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Wareneingang stornieren" press=".onReverse" visible="{view&gt;/canReverse}"/><Button text="Zur Bestellung" press=".onPurchase" visible="{state&gt;/access/requisitionRead}"/><Button text="{= ${view&gt;/document/orderKind} === 'SALES_ORDER' ? 'Zum Kundenauftrag' : 'Zum Serviceauftrag' }" press=".onOrder" visible="{= ${view&gt;/document/orderKind} === 'SALES_ORDER' ? ${state&gt;/access/salesProcurementRead} : ${state&gt;/access/orders} }"/><Button text="Lagerarbeitsplatz" press=".onInventory"/><Button icon="sap-icon://refresh" tooltip="Materialbeleg aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="{= ${view&gt;/document/orderKind} === 'SALES_ORDER' ? 'Kundenauftrag' : 'Serviceauftrag' }"/><Text text="{view&gt;/document/orderNumber}"/><Label text="Bestellung" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/purchaseOrderNumber}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/document/postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/><Label text="Belegdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/documentDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},pattern:'dd.MM.yyyy'}}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Bestandswert"/><ObjectNumber number="{parts:[{path:'view&gt;/document/total'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/><Label text="Finanzbeleg" class="sapUiSmallMarginTop"/><Link text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; ${state&gt;/access/financeRead} }" press=".onJournal"/><Text text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; !${state&gt;/access/financeRead} }"/><Text text="Wertfreier Zugang" visible="{= !${view&gt;/document/journal} }"/></VBox><VBox visible="{= !!${view&gt;/document/reason} }"><Label text="Stornogrund"/><Text text="{view&gt;/document/reason}" wrapping="true"/></VBox></HBox></uxap:headerContent><uxap:sections>
 <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox width="100%"><OverflowToolbar><Title text="{= 'Wareneingangspositionen (' + ${view&gt;/document/lines}.length + ')' }" level="H3"/><ToolbarSpacer/><SearchField width="18rem" placeholder="Artikel, Charge oder Seriennummer" liveChange=".onReceiptSearch"/></OverflowToolbar><table:Table id="receiptGrid" rows="{view&gt;/document/lines}" visible="{= !${device&gt;/system/phone} }" selectionMode="None" alternateRowColors="true"><table:rowMode><rm:Fixed rowCount="{view&gt;/gridRows}" rowContentHeight="44"/></table:rowMode><table:columns>
<table:Column width="4rem"><Label text="Pos."/><table:template><Text text="{view&gt;position}"/></table:template></table:Column>
<table:Column width="6rem"><Label text="Bestellpos."/><table:template><Text text="{view&gt;purchasePosition}"/></table:template></table:Column>
<table:Column width="10rem"><Label text="Artikel"/><table:template><Text text="{view&gt;sku}" wrapping="false"/></table:template></table:Column>
<table:Column width="22rem"><Label text="Bezeichnung"/><table:template><Text text="{view&gt;name}" wrapping="false"/></table:template></table:Column>
<table:Column width="9rem" hAlign="End"><Label text="Istmenge"/><table:template><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/></table:template></table:Column>
<table:Column width="10rem" hAlign="End"><Label text="Einkaufspreis"/><table:template><ObjectNumber number="{parts:[{path:'view&gt;unitPrice'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false,minFractionDigits:2,maxFractionDigits:6}}" unit="{view&gt;/document/currency}"/></table:template></table:Column>
<table:Column width="10rem" hAlign="End"><Label text="Bestandswert"/><table:template><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/></table:template></table:Column>
<table:Column width="10rem"><Label text="Werk / Lagerort"/><table:template><Text text="{= ${view&gt;plantCode} + ' / ' + ${view&gt;locationCode} }"/></table:template></table:Column>
<table:Column width="10rem"><Label text="Charge"/><table:template><Text text="{view&gt;batch}" wrapping="false"/></table:template></table:Column>
<table:Column width="12rem"><Label text="Seriennummer"/><table:template><Text text="{view&gt;serial}" wrapping="false"/></table:template></table:Column>
</table:columns></table:Table><Table id="receiptMobile" visible="{device&gt;/system/phone}" items="{view&gt;/document/lines}"><columns><Column><Text text="Artikel"/></Column><Column hAlign="End"><Text text="Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Wert"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 </uxap:sections></uxap:ObjectPageLayout></mvc:View>
