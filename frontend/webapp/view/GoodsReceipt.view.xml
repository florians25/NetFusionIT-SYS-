<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" controllerName="netfusion.erp.controller.GoodsReceipt" height="100%"><uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{= ${view&gt;/document/movementType} === 'RECEIPT_REVERSAL' ? 'Wareneingangsstorno' : 'Wareneingang' }" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/document/number}" text="{view&gt;/document/deliveryNote}"/><ObjectStatus text="{= ${view&gt;/document/reversalId} ? 'Storniert' : 'Gebucht' }" state="{= ${view&gt;/document/reversalId} ? 'Warning' : 'Success' }"/></uxap:expandedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Wareneingang stornieren" press=".onReverse" visible="{view&gt;/canReverse}"/><Button text="Zur Bestellung" press=".onPurchase" visible="{state&gt;/access/requisitionRead}"/><Button text="Zum Serviceauftrag" press=".onOrder" visible="{state&gt;/access/orders}"/><Button text="Lagerarbeitsplatz" press=".onInventory"/><Button icon="sap-icon://refresh" tooltip="Materialbeleg aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle><uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Serviceauftrag"/><Text text="{view&gt;/document/orderNumber}"/><Label text="Bestellung" class="sapUiSmallMarginTop"/><Text text="{view&gt;/document/purchaseOrderNumber}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/document/postingDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},style:'medium'}}"/><Label text="Belegdatum" class="sapUiSmallMarginTop"/><Text text="{path:'view&gt;/document/documentDate',type:'sap.ui.model.type.Date',formatOptions:{source:{pattern:'yyyy-MM-dd'},style:'medium'}}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Bestandswert"/><ObjectNumber number="{parts:[{path:'view&gt;/document/total'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/><Label text="Finanzbeleg" class="sapUiSmallMarginTop"/><Link text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; ${state&gt;/access/financeRead} }" press=".onJournal"/><Text text="{view&gt;/document/journal/number}" visible="{= !!${view&gt;/document/journal} &amp;&amp; !${state&gt;/access/financeRead} }"/><Text text="Wertfreier Zugang" visible="{= !${view&gt;/document/journal} }"/></VBox><VBox visible="{= !!${view&gt;/document/reason} }"><Label text="Stornogrund"/><Text text="{view&gt;/document/reason}" wrapping="true"/></VBox></HBox></uxap:headerContent><uxap:sections>
 <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/document/lines}"><columns><Column><Text text="Artikel"/></Column><Column hAlign="End"><Text text="Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Wert"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectNumber number="{parts:[{path:'view&gt;value'},{path:'view&gt;/document/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/document/currency}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/flow}"><columns><Column><Text text="Vorgänger"/></Column><Column><Text text="Beziehung"/></Column><Column><Text text="Nachfolger"/></Column></columns><items><ColumnListItem><cells><Link text="{view&gt;sourceNumber}" press=".onSource"/><Text text="{path:'view&gt;kind',formatter:'.formatter.relation'}"/><Link text="{view&gt;targetNumber}" press=".onTarget"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 </uxap:sections></uxap:ObjectPageLayout></mvc:View>
