<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Billing" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false">
  <f:title><f:DynamicPageTitle><f:heading><Title text="Fakturavorrat"/></f:heading><f:actions><Button icon="sap-icon://refresh" tooltip="Faktura aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Anforderungen"/><ObjectNumber number="{= ${view&gt;/requests}.length }"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Freigegebene offene Positionen"/><ObjectNumber number="{= ${view&gt;/due}.length }" state="Success"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Gebuchte Rechnungen"/><ObjectNumber number="{= ${view&gt;/invoices}.length }"/></VBox></HBox></f:DynamicPageHeader></f:header>
  <f:content><IconTabBar expandable="false" selectedKey="due"><items>
   <IconTabFilter key="due" text="Fakturavorrat" count="{= ${view&gt;/due}.length }"><Table id="billingDue" items="{view&gt;/due}" mode="MultiSelect" growing="true" noDataText="Keine freigegebenen offenen Fakturapositionen"><headerToolbar><OverflowToolbar><Title text="Freigegebene Leistungen"/><ToolbarSpacer/><SearchField width="16rem" placeholder="Auftrag oder Kunde" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="billingDue"/><core:CustomData key="fields" value="orderNumber,partnerName,requestNumber"/></customData></SearchField><Button text="Rechnung buchen" type="Emphasized" icon="sap-icon://accounting-document-verification" press=".onPost" visible="{state&gt;/access/billingWrite}"/></OverflowToolbar></headerToolbar><columns>
    <Column><Text text="Anforderung / Auftrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kunde / Buchungskreis"/></Column><Column><Text text="Leistung"/></Column><Column hAlign="End"><Text text="Offen / Fakturamenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Leistungszeitraum"/></Column><Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Preis / Steuer"/></Column>
   </columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;requestNumber}" text="{= 'Position ' + ${view&gt;position} }"/><Link text="{view&gt;orderNumber}" press=".onOrder"/></VBox><ObjectIdentifier title="{view&gt;partnerName}" text="{view&gt;companyCode}"/><ObjectIdentifier title="{view&gt;snapshot/description}" text="{view&gt;snapshot/sku}"/><VBox><ObjectNumber number="{path:'view&gt;remainingQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Input value="{view&gt;invoiceQuantity}" width="8rem" description="{view&gt;unit}" editable="{state&gt;/access/billingWrite}" tooltip="Zu fakturierende Teilmenge"/></VBox><Text text="{parts:[{path:'view&gt;serviceFrom'},{path:'view&gt;serviceTo'}],formatter:'.formatter.servicePeriod'}"/><VBox><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.decimal'}" unit="{view&gt;currency}"/><Text text="{= ${view&gt;taxRate} + ' % USt.' }"/></VBox></cells></ColumnListItem></items></Table></IconTabFilter>
   <IconTabFilter key="requests" text="Fakturaanforderungen" count="{= ${view&gt;/requests}.length }"><Table id="billingRequests" items="{view&gt;/requests}" itemPress=".onRequest" growing="true" noDataText="Anforderungen aus dem fakturabereiten Serviceauftrag anlegen"><headerToolbar><OverflowToolbar><Title text="Anforderungsbestand"/><ToolbarSpacer/><SearchField width="18rem" placeholder="Anforderung suchen" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="billingRequests"/><core:CustomData key="fields" value="number,title,partnerName,orderNumber"/></customData></SearchField></OverflowToolbar></headerToolbar><columns><Column><Text text="Anforderung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kunde / Auftrag"/></Column><Column><Text text="Freigabestatus"/></Column><Column hAlign="End"><Text text="Positionen"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;title}"/><ObjectIdentifier title="{view&gt;partnerName}" text="{view&gt;orderNumber}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><ObjectNumber number="{view&gt;lineCount}"/></cells></ColumnListItem></items></Table></IconTabFilter>
   <IconTabFilter key="invoices" text="Rechnungen" count="{= ${view&gt;/invoices}.length }"><Table items="{view&gt;/invoices}" itemPress=".onInvoice" growing="true" noDataText="Keine gebuchten Rechnungen"><columns><Column><Text text="Rechnung / Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Rechnungsdatum / Fälligkeit"/></Column><Column hAlign="End"><Text text="Bruttobetrag"/></Column><Column><Text text="Ausgabe"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;partnerName}"/><Text text="{parts:[{path:'view&gt;invoiceDate'},{path:'view&gt;dueDate'}],formatter:'.formatter.servicePeriod'}"/><ObjectNumber number="{path:'view&gt;gross',formatter:'.formatter.decimal'}" unit="{view&gt;currency}"/><ObjectStatus text="{path:'view&gt;outputStatus',formatter:'.formatter.invoiceOutputStatus'}"/></cells></ColumnListItem></items></Table></IconTabFilter>
  </items></IconTabBar></f:content>
 </f:DynamicPage>
</mvc:View>
