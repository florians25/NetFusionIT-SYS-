<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:table="sap.ui.table" xmlns:rowmodes="sap.ui.table.rowmodes" controllerName="netfusion.erp.controller.CustomerCredit" height="100%">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="false" upperCaseAnchorBar="false">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><ObjectIdentifier title="{view&gt;/number}" text="{= ${view&gt;/correctionMode} === 'PRICE' ? 'Preiskorrektur ohne Mengenrücknahme' : ${view&gt;/correctionMode} === 'RESIDUAL' ? 'Korrektur des verbleibenden Originalwerts' : ${view&gt;/correctionMode} === 'QUANTITY' ? 'Teilmengenkorrektur' : ${view&gt;/correctionMode} === 'POSITIONS' ? 'Positionsbezogene Rechnungskorrektur' : 'Vollständige Rechnungskorrektur' }"/></uxap:heading><uxap:actions>
   <Button text="Prüfstand verwerfen" press=".onCancel" visible="{view&gt;/canCancel}"/><Button text="Prüfstand vorbereiten" press=".onPrepare" visible="{view&gt;/canPrepare}"/><Button text="Zur Freigabe einreichen" press=".onSubmit" visible="{view&gt;/canSubmit}"/><Button text="Freigabe zurückziehen" press=".onWithdraw" visible="{view&gt;/canWithdraw}"/><Button text="Gutschrift buchen" icon="sap-icon://accept" type="Emphasized" press=".onPost" visible="{view&gt;/canPost}"/>
   <Button text="Gutschrift-PDF" icon="sap-icon://pdf-attachment" press=".onPdf" enabled="{= ${view&gt;/outputStatus} === 'READY' }"/><Button text="E-Rechnungs-XML" press=".onXml" enabled="{= ${view&gt;/outputStatus} === 'READY' }"/><Button text="Ausgabe erneut verarbeiten" press=".onOutput" visible="{= ${state&gt;/access/billingCreditWrite} &amp;&amp; ${view&gt;/status} === 'POSTED' &amp;&amp; ${view&gt;/outputStatus} !== 'READY' }"/>
   <Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button icon="sap-icon://refresh" tooltip="Gutschrift aktualisieren" press=".load"/>
  </uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><FlexBox wrap="Wrap" alignItems="Start">
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Ursprungsrechnung"/><Link text="{view&gt;/invoiceNumber}" press=".onInvoice"/><Text text="{view&gt;/partnerName}"/><Link text="{view&gt;/orderNumber}" press=".onOrder"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Freigabe und Buchung"/><ObjectStatus text="{path:'view&gt;/status',formatter:'.formatter.customerCreditStatus'}" state="{path:'view&gt;/status',formatter:'.formatter.statusState'}"/><Label text="Gutschriftdatum"/><Text text="{path:'view&gt;/documentDate',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Netto / Umsatzsteuer"/><ObjectNumber number="{path:'view&gt;/net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><ObjectNumber number="{path:'view&gt;/tax',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></VBox>
   <VBox class="sapUiSmallMarginBottom"><Label text="Gutschriftbetrag"/><ObjectNumber number="{path:'view&gt;/gross',formatter:'.formatter.money'}" unit="{view&gt;/currency}" emphasized="true"/><ObjectStatus text="{= ${view&gt;/status} === 'POSTED' ? 'Korrektur zur Originalrechnung gebucht' : 'Originalforderung bleibt wirksam' }" state="{= ${view&gt;/status} === 'POSTED' ? 'Success' : 'Warning' }"/></VBox>
  </FlexBox></uxap:headerContent>
  <uxap:sections>
   <uxap:ObjectPageSection title="Korrektur und Original"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox>
    <MessageStrip text="{= ${view&gt;/status} === 'POSTED' ? 'Die Gutschrift korrigiert den ursprünglichen Rechnungswert. Bei bereits bezahlten Rechnungen entsteht Kundenguthaben für eine separat geprüfte Rückzahlung. Preisnachlässe ändern keine Warenmenge; tatsächliche Rücknahmen laufen separat über die Retoure.' : 'Dieser Prüfstand verändert noch keine Forderung und keinen Bestand. Die aufgeführten Mengen, Preise, Steuer und ursprüngliche Kontierung stammen aus der Rechnung.' }" showIcon="true" class="sapUiSmallMarginBottom"/>
    <form:SimpleForm layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content>
     <core:Title text="Korrekturgrund"/><Label text="Begründung"/><Text text="{view&gt;/reason}"/><Label text="Buchungsdatum"/><Text text="{path:'view&gt;/postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/>
     <core:Title text="Vorbereitung"/><Label text="Vorbereitet von"/><Text text="{view&gt;/preparedByName}"/><Label text="Zeitpunkt"/><Text text="{path:'view&gt;/preparedAt',formatter:'.formatter.date'}"/>
     <core:Title text="Unabhängige Finanzprüfung"/><Label text="Freigegeben von"/><Text text="{view&gt;/reviewedByName}"/><Label text="Prüfbegründung"/><Text text="{view&gt;/reviewNote}"/><Label text="Ausgabestatus"/><ObjectStatus text="{path:'view&gt;/outputStatus',formatter:'.formatter.invoiceOutputStatus'}"/>
    </form:content></form:SimpleForm>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Ursprüngliche Rechnungspositionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox width="100%">
    <table:Table id="creditPositions" rows="{view&gt;/snapshot/items}" selectionMode="None" visible="{= !${device&gt;/system/phone} }" width="100%" ariaLabelledBy="creditPositionsTitle"><table:extension><OverflowToolbar><Title id="creditPositionsTitle" text="Ausgewählte Originalpositionen in voller Positionsmenge" level="H3"/></OverflowToolbar></table:extension><table:rowMode><rowmodes:Auto minRowCount="3" maxRowCount="12"/></table:rowMode><table:columns>
     <table:Column width="5rem"><Label text="Pos."/><table:template><Text text="{view&gt;position}"/></table:template></table:Column>
     <table:Column width="12rem"><Label text="Artikel"/><table:template><Text text="{view&gt;sku}" wrapping="false"/></table:template></table:Column>
     <table:Column width="24rem"><Label text="Positionsbezeichnung"/><table:template><Text text="{view&gt;description}" wrapping="false"/></table:template></table:Column>
     <table:Column width="9rem" hAlign="End"><Label text="Menge"/><table:template><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/></table:template></table:Column>
     <table:Column width="11rem" hAlign="End"><Label text="Nettopreis"/><table:template><ObjectNumber number="{path:'view&gt;unitNet',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></table:template></table:Column>
     <table:Column width="11rem" hAlign="End"><Label text="Nettowert"/><table:template><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/></table:template></table:Column>
     <table:Column width="7rem"><Label text="USt."/><table:template><Text text="{= ${view&gt;taxRate} + ' %' }"/></table:template></table:Column>
     <table:Column width="10rem"><Label text="Lieferdatum"/><table:template><Text text="{path:'view&gt;serviceFrom',formatter:'.formatter.dateOnly'}" wrapping="false"/></table:template></table:Column>
     <table:Column width="12rem"><Label text="Lieferschein"/><table:template><Text text="{view&gt;deliveryNumber}" wrapping="false"/></table:template></table:Column>
    </table:columns></table:Table>
    <Table items="{view&gt;/snapshot/items}" visible="{device&gt;/system/phone}" id="presentationTable1"><columns><Column><Text text="Originalposition"/></Column><Column hAlign="End"><Text text="Nettowert"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Menge / Lieferdatum"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;sku}"/><ObjectNumber number="{path:'view&gt;net',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{path:'view&gt;serviceFrom',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{view&gt;deliveryNumber}"/></VBox></cells></ColumnListItem></items></Table>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Gegenkontierung"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox>
    <OverflowToolbar><Title text="Originalkonten und Gegen-FI" level="H3"/><ToolbarSpacer/><Link text="{view&gt;/sourceJournal/number}" press=".onOriginalJournal" visible="{state&gt;/access/financeRead}"/><Link text="{view&gt;/journal/number}" press=".onCounterJournal" visible="{state&gt;/access/financeRead}"/></OverflowToolbar>
    <Table items="{view&gt;/lines}" id="presentationTable2"><columns><Column width="6rem"><Text text="Konto"/></Column><Column><Text text="Kontierung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Original"/></Column><Column><Text text="Gutschrift"/></Column><Column hAlign="End"><Text text="Betrag"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Kostenstelle / Steuer"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><ObjectIdentifier title="{view&gt;name}" text="{view&gt;description}"/><Text text="{= ${view&gt;side} === 'DEBIT' ? 'Soll' : 'Haben' }"/><Text text="{= ${view&gt;counterSide} === 'DEBIT' ? 'Soll' : 'Haben' }"/><ObjectNumber number="{path:'view&gt;amount',formatter:'.formatter.money'}" unit="{view&gt;/currency}"/><VBox><Text text="{view&gt;costCenter}"/><Text text="{view&gt;taxCode}"/></VBox></cells></ColumnListItem></items></Table>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Freigabehistorie"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/decisions}" noDataText="Noch keine Entscheidung vorhanden" id="presentationTable3"><columns><Column><Text text="Entscheidung"/></Column><Column><Text text="Verantwortlich"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zeitpunkt"/></Column><Column><Text text="Prüfbegründung"/></Column></columns><items><ColumnListItem><cells><Text text="{path:'view&gt;decision',formatter:'.formatter.approvalDecision'}"/><Text text="{view&gt;actorName}"/><Text text="{path:'view&gt;createdAt',formatter:'.formatter.date'}"/><Text text="{view&gt;comment}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  </uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
