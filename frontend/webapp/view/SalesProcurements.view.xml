<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.SalesProcurements" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false"><f:title><f:DynamicPageTitle><f:heading><Title text="Vertriebsbeschaffung"/></f:heading><f:actions><Button icon="sap-icon://refresh" tooltip="Beschaffungsarbeitsvorrat aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
 <f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Freigegebene Direktvertriebsaufträge"/><ObjectNumber number="{= ${view&gt;/orders}.length }"/></VBox><VBox><Label text="Bedarfsplanung"/><Text text="Echte AU-Einteilungen · freier Bestand zuerst · nur Fehlmengen beschaffen"/></VBox></HBox></f:DynamicPageHeader></f:header>
 <f:content><Table id="directProcurementWorklist" items="{view&gt;/orders}" itemPress=".onOpen" growing="true" noDataText="Keine freigegebenen Direktvertriebsaufträge"><headerToolbar><OverflowToolbar><Title text="Kundenaufträge zur Versorgung"/><ToolbarSpacer/><SearchField width="18rem" placeholder="AU, Kunde oder Bestellreferenz" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="directProcurementWorklist"/><core:CustomData key="fields" value="number,title,partnerName,customerReference"/></customData></SearchField></OverflowToolbar></headerToolbar><columns><Column><Text text="AU / Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Vereinbarter Auftrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Wunschtermin / Kundenbestellung"/></Column><Column hAlign="End"><Text text="BANF / Bestellungen"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;partnerName}"/><Text text="{view&gt;title}"/><VBox><Text text="{path:'view&gt;requestedOn',formatter:'.formatter.dateOnly'}"/><Text text="{view&gt;customerReference}"/></VBox><VBox><ObjectNumber number="{view&gt;requisitionCount}" unit="BANF"/><ObjectNumber number="{view&gt;purchaseCount}" unit="BE"/></VBox></cells></ColumnListItem></items></Table></f:content></f:DynamicPage>
</mvc:View>
