<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.SalesFulfillments" height="100%" displayBlock="true">
 <f:DynamicPage headerExpanded="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Vertriebsauslieferungen" titleStyle="H2"/></f:heading><f:expandedContent><Text text="Freigegebene Warenaufträge · Lagerreservierung, Fachentnahme und tatsächliche Lieferung"/></f:expandedContent><f:actions><Button icon="sap-icon://refresh" text="Aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
 <f:header><f:DynamicPageHeader><VBox><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Aufträge im gefilterten Vorrat"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Mit wirksamer Auslieferung"/><ObjectNumber number="{view&gt;/summary/started}"/></VBox><Text text="Die Liste zeigt bis zu 100 freigegebene Kundenaufträge nach Wunschtermin. Angezeigte Zähler beziehen sich auf diesen gefilterten Vorrat."/></HBox><OverflowToolbar class="sapUiSmallMarginTop"><SearchField placeholder="Auftrag, Kunde oder Bestellreferenz" value="{view&gt;/query}" liveChange=".onFilter" width="22rem"/><Label text="Wunschtermin von"/><DatePicker value="{view&gt;/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter" width="10rem"/><Label text="bis"/><DatePicker value="{view&gt;/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter" width="10rem"/><CheckBox text="Mit Auslieferung" selected="{view&gt;/onlyStarted}" select=".onFilter"/></OverflowToolbar></VBox></f:DynamicPageHeader></f:header>
 <f:content><Table id="salesFulfillmentList" items="{view&gt;/filtered}" mode="None" noDataText="Keine freigegebenen Warenaufträge im gewählten Vorrat."><headerToolbar><OverflowToolbar><Title text="Warenaufträge" level="H3"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Kundenauftrag / Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Ihre Bestellung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Wunschtermin"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Positionen"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auslieferung"/></Column></columns><items><ColumnListItem type="Navigation" press=".onOpen"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;partnerName}"/><Text text="{view&gt;title}"/><Text text="{view&gt;customerReference}" wrapping="false"/><Text text="{path:'view&gt;requestedOn',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{view&gt;itemCount}"/><ObjectStatus text="{= ${view&gt;hasDelivery} ? 'Wirksamer Warenabgang vorhanden' : 'Kein wirksamer Warenabgang' }" state="Information"/></cells></ColumnListItem></items></Table></f:content>
 </f:DynamicPage>
</mvc:View>
