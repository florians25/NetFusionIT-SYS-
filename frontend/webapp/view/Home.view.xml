<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Home">
  <Page showHeader="false" class="sapUiResponsiveContentPadding">
    <VBox>
      <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
        <VBox><Text text="ANWENDUNGEN" /><Title id="appCenterTitle" text="App-Zentrale" titleStyle="H2" class="sapUiTinyMarginTop"/><Text text="{view&gt;/greeting}" class="sapUiTinyMarginTop"/><Text text="Ihr Servicegeschäft auf einen Blick." class="sapUiTinyMarginTop"/></VBox>
        <VBox alignItems="End"><Text text="{view&gt;/date}" class="sapUiTinyMarginBottom"/><ObjectStatus text="{path:'state&gt;/user/role',formatter:'.formatter.role'}" icon="sap-icon://employee" state="Information"/></VBox>
      </HBox>
      <HBox class="sapUiSmallMarginTop sapUiSmallMarginBottom" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
        <HBox alignItems="Center"><core:Icon src="sap-icon://building" class="sapUiTinyMarginEnd"/><Text text="{state&gt;/user/tenantName}"/><Text text="· Service" class="sapUiTinyMarginBegin"/></HBox>
        <Button icon="sap-icon://refresh" text="Aktualisieren" type="Transparent" press=".onRefresh"/>
      </HBox>
      <Title visible="{state&gt;/access/service}" text="Service" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
      <FlexBox visible="{state&gt;/access/service}" wrap="Wrap" class="sapUiSmallMarginBottom">
        <GenericTile header="Service-Cockpit" subheader="Ticket-Eingang und Arbeitsvorrat" press=".onCockpit" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Neue Tickets"><content><NumericContent value="{view&gt;/dashboard/newCount}" icon="sap-icon://overview-chart" valueColor="Neutral" withMargin="false"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Tickets bearbeiten" subheader="Service Desk" press=".onTickets" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Offene Tickets"><content><NumericContent value="{view&gt;/dashboard/open}" icon="sap-icon://customer-and-contacts" valueColor="Neutral" withMargin="false"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Ticket anlegen" subheader="{= ${state&gt;/access/customer} ? 'Kundenportal' : 'Neue Serviceanfrage' }" press=".onNew" visible="{state&gt;/access/create}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Anfrage erfassen"><content><ImageContent src="sap-icon://add-document"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Servicefälle verwalten" subheader="Zusammenhänge im Blick" press=".onCases" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Servicefälle"><content><NumericContent value="{view&gt;/dashboard/cases}" icon="sap-icon://folder-blank" valueColor="Neutral" withMargin="false"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Dispatching" subheader="Techniker zuweisen" press=".onDispatch" visible="{state&gt;/access/assign}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Noch nicht zugewiesen"><content><NumericContent value="{view&gt;/dashboard/unassigned}" icon="sap-icon://appointment-2" valueColor="{= ${view&gt;/dashboard/unassigned} &gt; 0 ? 'Critical' : 'Neutral' }" withMargin="false"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Hohe Priorität" subheader="Kritische und wichtige Tickets" press=".onTickets" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Offen · Hoch / Kritisch"><content><NumericContent value="{view&gt;/dashboard/critical}" icon="sap-icon://alert" valueColor="{= ${view&gt;/dashboard/critical} &gt; 0 ? 'Error' : 'Neutral' }" withMargin="false"/></content></TileContent></tileContent></GenericTile>
      </FlexBox>
      <Title visible="{= ${state&gt;/access/service} || ${state&gt;/access/assetRead} || ${state&gt;/access/contractRead} || ${state&gt;/access/serviceConfig} }" text="Planung &amp; Servicebasis" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
      <FlexBox visible="{= ${state&gt;/access/service} || ${state&gt;/access/assetRead} || ${state&gt;/access/contractRead} || ${state&gt;/access/serviceConfig} }" wrap="Wrap" class="sapUiSmallMarginBottom">
        <GenericTile header="Einsatzplanung" subheader="Technikerkalender und Termine" press=".onPlanning" visible="{state&gt;/access/service}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Arbeitszeiten und Verfügbarkeit"><content><ImageContent src="sap-icon://appointment-2"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Objekte &amp; Verträge" subheader="Installierte Basis und Serviceumfang" press=".onServiceMaster" visible="{= ${state&gt;/access/assetRead} || ${state&gt;/access/contractRead} }" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Kundenbezogene Servicebasis"><content><ImageContent src="sap-icon://it-system"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Servicekalender &amp; SLA" subheader="Geschäftszeiten und Fristen" press=".onServiceSetup" visible="{state&gt;/access/serviceConfig}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Servicekonfiguration"><content><ImageContent src="sap-icon://time-entry-request"/></content></TileContent></tileContent></GenericTile>
      </FlexBox>
      <Title text="Aufträge &amp; Katalog" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom" visible="{= ${state&gt;/access/orders} || ${state&gt;/access/inventory} }"/>
      <FlexBox wrap="Wrap" class="sapUiSmallMarginBottom">
        <GenericTile header="Serviceaufträge" subheader="Positionen und Freigaben" press=".onOrders" visible="{state&gt;/access/orders}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Auftragsbestand"><content><ImageContent src="sap-icon://sales-order"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Lager &amp; Materialbewegungen" subheader="Bestände, Bewertung und Wareneingänge" press=".onInventory" visible="{state&gt;/access/inventory}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Materialwirtschaft"><content><ImageContent src="sap-icon://inventory"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Lagerplätze &amp; Einlagerung" subheader="Bereiche, Regale und tatsächliche Fachbestände" press=".onWarehouse" visible="{state&gt;/access/inventory}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Einlagern, scannen und Platzetiketten"><content><ImageContent src="sap-icon://shelf"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Kostenvoranschläge" subheader="Serviceumfang, geschätzte Kosten und Kundenfreigabe" press=".onEstimates" visible="{state&gt;/access/quoteRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Service-Kostenvoranschlag und Ausführungsauftrag"><content><ImageContent src="sap-icon://expense-report"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Verkaufsangebote" subheader="Konditionen, Kundenentscheidung und Auftrag" press=".onQuotes" visible="{state&gt;/access/quoteRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Original bereitstellen und angenommene Positionen übernehmen"><content><ImageContent src="sap-icon://sales-quote"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Kundenaufträge" subheader="Vertriebsbereich, Partner, Konditionen und Freigabe" press=".onSalesOrders" visible="{state&gt;/access/salesRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Direktvertrieb oder eigene Serviceausführung"><content><ImageContent src="sap-icon://sales-order"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Vertriebsbeschaffung" subheader="AU-Bedarf, Lager zuerst, BANF und Bestellung" press=".onSalesProcurements" visible="{state&gt;/access/salesProcurementRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Eigener Einkaufsarbeitsvorrat"><content><ImageContent src="sap-icon://supplier"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Vertriebsauslieferungen" subheader="Lagerbestand, Reservierung und echte Teillieferung" press=".onSalesFulfillments" visible="{state&gt;/access/salesFulfillment}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Kundenauftrag, Fachentnahme, Lieferschein und Rücknahme"><content><ImageContent src="sap-icon://shipping-status"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Dokumenteinstellungen" subheader="Ansprechpartner und Geschäftskopf je Buchungskreis" press=".onDocumentSettings" visible="{state&gt;/access/documentConfigRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Vorname, Nachname und Kontaktdaten"><content><ImageContent src="sap-icon://document-text"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Einkaufsorganisationen" subheader="Buchungskreis, Einkäufergruppen, Werke und Verantwortung" press=".onPurchasingSetup" visible="{state&gt;/access/procurementConfigRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Verbindliche Zuordnungen für Bestellungen"><content><ImageContent src="sap-icon://org-chart"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Vertriebsstammdaten" subheader="Verkaufsorganisation, Vertriebsweg, Sparte und Bedingungen" press=".onSalesSetup" visible="{state&gt;/access/salesConfigure}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Tatsächliche Organisations- und Vertragsgrundlagen"><content><ImageContent src="sap-icon://org-chart"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Inventuren &amp; Differenzprüfung" subheader="Zählumfang, Fachsperren und unabhängige Freigabe" press=".onInventoryCounts" visible="{state&gt;/access/inventory}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Zählen, bewerten, buchen und gegenbuchen"><content><ImageContent src="sap-icon://inventory"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Artikel &amp; Servicekatalog" subheader="Artikelstamm und Freigabe" press=".onCatalog" visible="{state&gt;/access/inventory}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Leistungen und Material"><content><ImageContent src="sap-icon://product"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Preisfindung" subheader="Konditionen und Gültigkeit" press=".onPricing" visible="{state&gt;/access/pricing}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Preise, Rabatte und Steuern"><content><ImageContent src="sap-icon://sales-document"/></content></TileContent></tileContent></GenericTile>
      </FlexBox>
      <Title text="Stammdaten &amp; Organisation" titleStyle="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom" visible="{state&gt;/access/internal}"/>
      <FlexBox wrap="Wrap" class="sapUiSmallMarginBottom" visible="{state&gt;/access/internal}">
        <GenericTile header="Lieferanten" subheader="Stammdaten und Freigaben" press=".onSuppliers" visible="{state&gt;/access/supplierRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Geschäftspartner im Einkauf"><content><ImageContent src="sap-icon://supplier"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Kundenstamm" subheader="Geschäftspartner" press=".onPartners" visible="{state&gt;/access/partners}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Kunden und Kontaktdaten"><content><ImageContent src="sap-icon://business-card"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Rechnungseingang" subheader="Lieferantenoriginale und Rechnungsprüfung" press=".onIncomingInvoices" visible="{state&gt;/access/apRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Originale, Prüfungen und Dubletten"><content><ImageContent src="sap-icon://accounting-document-verification"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Umsatz &amp; Deckungsbeitrag" subheader="Rechnungen, Gutschriften und tatsächliche Warenkosten" press=".onSalesReporting" visible="{state&gt;/access/reportingSales}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Periodenvergleich, Quellen und berechtigter Export"><content><ImageContent src="sap-icon://business-objects-experience"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Kundengutschriften" subheader="Rechnungskorrektur und unabhängige Finanzprüfung" press=".onCustomerCredits" visible="{state&gt;/access/billingCreditRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Originalrechnung, Gegen-FI und Verrechnung"><content><ImageContent src="sap-icon://sales-document"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Fakturavorrat" subheader="Anforderungen, Teilfaktura und Rechnungen" press=".onBilling" visible="{state&gt;/access/billingInternal}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Freigabe, Leistung und Debitorenposten"><content><ImageContent src="sap-icon://sales-document"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Finanzbuchhaltung" subheader="Konten, Perioden und Journal" press=".onFinance" visible="{state&gt;/access/financeRead}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Buchhaltung und Salden"><content><ImageContent src="sap-icon://accounting-document-verification"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Genehmigungen" subheader="Freigaben und Rückfragen" press=".onWorkflow" visible="{state&gt;/access/workflow}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Freigabehistorie"><content><ImageContent src="sap-icon://approvals"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Benutzer &amp; Rollen" subheader="Zugänge und Berechtigungen" press=".onAdmin" visible="{state&gt;/access/admin}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Administration"><content><ImageContent src="sap-icon://key-user-settings"/></content></TileContent></tileContent></GenericTile>
        <GenericTile header="Organisation" subheader="Serviceorganisationen" press=".onAdmin" visible="{state&gt;/access/admin}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"><tileContent><TileContent footer="Organisationsstruktur"><content><ImageContent src="sap-icon://org-chart"/></content></TileContent></tileContent></GenericTile>
      </FlexBox>

      <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop" wrap="Wrap"><Text text="NETFUSION · ENTERPRISE SERVICE ERP"/><Text text="OpenUI5 · Preview 0.27.0"/></HBox>
    </VBox>
  </Page>
</mvc:View>
