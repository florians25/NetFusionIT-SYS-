<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.SupplierSettlements" displayBlock="true"><f:DynamicPage><f:title><f:DynamicPageTitle><f:heading><Title text="Lieferantenzahlungen"/></f:heading><f:actions><Button text="Aktualisieren" icon="sap-icon://refresh" press=".load"/></f:actions><f:expandedContent><Text text="Teilzahlungen und exakte Gegenbuchungen"/></f:expandedContent></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd"><Label text="Belege"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Zur unabhängigen Prüfung"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox><VBox class="sapUiLargeMarginEnd"><Label text="Freigegeben"/><ObjectNumber number="{view&gt;/summary/approved}"/></VBox><VBox><Label text="Gebucht"/><ObjectNumber number="{view&gt;/summary/posted}"/></VBox></FlexBox></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiContentPadding"><MessageStrip text="Zahlungen an der gebuchten Rechnung vorbereiten. Banknachweise gehören in die Anlagenliste. Die Buchung löst keine Überweisung aus. Die Liste zeigt die letzten 1000 Belege." showIcon="true"/><OverflowToolbar><Title text="Bankbewegungen mit Originalrechnung"/><ToolbarSpacer/><SearchField width="25rem" placeholder="Beleg, Rechnung, Lieferant, Referenz" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="settlementList"/><core:CustomData key="fields" value="number,invoiceNumber,partnerName,reference"/></customData></SearchField><Select change=".onWorklistFilter"><core:Item key="" text="Alle Status"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="APPROVED" text="Freigegeben"/><core:Item key="POSTED" text="Gebucht"/><core:Item key="CANCELLED" text="Verworfen"/><customData><core:CustomData key="targetTable" value="settlementList"/><core:CustomData key="filterField" value="status"/></customData></Select></OverflowToolbar><Table id="settlementList" items="{view&gt;/rows}" growing="true" sticky="ColumnHeaders"><columns><Column><Text text="Zahlungsbeleg"/></Column><Column><Text text="Lieferant / Rechnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column><Column hAlign="End"><Text text="Betrag"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Bankreferenz"/></Column></columns><items><ColumnListItem type="Navigation" press=".onOpen"><cells><VBox><ObjectIdentifier title="{view&gt;number}" text="{path:'view&gt;kind',formatter:'.formatter.supplierSettlementKind'}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/></VBox><ObjectIdentifier title="{view&gt;partnerName}" text="{view&gt;invoiceNumber}"/><Text text="{path:'view&gt;postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;amount',formatter:'.formatter.money'}" unit="{view&gt;currency}"/><Text text="{view&gt;reference}" wrapping="false"/></cells></ColumnListItem></items></Table></VBox></f:content></f:DynamicPage></mvc:View>
