<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="netfusion.erp.controller.Partners"><Page showHeader="false" class="sapUiResponsiveContentPadding"><VBox>
  <Breadcrumbs currentLocationText="Kundenstamm"><Link text="Mein Arbeitsplatz" press=".onHome"/></Breadcrumbs>
  <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop sapUiMediumMarginBottom"><VBox><Text text="GESCHÄFTSPARTNER" /><Title text="Kundenstamm" titleStyle="H2"/><Text text="Kunden und Kontaktdaten Ihrer Serviceorganisation." class="sapUiTinyMarginTop"/></VBox><Button text="Kunde anlegen" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{state&gt;/access/admin}"/></HBox>
  <Table id="partnersTable" items="{path:'/BusinessPartners',parameters:{$count:true,$orderby:'name asc'}}" growing="true" growingThreshold="20" noDataText="Noch keine Kunden angelegt." ><columns><Column><Text text="Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="E-Mail"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{name}" text="{number}"/><Text text="{email}"/><ObjectStatus text="{path:'status',formatter:'.formatter.status'}" state="{path:'status',formatter:'.formatter.statusState'}"/></cells></ColumnListItem></items></Table>
  <MessageStrip text="Der erste Kundenstamm umfasst Name, Kontakt und Organisation. Mehrstufige Kundenfreigaben und kaufmännische Stammdaten sind noch nicht implementiert." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
</VBox></Page></mvc:View>
