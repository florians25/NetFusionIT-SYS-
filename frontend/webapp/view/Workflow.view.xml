<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Workflow"><Page title="Genehmigungen" showNavButton="true" navButtonPress=".onHome" class="sapUiResponsiveContentPadding">
 <content><VBox><OverflowToolbar><Title text="Mein Freigabe-Arbeitsvorrat" titleStyle="H2"/><ToolbarSpacer/><Button text="Definition konfigurieren" icon="sap-icon://settings" press=".onConfigure" visible="{state&gt;/access/admin}"/><Button icon="sap-icon://refresh" tooltip="Genehmigungen aktualisieren" press=".load"/></OverflowToolbar>
 <Table items="{view&gt;/inbox}" noDataText="Keine Freigaben in Ihrer Zuständigkeit."><columns><Column><Text text="Beleg"/></Column><Column><Text text="Status / Stufe"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Einreicher"/></Column><Column width="24rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Aktionen"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;kind}"/><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{view&gt;stageName}"/></VBox><Text text="{view&gt;submittedByName}"/><HBox wrap="Wrap"><Button text="Freigeben" type="Accept" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="APPROVE"/></customData></Button><Button text="Ablehnen" type="Reject" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="REJECT"/></customData></Button><Button text="Rückfrage" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="REQUEST_INFORMATION"/></customData></Button><Button text="Antworten" press=".onDecision" visible="{view&gt;canResubmit}"><customData><core:CustomData key="decision" value="RESUBMIT"/></customData></Button><Button icon="sap-icon://history" tooltip="Freigabehistorie" press=".onHistory"/></HBox></cells></ColumnListItem></items></Table>
 <Title text="Freigabedefinitionen" titleStyle="H3" class="sapUiMediumMarginTop"/><Table items="{view&gt;/definitions}"><columns><Column><Text text="Definition"/></Column><Column><Text text="Belegtyp"/></Column><Column><Text text="Version"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><Text text="{view&gt;subjectKind}"/><Text text="{view&gt;version}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Historisch' }" state="{= ${view&gt;active} ? 'Success' : 'None' }"/></cells></ColumnListItem></items></Table>
 </VBox></content></Page></mvc:View>
