<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" controllerName="netfusion.erp.controller.Workflow"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Genehmigungen"/></f:heading><f:expandedContent><Text text="Freigabe-Arbeitsvorrat · Zuständigkeit, Rückfragen und unveränderte Freigabedefinitionen"/></f:expandedContent></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Geladene Freigabevorgänge"/><ObjectNumber number="{view&gt;/summary/total}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Offene Freigaben"/><ObjectNumber number="{view&gt;/summary/pending}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Jetzt entscheidbar"/><ObjectNumber number="{view&gt;/summary/decidable}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Rückfragen"/><ObjectNumber number="{view&gt;/summary/questions}"/></VBox></HBox><MessageStrip text="Bei Vier-Augen-Freigaben entscheiden unabhängige Freigeber. Einreicher und Belegersteller sind ausgeschlossen." type="Information" showIcon="true"/></f:DynamicPageHeader></f:header>
 <f:content><VBox><OverflowToolbar><Title text="Mein Freigabe-Arbeitsvorrat" titleStyle="H2"/><ToolbarSpacer/><Button text="Definition konfigurieren" icon="sap-icon://settings" press=".onConfigure" visible="{state&gt;/access/admin}"/><Button icon="sap-icon://refresh" tooltip="Genehmigungen aktualisieren" press=".load"/></OverflowToolbar>
 <OverflowToolbar><SearchField width="22rem" placeholder="Beleg, Stufe oder Einreicher suchen" liveChange=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="approvalWorklist"/><core:CustomData key="fields" value="number,stageName,submittedByName"/></customData></SearchField><ToolbarSpacer/><Label text="Status"/><Select change=".onWorklistFilter"><customData><core:CustomData key="targetTable" value="approvalWorklist"/><core:CustomData key="filterField" value="status"/></customData><items><core:Item key="" text="Alle Status"/><core:Item key="PENDING" text="Offene Freigaben"/><core:Item key="INFORMATION_REQUIRED" text="Rückfragen"/><core:Item key="APPROVED" text="Freigegeben"/><core:Item key="REJECTED" text="Abgelehnt"/><core:Item key="WITHDRAWN" text="Zurückgezogen"/></items></Select></OverflowToolbar><Table id="approvalWorklist" items="{view&gt;/inbox}" noDataText="Keine Freigaben in Ihrer Zuständigkeit."><columns><Column><Text text="Beleg"/></Column><Column><Text text="Status / Stufe"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Einreicher"/></Column><Column width="24rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Aktionen"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onWorkflowDocument"/><Text text="{path:'view&gt;kind',formatter:'.formatter.documentKind'}"/></VBox><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{view&gt;stageName}"/></VBox><Text text="{view&gt;submittedByName}"/><HBox wrap="Wrap"><Button text="Freigeben" type="Accept" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="APPROVE"/></customData></Button><Button text="Ablehnen" type="Reject" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="REJECT"/></customData></Button><Button text="Rückfrage" press=".onDecision" visible="{view&gt;canDecide}"><customData><core:CustomData key="decision" value="REQUEST_INFORMATION"/></customData></Button><Button text="Antworten" press=".onDecision" visible="{view&gt;canResubmit}"><customData><core:CustomData key="decision" value="RESUBMIT"/></customData></Button><Button icon="sap-icon://history" tooltip="Freigabehistorie" press=".onHistory"/><Button icon="sap-icon://attachment" tooltip="Anlagenliste des Vorgangs" press=".onAttachments"><customData><core:CustomData key="documentId" value="{view&gt;documentId}"/></customData></Button></HBox></cells></ColumnListItem></items></Table>
 <Title text="Freigabedefinitionen" titleStyle="H3" class="sapUiMediumMarginTop"/><Table items="{view&gt;/definitions}"><columns><Column><Text text="Definition"/></Column><Column><Text text="Belegtyp"/></Column><Column><Text text="Version"/></Column><Column><Text text="Status"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><Text text="{view&gt;subjectKind}"/><Text text="{view&gt;version}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Historisch' }" state="{= ${view&gt;active} ? 'Success' : 'None' }"/></cells></ColumnListItem></items></Table>
 </VBox></f:content></f:DynamicPage></mvc:View>
