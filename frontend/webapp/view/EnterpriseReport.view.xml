<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.EnterpriseReport" displayBlock="true"><f:DynamicPage fitContent="false"><f:title><f:DynamicPageTitle><f:heading><Title text="{view&gt;/definition/title}"/></f:heading><f:expandedContent><Text text="Originalquellen · Organisationsberechtigung · persönliche Berichtsvarianten"/></f:expandedContent><f:actions><Button text="CSV exportieren" icon="sap-icon://download" press=".onExport" enabled="{view&gt;/hasData}"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".onApply"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><form:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2"><form:content><core:Title text="Auswahl und Zeitraum"/><Label text="Buchungskreis" visible="{view&gt;/definition/company}"/><Select width="100%" selectedKey="{view&gt;/filters/companyId}" items="{view&gt;/companies}" visible="{view&gt;/definition/company}"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} + ' · ' + ${view&gt;currency} }"/></Select><Label text="Quellen von" visible="{= ${view&gt;/kind} !== 'STOCK' }"/><DatePicker id="reportFrom" value="{view&gt;/filters/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%" visible="{= ${view&gt;/kind} !== 'STOCK' }"/><Label text="Quellen bis" visible="{= ${view&gt;/kind} !== 'STOCK' }"/><DatePicker id="reportTo" value="{view&gt;/filters/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" width="100%" visible="{= ${view&gt;/kind} !== 'STOCK' }"/><core:Title text="Inhalt eingrenzen"/><Label text="Beleg, Artikel, Kunde oder Mitarbeiter"/><SearchField value="{view&gt;/filters/search}" search=".onApply" width="100%" placeholder="Quellzeilen durchsuchen"/><Label text="Quellstatus"/><Select selectedKey="{view&gt;/filters/status}" items="{view&gt;/statuses}" width="100%"><core:Item key="{view&gt;key}" text="{view&gt;text}"/></Select><core:Title text="Persönliche Berichtsvarianten"/><Label text="Gespeicherte Auswahl"/><Select id="reportVariant" width="100%" selectedKey="{view&gt;/variantId}" change=".onVariant" items="{view&gt;/variants}"><core:Item key="{view&gt;id}" text="{view&gt;name}"/></Select></form:content></form:SimpleForm><OverflowToolbar><Button text="Angezeigte Auswahl speichern" press=".onSaveVariant" enabled="{view&gt;/hasData}"/><Button text="Variante löschen" press=".onDeleteVariant" enabled="{= !!${view&gt;/variantId} }"/><ToolbarSpacer/><Button text="Bericht anzeigen" press=".onApply" type="Emphasized"/></OverflowToolbar></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiContentPadding"><MessageStrip text="{view&gt;/definition/scope}" showIcon="true" class="sapUiSmallMarginBottom"/><VBox visible="{view&gt;/hasData}"><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Tatsächliche Quellzeilen"/><ObjectNumber number="{view&gt;/report/count}"/></VBox><VBox><Label text="Datenstand"/><Text text="{path:'view&gt;/report/generatedAt',formatter:'.formatter.date'}" wrapping="false"/></VBox></FlexBox><Panel headerText="Verdichtung nach Art und Einheit" expandable="true" expanded="true"><Table id="enterpriseGroups" items="{view&gt;/report/groups}"><columns><Column><Text text="Art / Einheit / Status"/></Column><Column hAlign="End"><Text text="Quellzeilen"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} !== 'TICKET_SLA' }"><Text text="Menge je Einheit"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} === 'SERVICE_TIME' }"><Text text="Netto-Stunden"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} === 'SERVICE_TIME' }"><Text text="Pause / Stunden"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} === 'TICKET_SLA' }"><Text text="Mit SLA"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} === 'TICKET_SLA' }"><Text text="Antwort überschritten"/></Column><Column hAlign="End" visible="{= ${view&gt;/kind} === 'TICKET_SLA' }"><Text text="Lösung überschritten"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;label}"/><ObjectNumber number="{view&gt;count}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}"/><ObjectNumber number="{path:'view&gt;hours',formatter:'.formatter.decimal'}"/><ObjectNumber number="{path:'view&gt;pauseHours',formatter:'.formatter.decimal'}"/><ObjectNumber number="{view&gt;hasSla}"/><ObjectNumber number="{view&gt;responseBreaches}"/><ObjectNumber number="{view&gt;resolutionBreaches}"/></cells></ColumnListItem></items></Table></Panel><OverflowToolbar><Title text="Originalbelege &amp; Positionsnachweis"/><ToolbarSpacer/><Text text="{= 'Ab Zeile ' + (${view&gt;/offset} + 1) + ' von ' + ${view&gt;/report/count} }"/><Button text="Zurück" press=".onPrevious" enabled="{= ${view&gt;/offset} &gt; 0 }"/><Button text="Weiter" press=".onNext" enabled="{view&gt;/report/hasMore}"/></OverflowToolbar><VBox id="sourceTableHost" width="100%"/></VBox></VBox></f:content></f:DynamicPage></mvc:View>
