<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.CustomerReturns" displayBlock="true">
 <f:DynamicPage fitContent="false">
  <f:title><f:DynamicPageTitle><f:heading><Title text="Kundenretouren"/></f:heading><f:actions><Button text="Vertriebsauslieferungen" press=".onSalesFulfillments"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".load"/></f:actions></f:DynamicPageTitle></f:title>
  <f:header><f:DynamicPageHeader><FlexBox wrap="Wrap">
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Retouren gesamt"/><ObjectNumber number="{view&gt;/summary/total}" emphasized="true"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Entwürfe"/><ObjectNumber number="{view&gt;/summary/draft}"/></VBox>
   <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Rücksendung offen"/><ObjectNumber number="{view&gt;/summary/open}" state="Warning"/></VBox>
   <VBox class="sapUiSmallMarginBottom"><Label text="Vollständig eingegangen"/><ObjectNumber number="{view&gt;/summary/complete}" state="Success"/></VBox>
  </FlexBox></f:DynamicPageHeader></f:header>
  <f:content><VBox class="sapUiContentPadding">
   <MessageStrip text="Retouren melden Sie an der ursprünglichen Vertriebsauslieferung an. Freigabe, finanzielle Gutschrift und tatsächlicher Lagereingang sind eigene Schritte mit Mengenprüfung und unveränderlichen Belegen." showIcon="true" class="sapUiSmallMarginBottom"/>
   <OverflowToolbar><Title text="Retouren mit Originalbezug" level="H3"/><ToolbarSpacer/><SearchField id="returnSearch" width="25rem" placeholder="Retoure, Kunde oder Kundenauftrag" liveChange=".onFilter"/><Select id="returnStatus" change=".onFilter" tooltip="Retourenstatus"><core:Item key="" text="Alle Status"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="RELEASED" text="Freigegeben"/><core:Item key="CANCELLED" text="Verworfen"/></Select></OverflowToolbar>
   <Table id="returnList" items="{view&gt;/rows}" noDataText="Noch keine Retouren im berechtigten Organisationsumfang vorhanden" growing="true" sticky="ColumnHeaders,HeaderToolbar">
    <columns><Column width="12rem"><Text text="Retoure / Status"/></Column><Column><Text text="Kunde / Kundenauftrag"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Angemeldete Menge"/></Column><Column minScreenWidth="Tablet" demandPopin="true" width="9rem"><Text text="Rücksendung geplant"/></Column><Column hAlign="End" width="10rem"><Text text="Eingegangen"/></Column></columns>
    <items><ColumnListItem type="Navigation" press=".onOpen"><cells><VBox><ObjectIdentifier title="{view&gt;number}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/></VBox><ObjectIdentifier title="{view&gt;partnerName}" text="{view&gt;orderNumber}"/><Text text="{view&gt;quantity}" wrapping="false"/><Text text="{path:'view&gt;requestedDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;receivedQuantity',formatter:'.formatter.decimal'}"/></cells></ColumnListItem></items>
   </Table>
  </VBox></f:content>
 </f:DynamicPage>
</mvc:View>
