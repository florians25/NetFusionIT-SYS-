<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Finance" height="100%">
 <f:DynamicPage fitContent="true" toggleHeaderOnTitleClick="false"><f:title><f:DynamicPageTitle><f:heading><Title text="Finanzbuchhaltung"/></f:heading><f:actions><Button text="Buchungskreis anlegen" press=".onNewCompany" visible="{state&gt;/access/financeWrite}"/><Button icon="sap-icon://refresh" tooltip="Buchhaltung aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap" alignItems="Center"><Label text="Buchungskreis" labelFor="financeCompany" class="sapUiSmallMarginEnd"/><Select id="financeCompany" width="300px" selectedKey="{view&gt;/companyId}" items="{view&gt;/companies}" change=".onCompanyChange"><core:Item key="{view&gt;id}" text="{= ${view&gt;code} + ' · ' + ${view&gt;name} }"/></Select><ObjectStatus text="{= 'Hauswährung: ' + (${view&gt;/company/currency} || '') }" class="sapUiSmallMarginBegin"/></HBox></f:DynamicPageHeader></f:header>
 <f:content><IconTabBar expandable="false" visible="{= !!${view&gt;/companyId} }"><items>
  <IconTabFilter text="Buchungsjournal" key="journals"><Table items="{view&gt;/journals}" itemPress=".onJournal" noDataText="Keine Journalbelege"><headerToolbar><OverflowToolbar><Title text="Journalbelege"/><ToolbarSpacer/><Button text="Journalentwurf anlegen" icon="sap-icon://add-document" type="Emphasized" press=".onNewJournal" visible="{state&gt;/access/financeWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Beleg / Text"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Referenz"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;description}" text="{view&gt;number}"/><Text text="{view&gt;postingDate}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Text text="{view&gt;reference}"/></cells></ColumnListItem></items></Table></IconTabFilter>
  <IconTabFilter text="Sachkonten" key="accounts"><Table items="{view&gt;/context/accounts}" noDataText="Noch keine Sachkonten konfiguriert"><headerToolbar><OverflowToolbar><Title text="Kontenplan"/><ToolbarSpacer/><Button text="Sachkonto anlegen" press=".onNewAccount" visible="{state&gt;/access/financeWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Sachkonto"/></Column><Column><Text text="Bezeichnung"/></Column><Column><Text text="Kontenart"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;code}"/><Text text="{view&gt;name}"/><Text text="{path:'view&gt;kind',formatter:'.formatter.accountKind'}"/></cells></ColumnListItem></items></Table></IconTabFilter>
  <IconTabFilter text="Perioden" key="periods"><Table items="{view&gt;/context/periods}"><headerToolbar><OverflowToolbar><Title text="Buchungsperioden"/><ToolbarSpacer/><Button text="Periode anlegen" press=".onNewPeriod" visible="{state&gt;/access/financeWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Jahr / Periode"/></Column><Column><Text text="Zeitraum"/></Column><Column><Text text="Status"/></Column><Column><Text text="Aktion"/></Column></columns><items><ColumnListItem><cells><Text text="{= ${view&gt;year} + ' / ' + ${view&gt;period} }"/><Text text="{= ${view&gt;dateFrom} + ' – ' + ${view&gt;dateTo} }"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Button text="{= ${view&gt;status} === 'OPEN' ? 'Schließen' : 'Öffnen' }" press=".onPeriodStatus" visible="{state&gt;/access/financeWrite}"/></cells></ColumnListItem></items></Table></IconTabFilter>
  <IconTabFilter text="Summen &amp; Salden" key="balances"><Table items="{view&gt;/balances}"><columns><Column><Text text="Konto"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kontenart"/></Column><Column hAlign="End"><Text text="Soll"/></Column><Column hAlign="End"><Text text="Haben"/></Column><Column hAlign="End"><Text text="Saldo"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;code}"/><Text text="{path:'view&gt;kind',formatter:'.formatter.accountKind'}"/><ObjectNumber number="{parts:[{path:'view&gt;debit'},{path:'view&gt;/company/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}"/><ObjectNumber number="{parts:[{path:'view&gt;credit'},{path:'view&gt;/company/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}"/><ObjectNumber number="{parts:[{path:'view&gt;balance'},{path:'view&gt;/company/currency'}],type:'sap.ui.model.type.Currency',formatOptions:{showMeasure:false}}" unit="{view&gt;/company/currency}"/></cells></ColumnListItem></items></Table></IconTabFilter>
  <IconTabFilter text="Kontierung" key="rules"><Table items="{view&gt;/context/rules}" noDataText="Keine Buchungsautomatik konfiguriert"><headerToolbar><OverflowToolbar><Title text="Kontierungsregeln"/><ToolbarSpacer/><Button text="Kontierung konfigurieren" press=".onRules" visible="{state&gt;/access/financeWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Buchungsvorgang"/></Column><Column><Text text="Kontenrolle"/></Column><Column><Text text="Konto"/></Column><Column><Text text="Version"/></Column></columns><items><ColumnListItem><cells><Text text="{path:'view&gt;event',formatter:'.formatter.accountingEvent'}"/><Text text="{path:'view&gt;role',formatter:'.formatter.accountingRole'}"/><Text text="{view&gt;accountCode}"/><Text text="{view&gt;version}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 </items></IconTabBar></f:content></f:DynamicPage>
</mvc:View>
