<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:t="sap.ui.table" xmlns:rm="sap.ui.table.rowmodes" controllerName="netfusion.erp.controller.SalesFulfillment" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/order/title}" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/order/number}" text="Direktvertrieb · Warenauftrag"/><ObjectStatus text="{path:'view&gt;/order/deliveryStatus',formatter:'.formatter.fulfillmentStatus'}" state="{path:'view&gt;/order/deliveryStatus',formatter:'.formatter.fulfillmentState'}"/></uxap:expandedContent><uxap:snappedContent><ObjectIdentifier title="{view&gt;/order/number}" text="Vertriebsauslieferung"/></uxap:snappedContent><uxap:actions><Button text="Fakturaanforderung" icon="sap-icon://request" press=".onBillingRequest" visible="{state&gt;/access/billingRelease}"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Kundenauftrag öffnen" press=".onOrder" visible="{view&gt;/order/canReadOrder}"/><Button text="Lagerarbeitsplatz" press=".onInventory" visible="{view&gt;/internal}"/><Button text="Auslieferungsvorrat" press=".onWorklist"/><Button icon="sap-icon://refresh" tooltip="Auslieferungsstand aktualisieren" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Vereinbarter Warenempfänger"/><ObjectIdentifier title="{view&gt;/order/shipTo/name}" text="{view&gt;/order/shipTo/number}"/><Text text="{view&gt;/order/shipTo/address/street}"/><Text text="{= ${view&gt;/order/shipTo/address/postalCode} + ' ' + ${view&gt;/order/shipTo/address/city} }"/><Text text="{view&gt;/order/shipTo/address/country}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kundenbestellreferenz"/><Text text="{view&gt;/order/customerReference}" wrapping="false"/><Label text="Lieferstatus" class="sapUiSmallMarginTop"/><ObjectStatus text="{path:'view&gt;/order/deliveryStatus',formatter:'.formatter.fulfillmentStatus'}" state="{path:'view&gt;/order/deliveryStatus',formatter:'.formatter.fulfillmentState'}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Auftragspositionen"/><ObjectNumber number="{view&gt;/summary/positions}"/><Label text="Positionen mit offener Menge" class="sapUiSmallMarginTop"/><ObjectNumber number="{view&gt;/summary/open}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Wirksame Auslieferungsbelege"/><ObjectNumber number="{view&gt;/summary/deliveries}"/><Label text="Offene Reservierungen" class="sapUiSmallMarginTop" visible="{view&gt;/internal}"/><ObjectNumber number="{view&gt;/summary/reservations}" visible="{view&gt;/internal}"/></VBox></HBox></uxap:headerContent>
  <uxap:sections>
   <uxap:ObjectPageSection title="Positionen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Buchen Sie nur tatsächliche Warenentnahmen aus den gewählten Lagerfächern. Reservierte Mengen, gelieferte Mengen und offene Restmengen werden getrennt geführt." showIcon="true"/>
    <t:Table id="fulfillmentItemGrid" rows="{view&gt;/order/items}" visible="{= !${device&gt;/system/phone} }" selectionMode="None" alternateRowColors="true" fixedColumnCount="2" columnHeaderHeight="32"><t:rowMode><rm:Fixed rowCount="{view&gt;/gridRows}" rowContentHeight="32"/></t:rowMode><t:extension><OverflowToolbar><Title text="Liefermengen je Auftragsposition" level="H3"/></OverflowToolbar></t:extension><t:columns>
     <t:Column width="4rem"><Label text="Pos."/><t:template><Text text="{view&gt;position}"/></t:template></t:Column><t:Column width="10rem"><Label text="Artikel"/><t:template><Text text="{view&gt;sku}" wrapping="false"/></t:template></t:Column><t:Column width="22rem"><Label text="Kurztext"/><t:template><Text text="{view&gt;description}" tooltip="{view&gt;description}" wrapping="false"/></t:template></t:Column>
     <t:Column width="8rem" hAlign="End"><Label text="Auftragsmenge"/><t:template><Text text="{path:'view&gt;quantity',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="5rem"><Label text="ME"/><t:template><Text text="{view&gt;unit}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Reserviert"/><t:template><Text text="{path:'view&gt;reservedQuantity',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Geliefert"/><t:template><ObjectNumber number="{path:'view&gt;deliveredQuantity',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End"><Label text="Offene Menge"/><t:template><ObjectNumber number="{path:'view&gt;remainingQuantity',formatter:'.formatter.decimal'}"/></t:template></t:Column><t:Column width="8rem" hAlign="End" visible="{view&gt;/internal}"><Label text="Fehlmenge"/><t:template><ObjectNumber number="{path:'view&gt;shortageQuantity',formatter:'.formatter.decimal'}" state="{= Number(${view&gt;shortageQuantity}) &gt; 0 ? 'Warning' : 'None' }"/></t:template></t:Column><t:Column width="16rem"><Label text="Ausführung"/><t:template><Text text="{view&gt;supportText}" wrapping="false"/></t:template></t:Column><t:Column width="12rem"><Label text="Lieferstatus"/><t:template><ObjectStatus text="{path:'view&gt;deliveryStatus',formatter:'.formatter.fulfillmentStatus'}" state="{path:'view&gt;deliveryStatus',formatter:'.formatter.fulfillmentState'}"/></t:template></t:Column>
    </t:columns></t:Table>
    <Table id="fulfillmentMobileItems" visible="{device&gt;/system/phone}" items="{view&gt;/order/items}"><columns><Column><Text text="Position / Lieferstand"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auftragsmenge"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Geliefert / offen"/></Column></columns><items><ColumnListItem><cells><VBox><ObjectIdentifier title="{view&gt;description}" text="{= ${view&gt;position} + ' · ' + ${view&gt;sku} }"/><ObjectStatus text="{path:'view&gt;deliveryStatus',formatter:'.formatter.fulfillmentStatus'}" state="{path:'view&gt;deliveryStatus',formatter:'.formatter.fulfillmentState'}"/></VBox><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><ObjectNumber number="{path:'view&gt;deliveredQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{= 'Offen: ' + ${view&gt;remainingText} }"/></VBox></cells></ColumnListItem></items></Table>
   </VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Einteilungen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table id="fulfillmentSchedules" items="{view&gt;/schedules}"><headerToolbar><OverflowToolbar><Title text="Vereinbarte Mengen und Termine" level="H3"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Position / Einteilung"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Geplant"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Wunschtermin"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Geliefert"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Noch zu reservieren"/></Column><Column minScreenWidth="Tablet" demandPopin="true" visible="{view&gt;/order/canReserve}"><Text text="Lagerbestand"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;description}" text="{= 'Pos. ' + ${view&gt;itemPosition} + ' / Einteilung ' + ${view&gt;position} }"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{path:'view&gt;requestedOn',formatter:'.formatter.dateOnly'}" wrapping="false"/><ObjectNumber number="{path:'view&gt;delivered',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><ObjectNumber number="{path:'view&gt;openToReserve',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Button text="Bestand reservieren" press=".onReserve" visible="{view&gt;canReserve}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Reservierungen" visible="{view&gt;/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table id="fulfillmentReservations" items="{view&gt;/order/reservations}" noDataText="Noch keine tatsächlichen Lagerreservierungen für diesen Auftrag."><columns><Column><Text text="Artikel / Position"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Reservierte Menge"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Entnommen / Rest"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Serie"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Aktionen"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;sku}" text="{view&gt;description}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><VBox><ObjectNumber number="{path:'view&gt;consumedQuantity',formatter:'.formatter.decimal'}" unit="{view&gt;unit}"/><Text text="{= 'Rest: ' + ${view&gt;remainingText} }"/></VBox><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.fulfillmentStatus'}" state="{path:'view&gt;status',formatter:'.formatter.fulfillmentState'}"/><HBox wrap="Wrap"><Button text="Ware ausliefern" type="Emphasized" press=".onDeliver" visible="{view&gt;canUse}"/><Button text="Rest freigeben" press=".onRelease" visible="{view&gt;canRelease}"/></HBox></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Lagerverfügbarkeit" visible="{view&gt;/internal}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Freie Mengen berücksichtigen alle aktiven Reservierungen aus Service und Direktvertrieb. Eine Reservierung ersetzt noch keine Entnahme aus einem tatsächlichen Lagerfach." showIcon="true"/><Table items="{view&gt;/order/stock}" noDataText="Kein Lagerbestand zu diesen Positionen vorhanden. Die Fehlmenge ist vor der Auslieferung zu beschaffen." id="presentationTable4"><columns><Column><Text text="Artikel"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Werk / Lagerort"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Charge / Seriennummer"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Physische Menge"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Frei verfügbar"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;sku}"/><ObjectIdentifier title="{view&gt;plantCode}" text="{view&gt;locationCode}"/><ObjectIdentifier title="{view&gt;serial}" text="{view&gt;batch}"/><ObjectNumber number="{path:'view&gt;quantity',formatter:'.formatter.decimal'}"/><ObjectNumber number="{path:'view&gt;availableQuantity',formatter:'.formatter.decimal'}"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Auslieferungen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table id="salesDeliveryList" items="{view&gt;/order/deliveries}" noDataText="Noch kein tatsächlicher Warenabgang gebucht."><columns><Column><Text text="Warenbeleg / Lieferschein"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bewegung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Warenausgangsdatum"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Buchungsdatum"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auslieferungstext"/></Column></columns><items><ColumnListItem type="Navigation" press=".onDelivery"><cells><ObjectIdentifier title="{view&gt;number}" text="{view&gt;deliveryNumber}"/><ObjectStatus text="{= ${view&gt;reversalId} ? 'Zurückgenommen' : ${view&gt;movementType} === 'ISSUE_REVERSAL' ? 'Gegenbewegung' : 'Ausgeliefert' }" state="{= ${view&gt;reversalId} || ${view&gt;movementType} === 'ISSUE_REVERSAL' ? 'Warning' : 'Success' }"/><Text text="{path:'view&gt;deliveryDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{path:'view&gt;postingDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{view&gt;description}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
   <uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
  </uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
