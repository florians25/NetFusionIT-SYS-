<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Partner" height="100%" displayBlock="true">
 <uxap:ObjectPageLayout height="100%" useIconTabBar="true" upperCaseAnchorBar="false" showHeaderContent="{= !${device&gt;/system/phone} }"><uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><Title text="{view&gt;/partner/name}" titleStyle="H2"/></uxap:heading><uxap:expandedContent><ObjectIdentifier title="{view&gt;/partner/number}" text="Geschäftspartner"/><ObjectStatus text="{path:'view&gt;/partner/status',formatter:'.formatter.status'}" state="{path:'view&gt;/partner/status',formatter:'.formatter.statusState'}"/></uxap:expandedContent><uxap:snappedContent><Text text="{view&gt;/partner/number}"/></uxap:snappedContent><uxap:actions><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Speichern" type="Emphasized" press=".onSave" visible="{view&gt;/editable}"/><Button text="Zur Freigabe einreichen" icon="sap-icon://approvals" press=".onSubmit" visible="{view&gt;/editable}"/><Button text="Geschäftspartnerliste" press=".onPartners"/><Button icon="sap-icon://refresh" tooltip="Kunde neu laden" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
 <uxap:headerContent><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kontakt"/><Link text="{view&gt;/partner/email}" href="{= 'mailto:' + ${view&gt;/partner/email} }"/><Text text="{view&gt;/partner/legalForm}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Währung / Steuer"/><ObjectNumber number="{view&gt;/partner/currency}"/><Text text="{view&gt;/partner/vatId}"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Ansprechpartner"/><ObjectNumber number="{= ${view&gt;/partner/contacts}.length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Adressen"/><ObjectNumber number="{= ${view&gt;/partner/addresses}.length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Belegversion"/><ObjectNumber number="{view&gt;/partner/version}"/></VBox></HBox></uxap:headerContent>
 <uxap:sections><uxap:ObjectPageSection title="Allgemein"><uxap:subSections><uxap:ObjectPageSubSection title="Stammdaten und kaufmännische Zuordnung"><uxap:blocks><form:SimpleForm editable="{view&gt;/editable}" layout="ResponsiveGridLayout" columnsL="2" columnsM="1"><Label text="Name"/><Input value="{view&gt;/partner/name}" editable="{view&gt;/editable}"/><Label text="E-Mail"/><Input value="{view&gt;/partner/email}" type="Email" editable="{view&gt;/editable}"/><Label text="Rechtsform"/><Input value="{view&gt;/partner/legalForm}" editable="{view&gt;/editable}"/><Label text="USt-IdNr."/><Input value="{view&gt;/partner/vatId}" editable="{view&gt;/editable}"/><Label text="Währung"/><Input value="{view&gt;/partner/currency}" maxLength="3" editable="{view&gt;/editable}"/></form:SimpleForm></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Kontakte"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/partner/contacts}" noDataText="Noch keine Kontakte" id="presentationTable1"><headerToolbar><OverflowToolbar><Title text="Ansprechpartner"/><ToolbarSpacer/><Button text="Ansprechpartner anlegen" press=".onContact" visible="{state&gt;/access/partnerWrite}"/><Text text="{= ${view&gt;/partner/contacts}.length + ' Einträge' }"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Name"/></Column><Column><Text text="E-Mail"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Telefon / Abteilung"/></Column><Column><Text text="Funktionen / Gültigkeit"/></Column><Column><Text text="Bearbeiten"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><Link text="{view&gt;email}" href="{= 'mailto:' + ${view&gt;email} }"/><VBox><Text text="{view&gt;phone}"/><Text text="{view&gt;department}"/></VBox><VBox><Text text="{path:'view&gt;functions',formatter:'.formatter.contactFunctions'}"/><Text text="{parts:[{path:'view&gt;validFrom'},{path:'view&gt;validTo'}],formatter:'.formatter.servicePeriod'}"/><ObjectStatus text="{= ${view&gt;active} ? 'Aktiv' : 'Inaktiv' }"/></VBox><Button icon="sap-icon://edit" tooltip="Ansprechpartner bearbeiten" press=".onContact" visible="{state&gt;/access/partnerWrite}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection>
 <uxap:ObjectPageSection title="Adressen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/partner/addresses}" noDataText="Noch keine Adressen" id="presentationTable2"><headerToolbar><OverflowToolbar><Title text="Adressen"/><ToolbarSpacer/><Button text="Adresse anlegen" press=".onAddress" visible="{state&gt;/access/partnerWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Adressart"/></Column><Column><Text text="Straße"/></Column><Column><Text text="PLZ / Ort"/></Column><Column><Text text="Land"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;kind}"/><Text text="{view&gt;street}"/><Text text="{= ${view&gt;postalCode} + ' ' + ${view&gt;city} }"/><Text text="{view&gt;country}"/></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Debitor &amp; Kreditor" visible="{state&gt;/access/partnerAccountRead}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table items="{view&gt;/accounts}" noDataText="Keine buchungskreisbezogenen Finanzrollen" id="presentationTable3"><headerToolbar><OverflowToolbar><Title text="Finanzrollen je Buchungskreis"/><ToolbarSpacer/><Button text="Finanzrolle anlegen" press=".onAccount" visible="{state&gt;/access/partnerAccountWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Rolle / Personenkonto"/></Column><Column><Text text="Buchungskreis / Abstimmkonto"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Zahlungsziel / Kreditlimit"/></Column><Column><Text text="Status / Freigabe"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;accountNumber}" text="{path:'view&gt;kind',formatter:'.formatter.partnerAccountKind'}"/><ObjectIdentifier title="{view&gt;companyCode}" text="{view&gt;reconciliationCode}"/><VBox><Text text="{= ${view&gt;paymentTermsDays} + ' Tage' }"/><ObjectNumber number="{view&gt;creditLimit}"/><ObjectStatus text="Fakturasperre" state="Warning" visible="{view&gt;invoiceBlock}"/><ObjectStatus text="Zahlungssperre" state="Warning" visible="{view&gt;paymentBlock}"/></VBox><VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Button text="Zur Freigabe einreichen" press=".onSubmitAccount" visible="{= ${state&gt;/access/partnerAccountWrite} &amp;&amp; ['DRAFT','REJECTED'].includes(${view&gt;status}) }"/></VBox></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="CRM-Aktivitäten" visible="{state&gt;/access/crmActivity}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><Table id="crmActivities" items="{view&gt;/crm/activities}" noDataText="Noch keine Aktivitäten erfasst"><headerToolbar><OverflowToolbar><Title text="Aktivitäten und Wiedervorlage"/><ToolbarSpacer/><Button text="Aktivität anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewActivity" visible="{view&gt;/crm/canWrite}"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Aktivität / Anliegen"/></Column><Column><Text text="Verantwortung / Termin"/></Column><Column><Text text="Status"/></Column><Column><Text text="Verlauf / Bearbeitung"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;subject}" text="{path:'view&gt;kind',formatter:'.formatter.libraryKind'}"/><VBox><Text text="{view&gt;responsibleName}"/><Text text="{path:'view&gt;due_at',formatter:'.formatter.date'}" wrapping="false"/></VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.libraryStatus'}"/><HBox wrap="Wrap"><Button text="Verlauf" press=".onActivityDetails"/><Button text="Erledigen" press=".onActivityStatus" visible="{view&gt;canComplete}"><customData><core:CustomData key="status" value="DONE"/></customData></Button><Button text="Verwerfen" press=".onActivityStatus" visible="{view&gt;canComplete}"><customData><core:CustomData key="status" value="CANCELLED"/></customData></Button></HBox></cells></ColumnListItem></items></Table></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Dublettenhinweise" visible="{state&gt;/access/crmActivity}"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox><MessageStrip text="Übereinstimmungen sind Prüfhinweise. Bestehende Identitäten und historische Belege werden nicht automatisch zusammengeführt." showIcon="true"/><Table id="crmDuplicateHints" items="{view&gt;/crm/duplicates}" noDataText="Keine übereinstimmenden Stammwerte gefunden"><columns><Column><Text text="Möglicher Geschäftspartner"/></Column><Column><Text text="E-Mail / USt-IdNr."/></Column><Column><Text text="Übereinstimmung"/></Column></columns><items><ColumnListItem><cells><VBox><Link text="{view&gt;number}" press=".onDuplicatePartner"/><Text text="{view&gt;name}"/></VBox><ObjectIdentifier title="{view&gt;email}" text="{view&gt;vatId}"/><Text text="{path:'view&gt;reasons',formatter:'.formatter.duplicateReasons'}"/></cells></ColumnListItem></items></Table></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections>
 </uxap:ObjectPageLayout></mvc:View>
