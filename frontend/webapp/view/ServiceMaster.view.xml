<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" controllerName="netfusion.erp.controller.ServiceMaster"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="Technische Objekte &amp; Serviceverträge"/></f:heading></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><HBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Technische Objekte"/><ObjectNumber number="{= (${view&gt;/assets} || []).length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Verträge"/><ObjectNumber number="{= (${view&gt;/contracts} || []).length }"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kundenkontext"/><ObjectNumber number="{= (${view&gt;/partners} || []).length }"/></VBox></HBox></f:DynamicPageHeader></f:header><f:content><IconTabBar expandable="false"><items>
 <IconTabFilter text="Technische Objekte" visible="{state&gt;/access/assetRead}"><Table items="{view&gt;/assets}" noDataText="Noch keine technischen Objekte"><headerToolbar><OverflowToolbar><Title text="Installierte Basis"/><ToolbarSpacer/><Button text="Objekt anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewAsset" visible="{state&gt;/access/assetWrite}"/><Button icon="sap-icon://refresh" tooltip="Objekte aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Objekt"/></Column><Column><Text text="Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Modell / Seriennummer"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Standort / Garantie"/></Column><Column width="6rem" hAlign="End"><Text text="Anlagen"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;number}"/><Text text="{view&gt;partnerName}"/><VBox><Text text="{= ${view&gt;manufacturer} + ' ' + ${view&gt;model} }"/><Text text="{view&gt;serialNumber}"/></VBox><VBox><Text text="{view&gt;location}"/><Text text="{view&gt;warrantyUntil}"/></VBox><Button icon="sap-icon://attachment" tooltip="Anlagenliste öffnen" press=".onAttachments"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter text="Serviceverträge" visible="{state&gt;/access/contractRead}"><Table items="{view&gt;/contracts}" noDataText="Noch keine Serviceverträge"><headerToolbar><OverflowToolbar><Title text="Vertragsbestand"/><ToolbarSpacer/><Button text="Vertrag anlegen" icon="sap-icon://add" type="Emphasized" press=".onNewContract" visible="{state&gt;/access/contractWrite}"/><Button icon="sap-icon://refresh" tooltip="Verträge aktualisieren" press=".load"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Vertrag"/></Column><Column><Text text="Kunde"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Gültigkeit"/></Column><Column><Text text="Status"/></Column><Column visible="{state&gt;/access/contractWrite}"><Text text="Aktion"/></Column><Column width="6rem" hAlign="End"><Text text="Anlagen"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view&gt;name}" text="{view&gt;number}"/><Text text="{view&gt;partnerName}"/><Text text="{= ${view&gt;validFrom} + ' – ' + ${view&gt;validTo} }"/><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><Button text="{= ${view&gt;status} === 'ACTIVE' ? 'Sperren' : 'Aktivieren' }" press=".onActivateContract" visible="{state&gt;/access/contractWrite}"/><Button icon="sap-icon://attachment" tooltip="Anlagenliste öffnen" press=".onAttachments"/></cells></ColumnListItem></items></Table></IconTabFilter>
 </items></IconTabBar></f:content></f:DynamicPage></mvc:View>
