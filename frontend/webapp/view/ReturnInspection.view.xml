<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:uxap="sap.uxap" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" controllerName="netfusion.erp.controller.ReturnInspection" displayBlock="true" height="100%">
 <uxap:ObjectPageLayout height="100%" upperCaseAnchorBar="false">
  <uxap:headerTitle><uxap:ObjectPageDynamicHeaderTitle><uxap:heading><ObjectIdentifier title="{view&gt;/number}" text="{path:'view&gt;/kind',formatter:'.formatter.documentKind'}"/></uxap:heading><uxap:actions><Button text="Kundenretoure" press=".onReturn"/><Button text="Anlagenliste" icon="sap-icon://attachment" press=".onAttachments"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".load"/></uxap:actions></uxap:ObjectPageDynamicHeaderTitle></uxap:headerTitle>
  <uxap:headerContent><FlexBox wrap="Wrap"><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Kundenretoure"/><Link text="{view&gt;/returnNumber}" press=".onReturn"/><Label text="Bewegungs- / Prüfdatum"/><Text text="{path:'view&gt;/day',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom"><Label text="Vorgang"/><ObjectStatus text="{path:'view&gt;/movement_type',formatter:'.formatter.custodyMovement'}"/><Label text="Erfasst durch"/><Text text="{view&gt;/createdByName}"/></VBox></FlexBox></uxap:headerContent>
  <uxap:sections><uxap:ObjectPageSection title="Nachweis und Mengen"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><VBox width="100%"><MessageStrip text="Kundeneigentum im gesperrten Prüfbestand. Dieser Vorgang erzeugt keine Finanzbuchung, keinen verfügbaren eigenen Bestand und keine neue Fakturaquelle. Gegenbewegungen erfolgen nachvollziehbar aus der Kundenretoure." showIcon="true"/><form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsXL="2" columnsL="2" columnsM="1"><core:Title text="Mengen und Zustand"/><Label text="Bewegungsmenge"/><ObjectNumber number="{path:'view&gt;/quantity',formatter:'.formatter.decimal'}"/><Label text="Angenommene Menge"/><ObjectNumber number="{path:'view&gt;/accepted_quantity',formatter:'.formatter.decimal'}"/><Label text="Abgelehnte Menge"/><ObjectNumber number="{path:'view&gt;/rejected_quantity',formatter:'.formatter.decimal'}"/><Label text="Zustand"/><Text text="{path:'view&gt;/condition_code',formatter:'.formatter.inspectionCondition'}"/><core:Title text="Prüfung und Begründung"/><Label text="Prüfbefund"/><Text text="{view&gt;/findings}"/><Label text="Begründung"/><Text text="{view&gt;/reason}"/></form:SimpleForm></VBox></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection><uxap:ObjectPageSection title="Belegfluss"><uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks><core:Fragment fragmentName="netfusion.erp.fragment.DocumentFlow" type="XML"/></uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections></uxap:ObjectPageSection></uxap:sections>
 </uxap:ObjectPageLayout>
</mvc:View>
