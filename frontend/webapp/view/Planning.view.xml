<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:u="sap.ui.unified" controllerName="netfusion.erp.controller.Planning"><Page title="Einsatzplanung" showNavButton="true" navButtonPress=".onHome" class="sapUiResponsiveContentPadding"><content><VBox>
 <OverflowToolbar><Title text="Techniker &amp; Termine" titleStyle="H2"/><ToolbarSpacer/><Button text="Einsatz planen" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{state&gt;/access/assign}"/><Button text="Abwesenheit" icon="sap-icon://calendar" press=".onAbsence" visible="{state&gt;/access/assign}"/><Button icon="sap-icon://refresh" tooltip="Planung aktualisieren" press=".load"/></OverflowToolbar>
 <PlanningCalendar id="planningCalendar" startDate="{view&gt;/startDate}" rows="{path:'view&gt;/rows',templateShareable:false}" builtInViews="Hour,Day,Week,Month" viewKey="Day" appointmentSelect=".onAppointment"><rows><PlanningCalendarRow title="{view&gt;name}" text="{view&gt;location}" appointments="{path:'view&gt;appointments',templateShareable:false}"><appointments><u:CalendarAppointment startDate="{view&gt;startsAtDate}" endDate="{view&gt;endsAtDate}" title="{view&gt;title}" text="{view&gt;number}" type="{view&gt;calendarType}" key="{view&gt;id}"/></appointments></PlanningCalendarRow></rows></PlanningCalendar>
 <IconTabBar expandable="false" class="sapUiMediumMarginTop"><items><IconTabFilter text="Einsätze"><Table items="{view&gt;/visits}" itemPress=".onVisit" noDataText="Noch keine Einsätze geplant"><columns><Column><Text text="Einsatz"/></Column><Column><Text text="Beginn / Ende"/></Column><Column><Text text="Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Standort"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><VBox><Text text="{path:'view&gt;startsAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;endsAt',formatter:'.formatter.date'}"/></VBox><ObjectStatus text="{path:'view&gt;status',formatter:'.formatter.status'}"/><Text text="{view&gt;location}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter text="Techniker" visible="{state&gt;/access/assign}"><Table items="{view&gt;/technicians}"><columns><Column><Text text="Name"/></Column><Column><Text text="Arbeitszeitmodell"/></Column><Column><Text text="Pflege"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;name}"/><ObjectStatus text="{= ${view&gt;calendarId} ? 'Konfiguriert' : 'Fehlt' }" state="{= ${view&gt;calendarId} ? 'Success' : 'Warning' }"/><Button text="Arbeitszeitmodell bearbeiten" press=".onProfile"/></cells></ColumnListItem></items></Table></IconTabFilter>
 <IconTabFilter text="Abwesenheiten" visible="{state&gt;/access/assign}"><Table items="{view&gt;/absences}"><columns><Column><Text text="Techniker"/></Column><Column><Text text="Beginn"/></Column><Column><Text text="Ende"/></Column><Column><Text text="Grund"/></Column></columns><items><ColumnListItem><cells><Text text="{view&gt;technicianName}"/><Text text="{path:'view&gt;startsAt',formatter:'.formatter.date'}"/><Text text="{path:'view&gt;endsAt',formatter:'.formatter.date'}"/><Text text="{view&gt;reason}"/></cells></ColumnListItem></items></Table></IconTabFilter>
 </items></IconTabBar>
 </VBox></content></Page></mvc:View>
