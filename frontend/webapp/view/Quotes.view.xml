<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.Quotes" height="100%"><f:DynamicPage fitContent="true"><f:title><f:DynamicPageTitle><f:heading><Title text="{view&gt;/appTitle}"/></f:heading><f:expandedContent><ObjectStatus text="Vertrieb · kommerzieller Angebotsbestand" state="Information" icon="sap-icon://sales-order"/></f:expandedContent><f:actions><Button text="{= ${view&gt;/isEstimate} ? 'Kostenvoranschlag anlegen' : 'Verkaufsangebot anlegen' }" type="Emphasized" press=".onCreate" visible="{state&gt;/access/quoteWrite}"/><Button text="Vertriebsstammdaten" press=".onSalesSetup" visible="{state&gt;/access/salesConfigRead}"/><Button icon="sap-icon://refresh" tooltip="Angebote aktualisieren" press=".load"/></f:actions></f:DynamicPageTitle></f:title><f:header><f:DynamicPageHeader><VBox><layout:Grid defaultSpan="XL3 L3 M6 S12"><VBox><Label text="Kunde / Angebot / Referenz" labelFor="salesQuery"/><SearchField id="salesQuery" value="{view&gt;/query}" placeholder="Kunde, AG-Nummer, Bestellung, Vertriebsbereich" search=".onFilter" liveChange=".onFilter"/></VBox><VBox><Label text="Angebotsstatus" labelFor="salesStatus"/><Select id="salesStatus" width="100%" selectedKey="{view&gt;/status}" change=".onFilter"><core:Item key="" text="Alle Zustände"/><core:Item key="DRAFT" text="Entwurf"/><core:Item key="IN_REVIEW" text="In unabhängiger Prüfung"/><core:Item key="APPROVED" text="Intern freigegeben"/><core:Item key="PUBLISHED" text="Im Kundenportal bereitgestellt"/><core:Item key="ACCEPTED" text="Angenommen"/><core:Item key="DECLINED" text="Abgelehnt"/><core:Item key="REJECTED" text="Abgelehnt"/><core:Item key="CANCELLED" text="Abgebrochen"/></Select></VBox><VBox><Label text="Angebotsdatum von" labelFor="salesFrom"/><DatePicker id="salesFrom" width="100%" value="{view&gt;/from}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter"/></VBox><VBox><Label text="Angebotsdatum bis" labelFor="salesTo"/><DatePicker id="salesTo" width="100%" value="{view&gt;/to}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy" change=".onFilter"/></VBox></layout:Grid><HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginTop"><VBox class="sapUiSmallMarginEnd"><Label text="Im aktuellen Filter"/><ObjectNumber number="{view&gt;/summary/total}" unit="Vorgänge"/></VBox><VBox class="sapUiSmallMarginEnd"><Label text="Entwurf / Überarbeitung"/><ObjectNumber number="{view&gt;/summary/draft}" unit="Vorgänge"/></VBox><VBox class="sapUiSmallMarginEnd"><Label text="Unabhängige Prüfung"/><ObjectNumber number="{view&gt;/summary/review}" unit="Vorgänge" state="Warning"/></VBox><VBox><Label text="Kundenbereitstellung / Entscheidung"/><ObjectNumber number="{view&gt;/summary/released}" unit="Vorgänge" state="Success"/></VBox></HBox></VBox></f:DynamicPageHeader></f:header><f:content><VBox class="sapUiSmallMargin"><MessageStrip text="Die Belege enthalten geplante Mengen und Werte. Nur angenommene Positionen werden in einen eigenen freizugebenden Kundenauftrag übernommen. Die Arbeitsliste zeigt die letzten 100 berechtigten Vorgänge." showIcon="true"/><Table id="quoteList" items="{view&gt;/filtered}" growing="true" itemPress=".onOpen" noDataText="Keine Angebote für diesen Filter." class="sapUiSmallMarginTop"><headerToolbar><OverflowToolbar><Title text="{view&gt;/appTitle}"/><ToolbarSpacer/><Text text="{= ${view&gt;/filtered}.length + ' Vorgänge' }"/></OverflowToolbar></headerToolbar><columns><Column width="auto"><Text text="Angebot / Bezeichnung"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Auftraggeber"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kundenbestellreferenz"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Vertriebsbereich"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status / Sperren"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Angebotsdatum / Annahmefrist"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Positionen"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Nettowert"/></Column></columns><items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{view&gt;title}" text="{view&gt;number}"/><ObjectIdentifier title="{view&gt;partnerName}" text="{path:'view&gt;kind',formatter:'.formatter.quoteKind'}"/><Text text="{view&gt;customerReference}"/><Text text="{= ${view&gt;salesOrgCode} + ' / ' + ${view&gt;channelCode} + ' / ' + ${view&gt;divisionCode} }"/><VBox><ObjectStatus text="{parts:[{path:'view&gt;status'},{path:'view&gt;purpose'}],formatter:'.formatter.commercialStatus'}" state="{path:'view&gt;status',formatter:'.formatter.statusState'}"/><ObjectStatus text="Liefersperre" state="Warning" visible="{= !!${view&gt;deliveryBlock} }"/><ObjectStatus text="Fakturasperre" state="Warning" visible="{= !!${view&gt;billingBlock} }"/></VBox><VBox><Text text="{path:'view&gt;quoteDate',formatter:'.formatter.dateOnly'}" wrapping="false"/><Text text="{path:'view&gt;validUntil',formatter:'.formatter.dateOnly'}" wrapping="false"/></VBox><Text text="{view&gt;positions}"/><ObjectNumber number="{parts:[{path:'view&gt;net'},{path:'view&gt;digits'}],formatter:'.formatter.currencyValue'}" unit="{view&gt;currency}"/></cells></ColumnListItem></items></Table></VBox></f:content></f:DynamicPage></mvc:View>
