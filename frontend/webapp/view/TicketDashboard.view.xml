<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:cards="sap.f.cards" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" controllerName="netfusion.erp.controller.TicketDashboard" displayBlock="true" height="100%">
  <f:DynamicPage id="cockpitPage" toggleHeaderOnTitleClick="false" headerExpanded="true" fitContent="true">
    <f:title><f:DynamicPageTitle>
      <f:heading><Title text="Service-Cockpit" titleStyle="H2"/></f:heading>
      <f:expandedContent><Text text="Ticket-Eingang, Arbeitsvorrat und Disposition an einem Ort."/></f:expandedContent>
      <f:snappedContent><ObjectStatus text="{= ${view&gt;/dashboard/newCount} + ' neue Tickets · ' + ${view&gt;/dashboard/open} + ' offen' }" state="Information"/></f:snappedContent>
      <f:actions><Button text="Ticket anlegen" icon="sap-icon://add" type="Emphasized" press=".onNew" visible="{state&gt;/access/create}"/><Button text="Aktualisieren" icon="sap-icon://refresh" press=".load"/></f:actions>
    </f:DynamicPageTitle></f:title>
    <f:header><f:DynamicPageHeader pinnable="true"><HBox justifyContent="SpaceBetween" wrap="Wrap"><VBox class="sapUiTinyMarginEnd"><ObjectStatus text="{state&gt;/user/tenantName}" icon="sap-icon://building"/><Text text="{= ${view&gt;/dashboard/last24h} + ' Eingänge in den letzten 24 Stunden' }" class="sapUiTinyMarginTop"/></VBox><ObjectStatus text="{= 'Stand: ' + ${path:'view&gt;/dashboard/updatedAt',formatter:'.formatter.date'} }" icon="sap-icon://synchronize"/></HBox></f:DynamicPageHeader></f:header>
    <f:content><VBox class="sapUiSmallMargin">
      <l:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1">
        <f:Card width="100%"><f:header><cards:NumericHeader id="newKpi" title="Neue Tickets" subtitle="Eingang prüfen und qualifizieren" number="{view&gt;/dashboard/newCount}" state="Neutral" press=".onNewQueue" statusText="Neu"/></f:header></f:Card>
        <f:Card width="100%"><f:header><cards:NumericHeader id="unassignedKpi" title="Nicht zugewiesen" subtitle="Disposition erforderlich" number="{view&gt;/dashboard/unassigned}" state="{= ${view&gt;/dashboard/unassigned} &gt; 0 ? 'Critical' : 'Neutral' }" press=".onUnassignedQueue" statusText="Arbeitsvorrat"/></f:header></f:Card>
        <f:Card width="100%"><f:header><cards:NumericHeader id="criticalKpi" title="Hohe Priorität" subtitle="Hoch und kritisch · ungelöst" number="{view&gt;/dashboard/critical}" state="{= ${view&gt;/dashboard/critical} &gt; 0 ? 'Error' : 'Neutral' }" press=".onCriticalQueue" statusText="Fokus"/></f:header></f:Card>
        <f:Card width="100%"><f:header><cards:NumericHeader id="activeKpi" title="In Bearbeitung" subtitle="Aktuell im Service" number="{view&gt;/dashboard/inProgress}" state="Good" press=".onActiveQueue" statusText="Bearbeitung"/></f:header></f:Card>
      </l:Grid>
      <l:Grid defaultSpan="XL9 L9 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
        <Panel backgroundDesign="Solid">
          <headerToolbar><OverflowToolbar><Title text="Arbeitsvorrat" titleStyle="H3"/><ToolbarSpacer/><ObjectStatus text="{= ${view&gt;/dashboard/open} + ' offene Tickets' }" state="Information"/><Button text="Alle Tickets" type="Transparent" press=".onTickets" icon="sap-icon://navigation-right-arrow" iconFirst="false"/></OverflowToolbar></headerToolbar>
          <content>
            <IconTabHeader id="queueHeader" selectedKey="{view&gt;/queue}" select=".onQueue" mode="Inline"><items><IconTabFilter text="Neu" key="NEW" count="{view&gt;/dashboard/newCount}"/><IconTabFilter text="Nicht zugewiesen" key="UNASSIGNED" count="{view&gt;/dashboard/unassigned}"/><IconTabFilter text="Hohe Priorität" key="CRITICAL" count="{view&gt;/dashboard/critical}"/><IconTabFilter text="In Bearbeitung" key="ACTIVE" count="{view&gt;/dashboard/inProgress}"/><IconTabFilter text="Alle" key="ALL" count="{view&gt;/dashboard/total}"/></items></IconTabHeader>
            <l:Grid defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginTop">
              <VBox><Label text="Suche" labelFor="cockpitSearch"/><SearchField id="cockpitSearch" placeholder="Ticket, Betreff oder Kunde" value="{view&gt;/search}" search=".onSearch" width="100%"/></VBox>
              <VBox><Label text="Priorität" labelFor="cockpitPriority"/><Select id="cockpitPriority" selectedKey="{view&gt;/priority}" change=".applyFilters" width="100%"><core:Item key="" text="Alle Prioritäten"/><core:Item key="CRITICAL" text="Kritisch"/><core:Item key="HIGH" text="Hoch"/><core:Item key="MEDIUM" text="Normal"/><core:Item key="LOW" text="Niedrig"/></Select></VBox>
              <VBox><Label text="Anfrageart" labelFor="cockpitType"/><Select id="cockpitType" selectedKey="{view&gt;/type}" change=".applyFilters" width="100%"><core:Item key="" text="Alle Anfragearten"/><core:Item key="INCIDENT" text="Störung"/><core:Item key="SERVICE_REQUEST" text="Serviceanfrage"/><core:Item key="PROBLEM" text="Problem"/><core:Item key="CHANGE" text="Änderung"/><core:Item key="MAINTENANCE" text="Wartung"/><core:Item key="REPAIR" text="Reparatur"/><core:Item key="INSTALLATION" text="Installation"/><core:Item key="COMPLAINT" text="Reklamation"/><core:Item key="WARRANTY" text="Garantie"/><core:Item key="INTERNAL" text="Interner IT-Auftrag"/></Select></VBox>
            </l:Grid>
            <Table id="worklist" items="{path:'/Tickets',parameters:{$count:true,$orderby:'createdAt desc'}}" itemPress=".onTicketPress" growing="true" growingThreshold="15" sticky="ColumnHeaders,HeaderToolbar" noDataText="Keine Tickets für diese Auswahl. Wechseln Sie den Arbeitsvorrat oder passen Sie die Filter an.">
              <headerToolbar><OverflowToolbar><Title text="{= ${view&gt;/queueTitle} + ' (' + ${view&gt;/queueCount} + ')' }" titleStyle="H4"/><ToolbarSpacer/><Button text="Filter zurücksetzen" type="Transparent" press=".onClear"/></OverflowToolbar></headerToolbar>
              <columns><Column width="35%"><Text text="Ticket / Anliegen"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Kunde / Eingang"/></Column><Column><Text text="Priorität"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status / Verantwortlich"/></Column><Column width="4rem" hAlign="End" visible="{state&gt;/access/assign}"><Text text="Aktion"/></Column></columns>
              <items><ColumnListItem type="Navigation"><cells><ObjectIdentifier title="{title}" text="{number}"/><VBox><Text text="{partnerName}"/><Text text="{path:'createdAt',targetType:'any',formatter:'.formatter.date'}" class="sapUiTinyMarginTop"/></VBox><ObjectStatus text="{path:'priority',formatter:'.formatter.priority'}" state="{path:'priority',formatter:'.formatter.priorityState'}" inverted="true"/><VBox><ObjectStatus text="{path:'status',formatter:'.formatter.status'}" state="{path:'status',formatter:'.formatter.statusState'}"/><Text text="{technicianName}" class="sapUiTinyMarginTop"/></VBox><Button icon="sap-icon://employee" tooltip="Techniker direkt zuweisen" press=".onAssignRow" visible="{= ${state&gt;/access/assign} &amp;&amp; !['CLOSED','CANCELLED','COMMERCIALLY_CLOSED','TECHNICALLY_RESOLVED'].includes(%{status}) }"/></cells></ColumnListItem></items>
            </Table>
          </content>
        </Panel>
        <VBox><layoutData><l:GridData span="XL3 L3 M12 S12"/></layoutData>
          <Panel headerText="Prioritätsverteilung" backgroundDesign="Solid" class="sapUiSmallMarginBottom"><VBox class="sapUiSmallMarginBottom"><Text text="Offene Tickets nach Priorität" class="sapUiSmallMarginBottom"/><VBox items="{view&gt;/dashboard/distribution}"><items><VBox class="sapUiSmallMarginBottom"><HBox justifyContent="SpaceBetween"><ObjectStatus text="{view&gt;label}" state="{view&gt;state}"/><ObjectNumber number="{view&gt;count}"/></HBox><ProgressIndicator percentValue="{view&gt;percent}" displayValue="{= ${view&gt;percent} + ' %' }" state="{view&gt;state}" displayOnly="true"/></VBox></items></VBox></VBox></Panel>
          <Panel headerText="Service im Überblick" backgroundDesign="Solid"><List showSeparators="Inner"><DisplayListItem label="Offene Tickets" value="{view&gt;/dashboard/open}"/><DisplayListItem label="Wartende Tickets" value="{view&gt;/dashboard/waiting}"/><DisplayListItem label="Servicefälle" value="{view&gt;/dashboard/cases}"/><DisplayListItem label="Eingang letzte 24 h" value="{view&gt;/dashboard/last24h}"/></List><Button text="Servicefälle öffnen" type="Transparent" icon="sap-icon://folder-blank" press=".onCases" class="sapUiSmallMarginTop"/></Panel>
          <MessageStrip text="Hohe und kritische Prioritäten benötigen Aufmerksamkeit." type="Warning" showIcon="true" visible="{= ${view&gt;/dashboard/critical} &gt; 0 }" class="sapUiSmallMarginTop"><link><Link text="Arbeitsvorrat öffnen" press=".onCriticalQueue"/></link></MessageStrip>
        </VBox>
      </l:Grid>
    </VBox></f:content>
  </f:DynamicPage>
</mvc:View>
