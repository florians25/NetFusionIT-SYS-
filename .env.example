# Produktionsbeispiel: echte Werte ausschließlich sicher außerhalb von Git setzen.
NODE_ENV=production
PORT=3000
ERP_HOST=0.0.0.0
# Laufzeitrolle ohne Superuser/DDL; enthält das Passwort der DB-Verbindung.
DATABASE_URL=postgresql://erp_app:CHANGE_ME@db:5432/erp
# Nur für Migrationen und ausdrücklichen Bootstrap verwenden.
ERP_MIGRATION_URL=postgresql://postgres:CHANGE_ME@db:5432/erp
ERP_SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ERP_PUBLIC_ORIGIN=https://erp.example.org
ERP_TRUST_PROXY=1
# Für Compose, ausschließlich zufällige URL-sichere Passwörter verwenden:
POSTGRES_PASSWORD=REPLACE_WITH_32_RANDOM_URL_SAFE_CHARACTERS
ERP_DATABASE_PASSWORD=REPLACE_WITH_32_OTHER_RANDOM_URL_SAFE_CHARACTERS
ERP_DOMAIN=erp.example.org
# Nur für den expliziten einmaligen Bootstrap. Danach Passwort entfernen.
ERP_BOOTSTRAP_TENANT=netfusion
ERP_BOOTSTRAP_COMPANY=NetFusion IT
ERP_BOOTSTRAP_NAME=Administrator
ERP_BOOTSTRAP_EMAIL=admin@example.org
ERP_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
